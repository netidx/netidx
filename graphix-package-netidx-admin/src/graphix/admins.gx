let list_admins = |t: Target| -> Result<Array<AdminInfo>, AdminError> 'netidx_admin_list_admins;
let add_role_admin = |name: string, policy: Policy, t: Target| -> Result<string, AdminError> 'netidx_admin_add_role_admin;
let reset_password = |name: string, t: Target| -> Result<string, AdminError> 'netidx_admin_reset_password;
let set_admin_policy = |name: string, policy: Policy, t: Target| -> Result<null, AdminError> 'netidx_admin_set_admin_policy;
let remove_admin = |name: string, t: Target| -> Result<null, AdminError> 'netidx_admin_remove_admin;
let change_password = |#new_password: [string, null] = null, t: Target| -> Ceremony<null> 'netidx_admin_change_password
