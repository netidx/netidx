use package::{
  local as local_target, parse_fingerprint, units,
  ca::{
    self, CaCredentials, auto_approve, external_csr, external_install, recovery_rotate
  },
  install::{
    self, Change, Install, InstallRole, ParentCandidate, Scope, ServiceState, Staged,
    add_parent, backup, escalate_command, install_service, join, local_resolver_base,
    parent_candidates, renew, restore_finish, restore_stage, sync_check, uninstall,
    update, verify_system_service
  }
};
use super::{
  Confirm, Toast, admin_text, conduct, confirm_layers, hint, identity_lines, opt_len,
  panels, selected, selstyle, services, toast_layers
};
use tui::{
  line, span, style,
  block::block,
  form::form,
  input_handler::{Event, KeyEvent, input_handler, on_press},
  layout::{child, layout},
  list::list,
  overlay::{Layer, layer},
  paragraph::paragraph
};

type SyncState = [
  `NotApplicable,
  `Checking,
  `InSync,
  `OutOfSync(Array<Change>),
  `Failed(string)
];

type Probe = [`None, `Probing, `Ready(CaCredentials), `Failed(string)];

type InstallRow = { install: Install, sync: SyncState, probe: Probe };

type ParentChoice = { parent: string, resolvers: [Array<string>, null], path: string };

type Act = [
  `Status,
  `Update,
  `Join(bool),
  `AddParent,
  `Renew,
  `Services,
  `Admins,
  `Perms,
  `AutoApprove(bool),
  `RecoveryRotate,
  `ExternalCsr,
  `ExternalInstall,
  `Backup,
  `Uninstall,
  `UninstallWith(bool),
  `Install(InstallRole, bool),
  `Restore,
  `FinishRestore,
  `AddParentTo(ParentChoice)
];

type Screen = [`Home, `Admin, `Services];

let role_title = |r: InstallRole| select r {
  `Ca => "CA",
  `Workstation => "Workstation",
  `Resolver => "Resolver",
  `Publisher => "Publisher"
};

let service_word = |s: ServiceState| select s {
  `Active => "running",
  `Inactive => "stopped",
  `NotInstalled => "no service"
};

let change_text = |c: Change| select c {
  `Add(s) => "+ add [s]",
  `Del(s) => "- remove [s]",
  `Reauth(s) => "~ change [s]"
};

let fresh_choices: Array<{ act: Act, title: string, blurb: string }> = [
  {
    act: `Install(`Ca, false),
    title: "CA",
    blurb: "Install the admin domain's certificate authority on this machine. It may be dedicated to this role; resolver servers are installed separately and enroll with it."
  },
  {
    act: `Install(`Workstation, false),
    title: "Workstation",
    blurb: "Turn this machine into a full netidx node: a local resolver serving a /local namespace plus a matching client. Join an existing admin domain to enroll a TLS identity, or run standalone. The usual choice for a laptop or desktop."
  },
  {
    act: `Install(`Resolver, false),
    title: "Resolver",
    blurb: "A network-facing resolver server — the directory that maps paths to publishers for a whole admin domain or a delegated subtree. Can mint a new admin domain's certificate authority and admin server, or enroll under an existing one."
  },
  {
    act: `Install(`Publisher, false),
    title: "Publisher",
    blurb: "A client configuration for a host that publishes data: point it at an admin domain's resolvers with the right auth. Installs a certificate-renewal service when the admin domain uses TLS."
  },
  {
    act: `Restore,
    title: "Restore from Backup",
    blurb: "Restore a complete managed installation from a verified backup bundle. The destination must be a clean machine or an identical interrupted restore."
  }
];

let desc = |a: Act| select a {
  `Status => "Full status detail for this install: its config, whether it is in sync with the admin domain, and its CA glyph.",
  `Update => "Reconcile this host's resolver list with the admin domain, adding or removing resolvers as necessary.",
  `Join(false) => "Graduate this local-only workstation onto an admin domain, enrolling a TLS identity.",
  `Join(true) => "Preview joining an admin domain, without changing anything.",
  `AddParent | `AddParentTo(_) => "Attach this resolver under a parent resolver by delegation.",
  `Renew => "Renew this host's TLS certificates from the admin domain's CA now. The auto-renew service does this automatically unless it has been turned off.",
  `Services => "Manage netidx services on this machine — list them, start/stop/restart, and create, edit, or delete units.",
  `Admins => "Manage this admin server's admins and their scopes.",
  `Perms => "View and edit this host's permissions.",
  `AutoApprove(true) => "Rotate this admin server's auto-renew credential. The auto-renew service automatically renews expiring certificates for the admin domain's members.",
  `AutoApprove(false) => "Enable the auto-renew service, which automatically renews expiring certificates for the admin domain's members, without an admin approving each one.",
  `RecoveryRotate => "Mint a fresh CA recovery password. Use this if you lost or forgot the old one — it retires the old password. Works only locally, on the CA machine.",
  `ExternalCsr => "Write a subordinate-CA CSR for your external PKI to sign.",
  `ExternalInstall => "Install the externally-signed CA certificate returned by your PKI.",
  `Backup => "Back up this complete managed installation. CA state is captured consistently while the CA remains online; machine credentials are re-enrolled on restore.",
  `Uninstall | `UninstallWith(_) => "Remove this install — its config and OS service.",
  `FinishRestore => "Finish re-enrolling roles after CA startup.",
  `Install(_, false) => "Install this role on the machine.",
  `Install(_, true) => "Preview installing this role — show the plan without changing anything.",
  `Restore => "Restore a complete installation from a verified backup bundle."
};

// the destructive actions are held behind a yes/no
let confirm_text = |a: Act| select a {
  `AutoApprove(true) => "Rotate the auto-approve credential? The current keytab stops working; the admin server re-mints and re-seals it.",
  `RecoveryRotate => "Rotate the CA recovery password? The current recovery password stops working and a new one is shown once — save it.",
  `Uninstall => "Remove this install? This stops and removes the OS service and deletes its configuration.",
  _ => null
};

let rec pad = |s: string, n: i64| select str::len(s) {
  l if l >= n => s,
  _ => pad(str::concat(" ", s), n)
};

// the question a teardown asks of an install that owns a CA: up from each
// `ask` until it is answered or cancelled
let ca_question = |#on_answer: fn(remove_ca: bool) -> null, ask: Any| -> Array<Layer> {
  let up = false;
  let sel = 0;
  up <- ask ~ true;
  sel <- ask ~ 0;
  let handle = |e: Event| {
    on_press(e, |k| select k.code {
      `Up | `Char("k") => { sel <- k ~ max(0, sel - 1); `Stop },
      `Down | `Char("j") => { sel <- k ~ min(1, sel + 1); `Stop },
      kk@ `Enter => {
        on_answer(kk ~ sel == 1);
        up <- kk ~ false;
        `Stop
      },
      kk@ `Esc => { up <- kk ~ false; `Stop },
      _ => `Stop
    });
    e ~ `Stop
  };
  select up {
    false => [],
    true => [layer(#width: &`Percentage(70), #height: &`Percentage(40),
      input_handler(#handle: &handle, &block(
        #border: &`All,
        #title: &line("This install owns a CA"),
        #title_bottom: &line(#style: hint, " ↑/↓ choose · Enter confirm · Esc cancel "),
        &layout(#direction: &`Vertical, &[
          child(#constraint: `Length(2), paragraph(#style: &hint,
            &"Removing the CA directory destroys the admin domain's trust root: every enrolled node's certificate becomes unverifiable and unrenewable. There is no undo.")),
          child(#constraint: `Min(2), list(#highlight_style: &selstyle, #selected: &sel, &[
            line("Keep the CA directory"),
            line("DESTROY the CA — irreversible")
          ]))
        ]))))]
  }
};

// choosing a parent for the install at `root`: each `root` opens the
// picker over the admin domain's candidates (or an address typed by
// hand), and the form that follows calls `#on_pick` with the choice
let parent_picker = |
  #toast: &[Toast, null],
  #on_pick: fn(c: ParentChoice) -> null,
  root: string
| -> Array<Layer> {
  let cands: [Array<ParentCandidate>, null] = null;
  {
    catch(e) *toast <- {
      title: "Listing the parent candidates failed",
      lines: [admin_text((e.0).error)],
      error: true
    };
    cands <- parent_candidates(#config_root: root, root)?
  };
  let picking = false;
  let sel = 0;
  picking <- root ~ true;
  sel <- root ~ 0;
  let resolvers: [Array<string>, null] = null;
  let fields = never();
  let filling = false;
  let address_form = form(
    #title: "Add a parent",
    #help: "The parent's admin server is a host or host:port; the subtree is the path this resolver will own under it.",
    #on_submit: |v| {
      on_pick({ parent: v[0]$, resolvers: v ~ resolvers, path: v[1]$ });
      filling <- v ~ false;
      null
    },
    #on_cancel: |e| { filling <- e ~ false; null },
    fields
  );
  let handle = |e: Event| {
    on_press(e, |k| select k.code {
      `Up | `Char("k") => { sel <- k ~ max(0, sel - 1); `Stop },
      `Down | `Char("j") => { sel <- k ~ min(opt_len(cands), sel + 1); `Stop },
      kk@ `Enter => {
        select kk ~ (opt::or_default(cands, []), sel) {
          (cs, i) if i < array::len(cs) => {
            let c = cs[i]$;
            resolvers <- [c.resolver];
            fields <- [{ label: "parent admin server", value: c.admin }, { label: "subtree path", value: "" }]
          },
          (cs, _) => {
            resolvers <- cs ~ null;
            fields <- cs ~ [{ label: "parent admin server", value: "" }, { label: "subtree path", value: "" }]
          }
        };
        picking <- kk ~ false;
        filling <- kk ~ true;
        `Stop
      },
      kk@ `Esc => { picking <- kk ~ false; `Stop },
      _ => `Stop
    });
    e ~ `Stop
  };
  array::concat(
    select picking {
      false => [],
      true => {
        let manual = line("Enter an address manually…");
        let items = select cands {
          null as _ => [line(#style: hint, "looking for parents in the admin domain's map…"), manual],
          cs => array::push(array::map(cs, |c| line("[c.resolver]  [c.base]  via [c.admin]")), manual)
        };
        [layer(#width: &`Percentage(70), #height: &`Percentage(50),
          input_handler(#handle: &handle, &block(
            #border: &`All,
            #title: &line("Pick a parent"),
            #title_bottom: &line(#style: hint, " ↑/↓ move · Enter choose · Esc cancel "),
            &list(#highlight_style: &selstyle, #selected: &sel, &items))))]
      }
    },
    select filling {
      false => [],
      true => [layer(#width: &`Percentage(70), #height: &`Percentage(40),
        input_handler(#handle: &address_form.handle, &address_form.view))]
    }
  )
};

// the status card: everything known about one install, up from each
// `open` until the next key
let status_card = |row: [InstallRow, null], open: Any| -> Array<Layer> {
  let good = style(#fg: `Green);
  let warn = style(#fg: `Yellow);
  let show = false;
  show <- open ~ true;
  let kv = |label, value|
    line([span(#style: hint, "[pad(label, 17)]: "), span(value)]);
  let kvs = |label, value, st|
    line([span(#style: hint, "[pad(label, 17)]: "), span(#style: st, value)]);
  let lines = select row {
    null as _ => [],
    r => {
      let d = r.install;
      let domain = select d.admin_domain {
        null as _ => "standalone (local-only)",
        n => n.domain
      };
      let servers = select d.admin_servers {
        [] => [],
        xs => [kv("Admin servers", str::join(#sep: ", ", xs))]
      };
      let creds = select d.local_ca {
        null as _ => [],
        _ => select r.probe {
          `None => [],
          `Probing => [kvs("CA credentials", "checking…", hint)],
          `Failed(e) => [kvs("CA credentials", e, warn)],
          `Ready(c) => array::concat(
            [select (c.auto_approve_present, c.auto_approve_wired) {
              (true, true) => kvs("Auto-approve", "active", good),
              (true, false) => kvs("Auto-approve", "present (not wired)", warn),
              (false, _) => kvs("Auto-approve", "not set up", hint)
            }],
            [select c.recovery_present {
              true => kvs("Recovery slot", "set", good),
              false => kvs("Recovery slot", "MISSING", warn)
            }],
            select (c.external_signed, c.external_installed) {
              (false, _) => [],
              (true, true) => [kvs("External CA", "installed", good)],
              (true, false) => [kvs("External CA", "awaiting signature", warn)]
            }
          )
        }
      };
      let service = select d.service {
        `Active => kvs("OS service", "active (running)", good),
        `Inactive => kvs("OS service", "installed, not running", warn),
        `NotInstalled => kvs("OS service", "not installed", hint)
      };
      let sync_lines = select r.sync {
        `NotApplicable => [],
        `Checking => [kvs("Admin domain sync", "checking…", hint)],
        `InSync => [kvs("Admin domain sync", "✓ in sync", good)],
        `Failed(e) => [kvs("Admin domain sync", "could not check ([e])", hint)],
        `OutOfSync(cs) => array::concat(
          [kvs("Admin domain sync", "⚠ [array::len(cs)] pending change(s) — press U to apply", warn)],
          array::map(cs, |c| line([span("                   "), span(#style: warn, change_text(c))]))
        )
      };
      array::concat(
        [
          kv("Role", role_title(d.role)),
          kv("Base", d.base),
          kv("Data-plane auth", d.auth),
          kv("Admin domain", domain)
        ],
        servers,
        creds,
        [service, kv("Config", d.config_dir), kv("Installed", "[cast<datetime>(d.created_unix)$]")],
        sync_lines
      )
    }
  };
  let ca_glyph = select row {
    null as _ => [],
    r => select r.install.admin_domain {
      null as _ => [],
      n => select parse_fingerprint(n.fingerprint) {
        error as _ => [line(#style: hint, "recorded fingerprint does not parse")],
        fp => array::concat([line(#style: hint, "CA glyph")], identity_lines(fp))
      }
    }
  };
  let handle = |e: Event| {
    on_press(e, |k| { show <- k ~ false; `Stop });
    e ~ `Stop
  };
  select show {
    false => [],
    true => {
      let title = select row {
        null as _ => "Status",
        r => "[role_title(r.install.role)] status"
      };
      let content = select ca_glyph {
        [] => paragraph(#trim: &false, &lines),
        g => layout(#direction: &`Horizontal, &[
          child(#constraint: `Min(0), paragraph(#trim: &false, &lines)),
          child(#constraint: `Length(24), paragraph(#alignment: &`Center, #trim: &false, &g))
        ])
      };
      [layer(#width: &`Percentage(85), #height: &`Percentage(75),
        input_handler(#handle: &handle, &block(
          #border: &`All,
          #title: &line(title),
          #title_bottom: &line(#style: hint, " any key to close "),
          &content)))]
    }
  }
};

// the fresh-machine welcome, up until its first key
let welcome = |fresh: bool| -> Array<Layer> {
  let seen = false;
  let handle = |e: Event| {
    on_press(e, |k| { seen <- k ~ true; `Stop });
    e ~ `Stop
  };
  select (fresh, seen) {
    (true, false) => [layer(#width: &`Length(64), #height: &`Length(10),
      input_handler(#handle: &handle, &block(
        #border: &`All,
        #title: &line("Welcome to netidx"),
        &paragraph(#trim: &true, &[
          line(#style: style(#add_modifier: [`Bold]), "netidx isn't installed on this machine."),
          line(""),
          line("Choose a role to install — a Workstation for a laptop or desktop, a Resolver to run an admin domain's directory, or a Publisher — or choose Restore from Backup to recover any managed installation."),
          line(""),
          line(#style: selstyle$, " Press Enter to continue ")
        ]))))],
    _ => []
  }
};

let local = |#q: &Question| {
  let toast: [Toast, null] = null;
  let fail = |title, a| {
    toast <- { title, lines: [admin_text(a)], error: true };
    null
  };
  // ── detection: what is installed here, re-read on demand and after
  // every action ──
  let refresh: Any = true;
  let detected: [Array<Install>, null] = null;
  {
    catch(e) fail("Detecting installs failed", (e.0).error);
    detected <- install::list(refresh)?
  };
  let units = units::dir(refresh);
  let own_base = local_resolver_base(refresh);
  let fresh = select detected {
    null as _ => false,
    [] => true,
    _ => false
  };
  // ── one row per install, with the facts that take a round trip: every
  // detection re-checks them ──
  let rows = select detected {
    null as _ => [],
    xs => array::map(xs, |i| {
      let sync: SyncState = select (i.admin_domain, i.role) {
        (null, _) => `NotApplicable,
        (_, `Ca) => `NotApplicable,
        _ => {
          let st: SyncState = `Checking;
          {
            catch(e) st <- `Failed(admin_text((e.0).error));
            st <- select sync_check(#config_root: i.config_dir, i.role)? {
              `InSync => `InSync,
              `OutOfSync(cs) => `OutOfSync(cs)
            }
          };
          st
        }
      };
      let probe: Probe = select i.local_ca {
        null as _ => `None,
        lca => {
          let p: Probe = `Probing;
          // the daemon that answers for the CA may not be up yet when the
          // install has just finished, so a failed probe is tried again,
          // a few times, a few seconds apart
          let tries = 0;
          let retry_in: [duration, null] = null;
          let again = sys::time::timer(retry_in$, false);
          tries <- again ~ tries + 1;
          let go: Any = true;
          go <- again;
          {
            catch(e) {
              p <- `Failed(admin_text((e.0).error));
              retry_in <- e ~ select tries {
                n if n < 3 => duration:3.s,
                _ => null
              }
            };
            p <- `Ready(ca::credentials(#cfg: go ~ lca.cfg, go ~ lca.ca_dir)?)
          };
          p
        }
      };
      { install: i, sync, probe }
    })
  };
  let sel = 0;
  let row = selected(rows, sel);
  let current = opt::map(row, |r| r.install);
  let lca = select current {
    null as _ => null,
    d => d.local_ca
  };
  // ── the selected install's actions ──
  let item = |label, act| { label, act, desc: desc(act) };
  let items = select row {
    null as _ => [],
    r => {
      let d = r.install;
      let joined = opt::is_some(d.admin_domain);
      let update_items = select (joined, d.role) {
        (true, `Ca) => [],
        (true, _) => [item("Update Resolvers", `Update)],
        _ => []
      };
      let join_items = select (d.role, joined) {
        (`Workstation, false) => [
          item("Join an Admin Domain", `Join(false)),
          item("Preview Join (Dry Run)", `Join(true))
        ],
        _ => []
      };
      let parent_items = select d.role {
        `Resolver => [item("Add a Parent", `AddParent)],
        _ => []
      };
      let renew_items = select (joined, d.renewable) {
        (true, true) => [item("Renew Certificates", `Renew)],
        _ => []
      };
      let service_items = select units {
        null as _ => [],
        _ => [item("Services", `Services)]
      };
      let ca_items = select d.local_ca {
        null as _ => [],
        l => {
          let admin_items = select l.cfg {
            null as _ => [],
            _ => array::concat(
              [item("Admins", `Admins)],
              select own_base {
                null as _ => [],
                _ => [item("Permissions", `Perms)]
              }
            )
          };
          let cred_items = select r.probe {
            `Ready(c) => array::concat(
              select c.auto_approve_present {
                true => [item("Rotate Auto-Renew Credential", `AutoApprove(true))],
                false => [item("Enable Auto-Renew", `AutoApprove(false))]
              },
              select c.recovery_present {
                true => [item("Rotate Recovery Password", `RecoveryRotate)],
                false => []
              },
              select (c.external_signed, c.external_installed) {
                (false, _) => [],
                (true, true) => [
                  item("Emit Renewal CSR (External CA)", `ExternalCsr),
                  item("Install Renewed Certificate (External CA)", `ExternalInstall)
                ],
                (true, false) => [
                  item("Re-emit Signing CSR (External CA)", `ExternalCsr),
                  item("Install Signed Certificate (External CA)", `ExternalInstall)
                ]
              }
            ),
            _ => []
          };
          array::concat(admin_items, cred_items)
        }
      };
      array::concat(
        [item("Status", `Status)],
        update_items,
        join_items,
        parent_items,
        renew_items,
        service_items,
        ca_items,
        [item("Back Up This Install", `Backup), item("Uninstall", `Uninstall)]
      )
    }
  };
  let n_items = array::len(items);
  let offered = |a| opt::is_some(array::find(items, |it| it.act == a));
  // ── ui state ──
  let menu_sel = 0;
  let menu_item = selected(items, menu_sel);
  let role_sel = 0;
  let screen: Screen = `Home;
  let confirm: [Confirm<Act>, null] = null;
  // an action the operator chose: confirmed first when destructive
  let chosen = never<Act>();
  let run = never<Act>();
  select chosen {
    a => select confirm_text(a) {
      null as _ => run <- a,
      m => confirm <- { message: m, action: a }
    }
  };
  // a restore parked until its CA's service runs; F finishes it
  let restore_staged: [Staged, null] = null;
  let finish_restore = |t| {
    select t ~ restore_staged {
      null as _ => toast <- t ~ { title: "No restore to finish", lines: ["No staged restore is waiting."], error: true },
      _ => run <- t ~ `FinishRestore
    };
    null
  };
  // ── keys ──
  let home_keys = |k: KeyEvent| select k.code {
    `Up | `Char("k") => { menu_sel <- k ~ max(0, menu_sel - 1); `Stop },
    `Down | `Char("j") => {
      menu_sel <- k ~ min(max(0, n_items - 1), menu_sel + 1);
      `Stop
    },
    `Left => { sel <- k ~ max(0, sel - 1); menu_sel <- k ~ 0; `Stop },
    `Right => {
      sel <- k ~ min(max(0, opt_len(detected) - 1), sel + 1);
      menu_sel <- k ~ 0;
      `Stop
    },
    kk@ `Enter => {
      chosen <- (kk ~ menu_item)$.act;
      `Stop
    },
    kk@ `Char("u") => { chosen <- kk ~ `Uninstall; `Stop },
    kk@ `Char("U") => {
      select kk ~ offered(`Update) {
        true => chosen <- kk ~ `Update,
        false => never()
      };
      `Stop
    },
    kk@ `Char("r") => {
      select kk ~ offered(`Renew) {
        true => chosen <- kk ~ `Renew,
        false => never()
      };
      `Stop
    },
    kk@ `Char("R") => { refresh <- kk; `Stop },
    kk@ `Char("F") => { finish_restore(kk); `Stop },
    _ => `Continue
  };
  let fresh_keys = |k: KeyEvent| select k.code {
    `Up | `Char("k") => { role_sel <- k ~ max(0, role_sel - 1); `Stop },
    `Down | `Char("j") => {
      role_sel <- k ~ min(array::len(fresh_choices) - 1, role_sel + 1);
      `Stop
    },
    kk@ `Enter => { chosen <- kk ~ (fresh_choices[role_sel]$).act; `Stop },
    kk@ `Char("p") => {
      select kk ~ (fresh_choices[role_sel]$).act {
        `Install(role, _) => chosen <- `Install(role, true),
        _ => never()
      };
      `Stop
    },
    kk@ `Char("F") => { finish_restore(kk); `Stop },
    kk@ `Char("R") => { refresh <- kk; `Stop },
    _ => `Continue
  };
  // ── the local admin server's panels: the roster, and this host's
  // own permissions ──
  let admin_req = never();
  admin_req <- select run {
    x@ `Admins | x@ `Perms => {
      cfg: (x ~ lca)$.cfg$,
      panel: select x { `Admins => `Roster, `Perms => `Perms }
    },
    _ => never()
  };
  let admin_target = never();
  let admin_entry = never();
  let admin_r = local_target(#cfg_path: admin_req.cfg, admin_req);
  {
    catch(e) fail("Opening this host's admin server failed", (e.0).error);
    seq admin_r {
      let t = admin_r?;
      admin_target <- t;
      admin_entry <- select admin_req.panel {
        `Roster => `Roster,
        `Perms => `Perms(own_base$)
      };
      screen <- `Admin
    }
  };
  let pan = panels::panels(
    #q: q,
    #entry: admin_entry,
    #on_close: |why| { screen <- why ~ `Home; null },
    admin_target
  );
  // ── this host's services, over its activation supervisor ──
  let svc_open = never();
  let svc = services::services(
    #units_dir: units$,
    #on_close: |e| { screen <- e ~ `Home; null },
    svc_open
  );
  // ── the lifecycle ceremonies ──
  let renew_r = conduct(q, renew(select run { x@ `Renew => x, _ => never() }));
  let update_r = conduct(q, {
    let x = select run { x@ `Update => x, _ => never() };
    let d = (x ~ current)$;
    update(#config_root: d.config_dir, d.role)
  });
  let backup_r = conduct(q, {
    let x = select run { x@ `Backup => x, _ => never() };
    let d = (x ~ current)$;
    backup(#config_root: d.config_dir, #target: null, d.scope)
  });
  let autoapprove_r = conduct(q, {
    let rotate = select run { `AutoApprove(rotate) => rotate, _ => never() };
    let l = (rotate ~ lca)$;
    auto_approve(#rotate: rotate, #cfg: l.cfg, l.ca_dir)
  });
  let recovery_r = conduct(q, {
    let x = select run { x@ `RecoveryRotate => x, _ => never() };
    let l = (x ~ lca)$;
    recovery_rotate(#cfg: l.cfg, l.ca_dir)
  });
  let csr_r = conduct(q, {
    let x = select run { x@ `ExternalCsr => x, _ => never() };
    external_csr((x ~ lca)$.ca_dir)
  });
  let extinstall_r = conduct(q, {
    let x = select run { x@ `ExternalInstall => x, _ => never() };
    external_install(#signed: null, #root: null, (x ~ lca)$.ca_dir)
  });
  // ── their outcomes: a toast, then re-detect ──
  {
    catch(e) fail("Renewal failed", (e.0).error);
    seq renew_r {
      let r = renew_r?;
      toast <- select r.summary {
        null as _ => {
          title: "Nothing to renew",
          lines: ["Every certificate on this host is outside its renewal window."],
          error: false
        },
        s => {
          let failed = array::map(r.failed, |f| "[f.cert]: [f.why]");
          let done = array::concat(r.renewed, r.awaiting_approval);
          {
            title: select array::len(r.failed) {
              0 => "Renewed",
              _ => "Renewal incomplete"
            },
            lines: array::concat([s], done, failed),
            error: array::len(r.failed) > 0
          }
        }
      };
      refresh <- r
    }
  };
  {
    catch(e) fail("Update failed", (e.0).error);
    seq update_r {
      let r = update_r?;
      toast <- select r {
        `UpToDate => {
          title: "Up to date",
          lines: ["Already in sync with the admin domain — no changes."],
          error: false
        },
        `Applied({ changes, warnings, restart_hint }) => {
          title: "Updated",
          lines: array::concat(
            array::map(changes, change_text),
            array::map(warnings, |w| "warning: [w]"),
            ["", restart_hint]
          ),
          error: false
        }
      };
      refresh <- r
    }
  };
  {
    catch(e) fail("Backup failed", (e.0).error);
    seq backup_r {
      let r = backup_r?;
      let components = str::join(#sep: ", ", r.components);
      toast <- {
        title: "Installation backup created",
        lines: [
          "Target: [r.target]",
          "Components: [components]",
          "[r.files] files · [r.bytes] bytes",
          "Fresh enrollment on restore: [r.identities_to_reenroll] credential(s)",
          "Manifest SHA-256: [r.manifest_sha256]"
        ],
        error: false
      }
    }
  };
  {
    catch(e) fail("Auto-renew setup failed", (e.0).error);
    seq autoapprove_r {
      let r = autoapprove_r?;
      toast <- select r {
      `HotSwapped({ warning }) => {
        title: "Auto-approve rotated",
        lines: array::concat(
          ["The running admin server rotated its auto-approve credential in place (no downtime)."],
          select warning {
            null as _ => [],
            w => [w]
          }
        ),
        error: false
      },
      `Offline({ rotate, keytab, wiring }) => {
        let verb = select rotate {
          true => "rotated",
          false => "enabled"
        };
        let wired = select wiring {
          `Updated(p) => "Config updated: [p]",
          `NoCaConfig => "No CA config owns this CA.",
          `Failed(e) => "Config update failed (non-fatal): [e]"
        };
        {
          title: select rotate {
            true => "Auto-approve rotated",
            false => "Auto-approve enabled"
          },
          lines: ["Auto-approve [verb]. Keytab: [keytab]", wired],
          error: false
        }
      }
      };
      refresh <- r
    }
  };
  {
    catch(e) fail("Rotating the recovery password failed", (e.0).error);
    seq recovery_r {
      let r = recovery_r?;
      toast <- {
        title: "Recovery password rotated",
        lines: [select r {
          `HotSwapped => "The running admin server minted a new recovery password (shown above) in place.",
          `Offline => "Minted a new recovery password (shown above)."
        }],
        error: false
      };
      refresh <- r
    }
  };
  {
    catch(e) fail("Emitting the CSR failed", (e.0).error);
    seq csr_r {
      let p = csr_r?;
      toast <- {
      title: "CSR emitted",
      lines: ["Wrote a renewal CSR to [p]. Have your external PKI sign it, then install the signed certificate."],
      error: false
      }
    }
  };
  {
    catch(e) fail("Installing the certificate failed", (e.0).error);
    seq extinstall_r {
      let r = extinstall_r?;
      toast <- select r {
        `FirstInstall({ cfg_path, service_scope }) => {
          title: "CA certificate installed",
          lines: array::concat(
            ["Installed the externally-signed CA certificate; CA configured at [cfg_path]."],
            select service_scope {
              null as _ => [],
              `User => ["Register its OS service: netidx admin service install --scope user"],
              `System => ["Register its OS service: netidx admin service install --scope system"]
            }
          ),
          error: false
        },
        `OfflineCa => {
          title: "Certificate installed",
          lines: ["Installed the externally-signed offline CA certificate."],
          error: false
        },
        `Renewal => {
          title: "Certificate renewed",
          lines: ["Renewed the CA certificate. Its admin server was not running; start it to serve the new certificate."],
          error: false
        },
        `HotRenewed({ ca_fingerprint }) => {
          title: "Certificate renewed",
          lines: ["Renewed the externally-signed CA without stopping it.", "CA identity: [ca_fingerprint]"],
          error: false
        }
      };
      refresh <- r
    }
  };
  // ── navigation, and the questions a teardown asks first ──
  let ca_ask = never();
  let parent_root = never();
  select run {
    x@ `Services => { svc_open <- x; screen <- x ~ `Services },
    x@ `Uninstall => select x ~ lca {
      null as _ => run <- x ~ `UninstallWith(false),
      _ => ca_ask <- x
    },
    x@ `AddParent => parent_root <- (x ~ current)$.config_dir,
    _ => never()
  };
  // ── the OS service a role needs afterwards: registered here at user
  // scope; at system scope the invocation runs privileged on the
  // released terminal and the service manager's state judges it ──
  let svc_req = never<{ scope: Scope, name: [string, null], for_user: [string, null] }>();
  let svc_r = install_service(#scope: svc_req.scope, #name: svc_req.name, #for_user: svc_req.for_user, svc_req);
  let svc_ok = never();
  // a privileged step: what it is, the netidx invocation, and what
  // follows its exit
  type Then = [`VerifyService({ name: string, for_user: string }), `UninstallAgain(bool), `Nothing];
  let priv_req = never<{ what: string, argv: Array<string>, then: Then }>();
  {
    catch(e) fail("Registering the OS service failed", (e.0).error);
    seq svc_r {
      let r = svc_r?;
      select r {
        `Registered(line) => { svc_ok <- line; null },
        `Privileged({ what, argv, name, for_user }) => {
          priv_req <- { what, argv, then: `VerifyService({ name, for_user }) };
          null
        }
      }
    }
  };
  toast <- { title: "OS service registered", lines: [svc_ok], error: false };
  refresh <- svc_ok;
  let suspended = false;
  let priv_exit = never();
  {
    catch(e) {
      select (e.0).error {
        `TerminalError(m) => toast <- { title: "The privileged step could not run", lines: [m], error: true },
        `ProcessError(m) => toast <- { title: "The privileged step could not run", lines: [m], error: true },
        a => fail("The privileged step could not start", a)
      };
      suspended <- e ~ false
    };
    let released = tui::suspend(suspended)?;
    priv_exit <- seq let req = priv_req {
      let cmd = escalate_command(req.argv, req)?;
      suspended <- true;
      until released;
      println("\nAdministrator privileges are needed to [req.what].");
      let child = sys::process::spawn(sys::process::options(#args: cmd.args, cmd.program))?;
      let status = sys::process::wait(child.proc)?;
      suspended <- false;
      {
        code: select status.code {
          null as _ => -1,
          c => c
        },
        then: req.then
      }
    }
  };
  let verify_req = never();
  select priv_exit.then {
    `VerifyService({ name, for_user }) => verify_req <- { name, for_user, code: priv_exit.code },
    `UninstallAgain(remove_ca) => run <- `UninstallWith(remove_ca),
    `Nothing => select priv_exit.code {
      0 => refresh <- priv_exit,
      code => toast <- { title: "The privileged step failed", lines: ["It exited with status [code]."], error: true }
    }
  };
  let verified = verify_system_service(#name: verify_req.name, #for_user: verify_req.for_user, verify_req.code);
  {
    catch(e) fail("The system service is not running", (e.0).error);
    svc_ok <- verified?
  };
  let need_service = |t, scope: [Scope, null]| {
    svc_req <- { scope: (t ~ scope)$, name: null, for_user: null };
    null
  };
  // ── the lifecycle ceremonies ──
  let install_r = conduct(q, {
    let (role, dry) = select run { `Install(role, dry) => (role, dry), _ => never() };
    install::install(#role: role, #dry_run: dry, role)
  });
  let join_r = conduct(q, {
    let dry = select run { `Join(dry) => dry, _ => never() };
    join(#dry_run: dry, dry)
  });
  let addparent_r = conduct(q, {
    let a = select run { `AddParentTo(a) => a, _ => never() };
    let d = (a ~ current)$;
    add_parent(#config_root: d.config_dir, #parent: a.parent, #resolvers: a.resolvers, #path: a.path, d)
  });
  let restore_r = conduct(q, restore_stage(#bundle: null, select run { x@ `Restore => x, _ => never() }));
  let finish_r = conduct(q, {
    let x = select run { x@ `FinishRestore => x, _ => never() };
    restore_finish((x ~ restore_staged)$)
  });
  let uninstall_r = conduct(q, {
    let remove_ca = select run { `UninstallWith(remove_ca) => remove_ca, _ => never() };
    let d = (remove_ca ~ current)$;
    uninstall(#scope: d.scope, #config_dir: d.config_dir, #remove_ca: remove_ca, d)
  });
  {
    catch(e) select (e.0).error {
      `Cancelled(_) => toast <- {
        title: select (e ~ run) {
          `Install(_, true) => "Preview cancelled",
          _ => "Install cancelled"
        },
        lines: ["Nothing was changed."],
        error: false
      },
      `InstallIncomplete(m) => {
        toast <- { title: "Install incomplete", lines: [m], error: true };
        refresh <- m
      },
      other => fail("Install failed", other)
    };
    seq install_r {
      let r = install_r?;
      select r {
        `Installed({ service }) => need_service(r, service),
        _ => null
      };
      let role_name = select run {
        `Install(role, _) => role_title(role),
        _ => "Role"
      };
      toast <- select r {
      `Preview({ service }) => {
        title: "[role_name] preview",
        lines: array::concat(
          ["Preview only — nothing was written."],
          select service {
            null as _ => [],
            _ => ["A real install would then register the OS service."]
          }
        ),
        error: false
      },
      `Installed({ service }) => {
        title: "[role_name] installed",
        lines: [select service {
          null as _ => "Configuration written. No OS service was registered.",
          _ => "Configuration written. Registering the OS service…"
        }],
        error: false
      },
      `CaAwaitingSignature({ csr }) => {
        title: "CA awaiting external signature",
        lines: [
          "The CA is not running yet; no OS service was registered.",
          "Subordinate-CA CSR: [csr]",
          "Have the external PKI sign that CSR, return here, and choose Install Signed Certificate (External CA)."
        ],
        error: false
      }
      };
      refresh <- r
    }
  };
  {
    catch(e) fail("Join failed", (e.0).error);
    seq join_r {
      let r = join_r?;
      let dry = select run {
        `Join(d) => d,
        _ => false
      };
      toast <- select dry {
        true => { title: "Join preview", lines: ["Preview only — nothing was written."], error: false },
        false => { title: "Joined", lines: ["Joined the admin domain. Restart the local resolver to use it."], error: false }
      };
      refresh <- r
    }
  };
  {
    catch(e) fail("Adding the parent failed", (e.0).error);
    seq addparent_r {
      let r = addparent_r?;
      toast <- {
        title: "Parent added",
        lines: [
          "Delegation of [r.proposed_path] requested and approved.",
          "Configuration is written; do not restart the whole admin domain at once. Restart one member, wait the resolver delay-reads period for publishers to republish, then restart the next member."
        ],
        error: false
      };
      refresh <- r
    }
  };
  let restore_done = |t, role, service, reconciled: [string, null]| {
    toast <- {
      title: t ~ "Restore complete",
      lines: array::concat(
        ["[role_title(role)] is installed and ready."],
        select reconciled {
          null as _ => [],
          op => ["Resolver hierarchy reconciled (operation [op])."]
        }
      ),
      error: false
    };
    need_service(t, service);
    restore_staged <- t ~ null;
    refresh <- t;
    null
  };
  {
    catch(e) fail("Restore failed", (e.0).error);
    seq restore_r {
      let r = restore_r?;
      select r {
      `Finish(o) => restore_done(o, o.role, o.service, o.reconciled),
      `ServiceThenFinish({ scope, service, staged }) => {
        restore_staged <- staged;
        toast <- {
          title: "CA restored",
          lines: ["Starting the CA before re-enrolling its co-located TLS roles… Once its service runs, press F to finish the restore."],
          error: false
        };
        svc_req <- { scope, name: service.name, for_user: service.for_user };
        null
      }
      }
    }
  };
  run <- (svc_ok ~ restore_staged)$ ~ `FinishRestore;
  {
    catch(e) fail("Finishing the restore failed", (e.0).error);
    seq finish_r {
      let o = finish_r?;
      restore_done(o, o.role, o.service, o.reconciled)
    }
  };
  {
    catch(e) fail("Uninstall failed", (e.0).error);
    seq uninstall_r {
      let r = uninstall_r?;
      let kept_lines = |kept: Array<{ path: string, why: string }>|
        array::map(kept, |k| "Kept [k.path] ([k.why]).");
      toast <- select r {
      `Nothing => { title: "Uninstalled", lines: ["Nothing to remove."], error: false },
      `Removed(rep) => {
        let service_note = select rep.service_was_installed {
          true => " and the OS service",
          false => ""
        };
        let destroyed = select rep.ca_destroyed {
          null as _ => [],
          d => ["Destroyed the CA at [d]."]
        };
        {
          title: "Uninstalled",
          lines: array::concat(
            ["Removed [array::len(rep.removed)] path(s)[service_note]."],
            kept_lines(rep.kept),
            destroyed
          ),
          error: false
        }
      },
      `Escalate({ covers, .. }) => {
        title: "Administrator privileges needed",
        lines: [
          "The system-scope parts are removed on the terminal next; enter your password there.",
          select covers {
            `Everything => "That completes the removal.",
            `SystemServiceOnly => "The user-scope configuration is removed afterwards."
          }
        ],
        error: false
      }
      };
      let remove_ca = select run {
      `UninstallWith(rc) => rc,
      _ => false
      };
      select r {
      `Escalate({ covers, argv, .. }) => {
        priv_req <- {
          what: "tear down the install",
          argv: array::push(argv, "--yes"),
          then: select covers {
            `Everything => `Nothing,
            `SystemServiceOnly => `UninstallAgain(remove_ca)
          }
        };
        null
      },
      _ => refresh <- r
      }
    }
  };
  // ── the views ──
  let fresh_view = {
    let titles = array::map(fresh_choices, |c| line(c.title));
    let choice = selected(fresh_choices, role_sel)$;
    let keys = select choice.act {
      `Restore => " Enter restore ",
      _ => " Enter install · p preview "
    };
    layout(#direction: &`Horizontal, &[
      child(#constraint: `Length(24), block(
        #border: &`All,
        #title: &line("Set Up This Machine"),
        #title_bottom: &line(#style: hint, keys),
        &list(#highlight_style: &selstyle, #selected: &role_sel, &titles))),
      child(#constraint: `Min(0), block(
        #border: &`All,
        #title: &line(choice.title),
        &paragraph(&choice.blurb)))
    ])
  };
  let home_view = {
    let labels = array::map(items, |it| line(it.label));
    let title = select current {
      null as _ => "",
      d => "[role_title(d.role)] ([service_word(d.service)])"
    };
    let keys = select opt_len(detected) {
      n if n > 1 => " ↑/↓ select · Enter run · ‹/› switch install ",
      _ => " ↑/↓ select · Enter run "
    };
    let desc_lines = select menu_item {
      null as _ => [],
      i => [line(i.desc)]
    };
    layout(#direction: &`Horizontal, &[
      child(#constraint: `Min(0), block(
        #border: &`All,
        #title: &line(title),
        #title_bottom: &line(#style: hint, keys),
        &list(#highlight_style: &selstyle, #selected: &menu_sel, &labels))),
      child(#constraint: `Length(42), block(
        #border: &`All,
        #title: &line("Description"),
        &paragraph(#trim: &false, &desc_lines)))
    ])
  };
  let handle = |e: Event| on_press(e, |k| select k ~ screen {
    `Admin => pan.handle(e),
    `Services => svc.handle(e),
    `Home => select k ~ fresh {
      true => fresh_keys(k),
      false => home_keys(k)
    }
  });
  let view = select screen {
    `Admin => pan.view,
    `Services => svc.view,
    `Home => select fresh {
      true => fresh_view,
      false => home_view
    }
  };
  let status = select screen {
    `Admin => pan.status,
    `Services => svc.status,
    `Home => select fresh {
      true => line(#style: hint, " ↑/↓ choose · Enter install "),
      false => line(#style: hint, " Enter run · U update · r renew · u uninstall · R re-detect ")
    }
  };
  let layers = array::concat(
    select screen {
      `Admin => pan.layers,
      `Services => svc.layers,
      `Home => []
    },
    welcome(fresh),
    status_card(row, select run { x@ `Status => x, _ => never() }),
    ca_question(#on_answer: |remove_ca| { run <- `UninstallWith(remove_ca); null }, ca_ask),
    parent_picker(#toast: &toast, #on_pick: |c| { run <- `AddParentTo(c); null }, parent_root),
    confirm_layers(#on_confirm: |a| { run <- a; null }, &confirm),
    toast_layers(&toast)
  );
  { view, handle, status, layers, installed: !fresh }
}
