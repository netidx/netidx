mod theme;

use theme::hint;
use tui::{
  line_edit,
  input_handler::{Event, KeyEvent, input_handler, on_press},
  layout::{child, layout},
  list::list,
  paragraph::paragraph,
  text::text
};

let glyph = |fp: Fingerprint| -> Array<tui::Line> select identicon(fp)$ {
  { cells, color } => {
    let on = {
      theme::glyph with fg: `Rgb({
        r: cast<i64>(color.r)$,
        g: cast<i64>(color.g)$,
        b: cast<i64>(color.b)$
      })
    };
    let off = theme::glyph;
    let border = line(#style: off, #alignment: `Center, "                    ");
    let rows = array::map(cells, |row| line(#alignment: `Center, array::concat(
      [span(#style: off, "  ")],
      array::map(row, |c| select c {
        true => span(#style: on, "██"),
        false => span(#style: off, "  ")
      }),
      [span(#style: off, "  ")]
    )));
    array::concat([border], rows, [border])
  }
};

let fingerprint_lines = |#alignment: tui::Alignment = `Center, fp: Fingerprint| -> Array<tui::Line> {
  let groups = str::split(#pat: " ", fp.code);
  let chunks = array::fold(groups, [], |acc, g| select acc {
    [] => [[g]],
    [init.., last] => select array::len(last) {
      n if n < 4 => array::push(init, array::push(last, g)),
      _ => array::push(acc, [g])
    }
  });
  array::map(chunks, |c| line(
    #style: theme::hash,
    #alignment: alignment,
    str::join(#sep: " ", c)
  ))
};

let admin_text = |a: AdminError| -> string select a {
  `Admin(m) => m,
  `Cancelled(m) => m,
  `InstallIncomplete(m) => m,
  `LoginRequired(m) => m,
  `PasswordChangeRequired(name) => "[name]'s password must be changed first",
  `Unsupported(m) => "unsupported on this platform: [m]"
};

let conduct = |q: &mut Question, c: Result<Ceremony<'r>, AdminError>| -> Result<'r, AdminError> {
  *q <- questions(c);
  let r = result(c);
  // the ceremony's end is a terminal progress note, so the pump drops
  // whatever it was last told the ceremony was doing
  *q <- r ~ `Progress({ stage: `Done, message: "", duration: null });
  r
};

let identity_lines = |fp: Fingerprint| array::concat(glyph(fp), fingerprint_lines(fp));

let opt_len = |o: [Array<'a>, null]| select o {
  null as _ => 0,
  a => array::len(a)
};

// the row a cursor rests on, clamped to the list; null while there is none
let selected = |rows: [Array<'a>, null], i: i64| -> ['a, null] select rows {
  null as _ => null,
  [] => null,
  rows => rows[min(i, array::len(rows) - 1)]$
};

// the rows `text` takes in a paragraph `width` columns wide: each line
// wraps at word boundaries, and a word wider than a row breaks across rows
let wrapped_rows = |width: i64, text: string| -> i64 {
  let line_rows = |l: string| -> i64 {
    let words = array::filter(str::split(#pat: " ", l), |w| w != "");
    let (rows, _) = array::fold(words, (1, 0), |(rows, col), w| {
      let n = str::char_len(w);
      select col {
        c if c > 0 && c + 1 + n <= width => (rows, c + 1 + n),
        c => {
          let start = select c {
            0 => rows,
            _ => rows + 1
          };
          (start + (n - 1) / width, (n - 1) % width + 1)
        }
      }
    });
    rows
  };
  array::fold(str::split(#pat: "\n", text), 0, |n, l| n + line_rows(l))
};

let lines_rows = |width: i64, lines: [string, Array<tui::Line>]| -> i64 select lines {
  string as s => wrapped_rows(width, s),
  ls => array::fold(ls, 0, |n, l: tui::Line| n + wrapped_rows(width, select l.spans {
    string as s => s,
    spans => str::join(#sep: "", array::map(spans, |sp: tui::Span| sp.content))
  }))
};

// a dialog `cap` columns wide, or as wide as the terminal leaves room for
let dialog_width = |cap: i64| -> i64 min(cap, tui::size.width - 4);

// a dialog sized to `rows` of content inside its borders
let fitted = |width: i64, rows: i64, content: tui::Tui| -> Layer
  theme::dialog(#width: &`Length(width), #height: &`Length(rows + 2), content);

let toast_layers = |t: &mut [Toast, null]| -> Array<Layer> {
  let handle = |e: Event| {
    on_press(e, |k| select k.code {
      `Enter | `Esc | `Char(" ") => { *t <- k ~ null; `Stop },
      _ => `Stop
    });
    e ~ `Stop
  };
  select *t {
    null as _ => [],
    tt => {
      let body = str::join(#sep: "\n", tt.lines);
      let width = dialog_width(72);
      [fitted(width, wrapped_rows(width - 2, body),
        input_handler(#handle: &handle, &theme::panel(
          #title: tt.title,
          #title_style: select tt.error {
            true => theme::alert,
            false => theme::heading
          },
          #legend: " Enter dismiss ",
          paragraph(#trim: &false, &body))))]
    }
  }
};

let confirm_layers = |#on_confirm: fn(a: 'a) -> null, c: &mut [Confirm<'a>, null]| -> Array<Layer> {
  let handle = |e: Event| {
    on_press(e, |k| select k.code {
      `Char("y") | `Enter => {
        select k ~ *c {
          null as _ => never(),
          cc => { on_confirm(cc.action); *c <- cc ~ null }
        };
        `Stop
      },
      `Char("n") | `Esc => { *c <- k ~ null; `Stop },
      _ => `Stop
    });
    e ~ `Stop
  };
  select *c {
    null as _ => [],
    cc => {
      let width = dialog_width(70);
      [fitted(width, lines_rows(width - 2, cc.message),
        input_handler(#handle: &handle, &theme::panel(
          #title: "Confirm",
          #title_style: theme::alert,
          #legend: " y confirm · n cancel ",
          paragraph(#trim: &false, &cc.message))))]
    }
  }
};

let qid = |b: Blocking| select b {
  `Text({ id, .. }) => id,
  `Secret({ id, .. }) => id,
  `Choice({ id, .. }) => id,
  `Confirm({ id, .. }) => id,
  `SelectAdminDomain({ id, .. }) => id,
  `Announce({ id, .. }) => id,
  `AnnounceIdentity({ id, .. }) => id,
  `ConfirmIdentity({ id, .. }) => id,
  `OneTimeSecret({ id, .. }) => id
};

let pump = |q: Question| -> Pump {
  // ── presentation channels ──
  let notes = [];
  let progress: [{ stage: Stage, message: string, duration: [duration, null] }, null] = null;
  let code: [{ purpose: string, fp: Fingerprint }, null] = null;
  // ── the outstanding blocking question and its per-modal state ──
  let active: [Blocking, null] = null;
  // a question supersedes the progress note: the ceremony is waiting on
  // the operator, not working
  progress <- active ~ null;
  let ed = line_edit::state("");
  let sel = 0;
  let yes = false;
  let err: [string, null] = null;
  select q {
    `Text(t) => {
      active <- `Text(t);
      ed <- line_edit::state(opt::or_default(t.default, ""));
      err <- t ~ null
    },
    `Secret(s) => {
      active <- `Secret(s);
      ed <- line_edit::state(s ~ "");
      err <- s ~ null
    },
    `Choice(c) => {
      active <- `Choice(c);
      sel <- opt::or_default(
        opt::flat_map(c.default, |d| array::find_map(array::enumerate(c.choices), |(i, x)| select x {
          v if v == d => i,
          _ => null
        })),
        0
      );
      err <- c ~ null
    },
    `Confirm(c) => {
      active <- `Confirm(c);
      yes <- c.default;
      err <- c ~ null
    },
    `SelectAdminDomain(d) => {
      active <- `SelectAdminDomain(d);
      sel <- d ~ 0;
      err <- d ~ null
    },
    `Announce(a) => { active <- `Announce(a); err <- a ~ null },
    `AnnounceIdentity(a) => { active <- `AnnounceIdentity(a); err <- a ~ null },
    `ConfirmIdentity(i) => { active <- `ConfirmIdentity(i); err <- i ~ null },
    `OneTimeSecret(o) => { active <- `OneTimeSecret(o); err <- o ~ null },
    `VerificationCode(v) => code <- v,
    v@ `ClearVerificationCode => { code <- v ~ null; progress <- v ~ null },
    `Progress(p) => select p.stage {
      `Done => { progress <- p ~ null; code <- p ~ null },
      _ => progress <- p
    },
    `Note(s) => notes <- array::window(#n: 100, s ~ notes, s),
    `Warn(s) => notes <- array::window(#n: 100, s ~ notes, "⚠ [s]")
  };
  // ── what Enter would submit for the current modal ──
  let composed = select active {
    null as _ => null,
    `Text({ id, required, .. }) => select ed.value {
      "" if required => `Required,
      "" => { id, a: `Text(null) },
      v => { id, a: `Text(v) }
    },
    `Secret({ id, .. }) => { id, a: `Secret(ed.value) },
    `Choice({ id, choices, .. }) => { id, a: `Choice(choices[sel]$) },
    `Confirm({ id, .. }) => { id, a: `Confirm(yes) },
    `SelectAdminDomain({ id, domains }) => {
      let n = array::len(domains);
      select sel {
        s if s == n => { id, a: `Domain(`PollMore) },
        s if s == n + 1 => { id, a: `Domain(`Manual) },
        s => { id, a: `Domain(`Discovered(s)) }
      }
    },
    `Announce({ id, .. }) => { id, a: `Ack },
    `AnnounceIdentity({ id, .. }) => { id, a: `Ack },
    `ConfirmIdentity({ id, .. }) => { id, a: `Confirm(true) },
    `OneTimeSecret({ id, .. }) => { id, a: `Ack }
  };
  // ── submit: answer the question, close on success, show refusals ──
  let submit = never<{ id: QuestionId, a: Answer }>();
  seqq let s = submit {
    try {
      answer(s.id, s.a)?;
      active <- null;
      null
    } with(e) {
      err <- select (e.0).error { `Admin(m) => m };
      null
    }
  };
  let enter = |t| {
    select t ~ composed {
      null as _ => never(),
      `Required => err <- t ~ "a value is required",
      c => submit <- c
    };
    null
  };
  let cancel = |t| {
    submit <- t ~ { id: qid(active$), a: `Cancel };
    null
  };
  let confirm_answer = |t, v| {
    submit <- t ~ { id: qid(active$), a: `Confirm(v) };
    null
  };
  // ── per-kind key handling ──
  let text_keys = |ev, k: KeyEvent| select k.code {
    kk@ `Enter => { enter(kk); `Stop },
    kk@ `Esc => { cancel(kk); `Stop },
    _ => line_edit::handle(&mut ed, ev)
  };
  let list_keys = |k: KeyEvent, last| select k.code {
    `Up | `Char("k") => { sel <- k ~ max(0, sel - 1); `Stop },
    `Down | `Char("j") => { sel <- k ~ min(last, sel + 1); `Stop },
    kk@ `Enter => { enter(kk); `Stop },
    kk@ `Esc => { cancel(kk); `Stop },
    _ => `Continue
  };
  let confirm_keys = |k: KeyEvent| select k.code {
    `Left | `Right | `Tab => { yes <- k ~ !yes; `Stop },
    kk@ `Char("y") => { confirm_answer(kk, true); `Stop },
    kk@ `Char("n") => { confirm_answer(kk, false); `Stop },
    kk@ `Enter => { enter(kk); `Stop },
    kk@ `Esc => { cancel(kk); `Stop },
    _ => `Continue
  };
  let ack_keys = |k: KeyEvent| select k.code {
    `Enter | `Char(" ") => { enter(k); `Stop },
    kk@ `Esc => { cancel(kk); `Stop },
    _ => `Continue
  };
  let identity_keys = |k: KeyEvent| select k.code {
    `Char("a") | `Enter => { confirm_answer(k, true); `Stop },
    `Char("r") | `Char("n") | `Esc => { confirm_answer(k, false); `Stop },
    _ => `Continue
  };
  let handle = |e: Event| select e {
    `Paste(_) => select e ~ active {
      `Text(_) | `Secret(_) => line_edit::handle(&mut ed, e),
      _ => e ~ `Continue
    },
    _ => on_press(e, |k| select k ~ active {
      null as _ => `Continue,
      `Text(_) => text_keys(e, k),
      `Secret(_) => text_keys(e, k),
      `Choice({ choices, .. }) => list_keys(k, array::len(choices) - 1),
      `Confirm(_) => confirm_keys(k),
      `SelectAdminDomain({ domains, .. }) => list_keys(k, array::len(domains) + 1),
      `Announce(_) => ack_keys(k),
      `AnnounceIdentity(_) => ack_keys(k),
      `ConfirmIdentity(_) => identity_keys(k),
      `OneTimeSecret(_) => ack_keys(k)
    })
  };
  // ── the modal views ──
  let width = dialog_width(64);
  let help_rows = |field: FieldInfo| wrapped_rows(width - 2, field.help);
  // the field's help, then a blank row before what answers it
  let helped = |field: FieldInfo, below: Array<tui::layout::Child>| layout(
    #direction: &`Vertical,
    &array::concat(
      [
        child(#constraint: `Length(help_rows(field)), paragraph(#style: &hint, &field.help)),
        child(#constraint: `Length(1), text(&[]))
      ],
      below
    )
  );
  let err_lines = select err {
    null as _ => [],
    m => [line(#style: theme::error, m)]
  };
  let text_modal = |field: FieldInfo, mask| theme::panel(
    #title: field.label,
    #legend: " Enter submit · Esc cancel ",
    helped(field, [
      child(#constraint: `Length(1),
        text(#style: &theme::field, &[line_edit::view(#mask: mask, &ed)])),
      child(#constraint: `Length(1), text(&err_lines))
    ])
  );
  let choice_modal = |field: FieldInfo, choices| theme::panel(
    #title: field.label,
    #legend: " ↑/↓ move · Enter select · Esc cancel ",
    helped(field, [
      child(#constraint: `Length(array::len(choices)),
        list(#highlight_style: &theme::selected, #selected: &sel,
          &array::map(choices, |c| line(c))))
    ])
  );
  let confirm_modal = |field: FieldInfo| theme::panel(
    #title: field.label,
    #legend: " ←/→ toggle · y/n · Enter confirm · Esc cancel ",
    helped(field, [
      child(#constraint: `Length(1), text(#alignment: &`Center,
        &[line([theme::button("Yes", yes), span("   "), theme::button("No", !yes)])]))
    ])
  );
  let domain_modal = |domains: Array<AdminDomain>| {
    let items = array::push(
      array::map(domains, |d| line(d.domain)),
      line("Search again for more admin domains"),
      line("Enter an address manually…")
    );
    let side = select sel {
      s if s < array::len(domains) => {
        let fp = (domains[s]$).identity.fingerprint;
        identity_lines(fp)
      },
      s if s == array::len(domains) => [line(#style: hint, "Browse the network again.")],
      _ => [line(#style: hint, "Type an admin-server address (host:port).")]
    };
    theme::panel(
      #title: "Select an admin domain",
      #legend: " ↑/↓ move · Enter select · Esc cancel ",
      layout(#direction: &`Horizontal, &[
        child(#constraint: `Min(20),
          list(#highlight_style: &theme::selected, #selected: &sel, &items)),
        child(#constraint: `Length(26), paragraph(#trim: &false, &side))
      ])
    )
  };
  let announce_modal = |title, body| theme::panel(
    #title: title,
    #legend: " Enter continue · Esc cancel ",
    paragraph(&body)
  );
  let announce_identity_modal = |body, fp| theme::panel(
    #title: "Verify this identity",
    #legend: " Enter continue · Esc cancel ",
    layout(#direction: &`Vertical, &[
      child(#constraint: `Min(2), paragraph(#style: &hint, &body)),
      child(#constraint: `Length(13),
        paragraph(#alignment: &`Center, #trim: &false,
          &identity_lines(fp)))
    ])
  );
  let confirm_identity_modal = |identity: CaIdentity| theme::panel(
    #title: "Confirm the CA's identity",
    #legend: " a accept · r reject ",
    layout(#direction: &`Vertical, &[
      child(#constraint: `Length(2), paragraph(#style: &hint,
        &"Verify OUT OF BAND that this is [identity.domain]'s CA glyph and fingerprint.")),
      child(#constraint: `Min(13),
        paragraph(#alignment: &`Center, #trim: &false,
          &identity_lines(identity.fingerprint)))
    ])
  );
  let secret_modal = |kind, password| {
    let title = select kind {
      `CaRecovery => "CA recovery password — shown ONCE",
      `AdminPassword(name) => "One-time password for [name]"
    };
    theme::panel(
      #title: title,
      #legend: " Enter acknowledge ",
      layout(#direction: &`Vertical, &[
        child(#constraint: `Length(2), paragraph(#style: &hint,
          &"Record this now; it is never shown again.")),
        child(#constraint: `Length(1), text(#alignment: &`Center,
          &[line(#style: theme::heading, password)]))
      ])
    )
  };
  let keyed = |view: tui::Tui| input_handler(#handle: &handle, &view);
  // a dialog sized to its text, or, carrying a glyph, to the screen
  let roomy = |view: tui::Tui| theme::dialog(
    #width: &`Percentage(70),
    #height: &`Percentage(70),
    keyed(view)
  );
  let modal = select active {
    null as _ => null,
    `Text({ field, .. }) => fitted(width, help_rows(field) + 3, keyed(text_modal(field, null))),
    `Secret({ field, .. }) => fitted(width, help_rows(field) + 3, keyed(text_modal(field, "•"))),
    `Choice({ field, choices, .. }) => fitted(
      width,
      help_rows(field) + 1 + array::len(choices),
      keyed(choice_modal(field, choices))
    ),
    `Confirm({ field, .. }) => fitted(width, help_rows(field) + 2, keyed(confirm_modal(field))),
    `SelectAdminDomain({ domains, .. }) => roomy(domain_modal(domains)),
    `Announce({ title, body, .. }) =>
      fitted(width, wrapped_rows(width - 2, body), keyed(announce_modal(title, body))),
    `AnnounceIdentity({ body, fp, .. }) => roomy(announce_identity_modal(body, fp)),
    `ConfirmIdentity({ identity, .. }) => roomy(confirm_identity_modal(identity)),
    `OneTimeSecret({ kind, password, .. }) => fitted(width, 3, keyed(secret_modal(kind, password)))
  };
  // the standing code, while nothing is asked: the operator reads it to
  // the approving admin, who sees the same one in their confirmation
  let code_box = |c: { purpose: string, fp: Fingerprint }| theme::panel(
    #title: "Verification code — [c.purpose]",
    #legend: " waiting for approval ",
    layout(#direction: &`Vertical, &[
      child(#constraint: `Length(2), paragraph(#style: &hint,
        &"Read this code to the approving admin out of band; they must see the same one before they approve.")),
      child(#constraint: `Length(13),
        paragraph(#alignment: &`Center, #trim: &false, &identity_lines(c.fp)))
    ])
  );
  let layers = select modal {
    null as _ => select code {
      null as _ => [],
      c => [theme::dialog(#width: &`Percentage(70), #height: &`Length(17), keyed(code_box(c)))]
    },
    l => [l]
  };
  {
    layers,
    notes,
    progress,
    code,
    busy: opt::is_some(active)
  }
}
