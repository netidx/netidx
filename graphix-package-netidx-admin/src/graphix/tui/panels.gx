  {
    kind: `Queue,
    title: "Enrollment Queue",
    desc: "Review and approve certificate-enrollment requests from nodes joining the admin domain.",
    keys: " a approve · d deny · R renewals · r refresh · Esc back "
  },
  {
    kind: `Delegations,
    title: "Delegation Requests",
    desc: "Review and approve requests from resolvers asking to attach under this resolver cluster.",
    keys: " a approve · d deny · r refresh · Esc back "
  },
  {
    kind: `Roster,
    title: "Admin Roster",
    desc: "The admin domain's admins and their scopes.",
    keys: " a add · e edit policy · c change my password · p reset-password · d remove · r refresh · Esc back "
  },
  {
    kind: `Servers,
    title: "Admin Servers",
    desc: "Every CA-authoritative server identity — reconcile CA state, or permanently remove a dead node.",
    keys: " g read gate · c reconcile CA · x remove · r refresh · Esc back "
  },
  {
    kind: `Certs,
    title: "Issued Certificates",
    desc: "Certificates this CA has issued — revoke one to bar the holder from the admin domain.",
    keys: " x revoke · r refresh · Esc back "
  },
  {
    kind: `Services,
    title: "Services",
    desc: "Start, stop, or restart the activation units of one admin server's resolver.",
    keys: " s start · t stop · R restart · r refresh · Esc back "
  },
  {
    kind: `Perms,
    title: "Permissions",
    desc: "View and edit the permissions of a resolver cluster's namespace.",
    keys: " a add · e edit · d remove · r refresh · Esc back "
  }
];

let gate_choices: Array<{ label: string, gate: GateReq }> = [
  { label: "Open — answer read clients", gate: `Open },
  { label: "Shut — until someone opens the gate again", gate: `Shut },
  { label: "Shut for 5 minutes", gate: `ShutFor(duration:300.s) },
  { label: "Shut for 30 minutes", gate: `ShutFor(duration:1800.s) },
  { label: "Shut for 2 hours", gate: `ShutFor(duration:7200.s) },
  { label: "Shut for 8 hours", gate: `ShutFor(duration:28800.s) }
];

let fmt_age = |secs: u64| select secs {
  s if s < u64:60 => "[s]s",
  s if s < u64:3600 => "[s / u64:60]m",
  s => "[s / u64:3600]h[(s % u64:3600) / u64:60]m"
};

let fmt_slot = |k: SlotKind| select k {
  `Signing => "signing",
  `Role => "role"
};

let fmt_dur = |d: duration| fmt_age(cast<u64>(d)$);

let gate_label = |g: [ReadGate, null], now: datetime| select g {
  null as _ => "-",
  `Open => "open",
  `Shut => "shut",
  `Until(t) if t > now => "shut [fmt_dur(sys::time::diff(t, now))]",
  `Until(_) => "open (expired)"
};

let gate_detail = |g: [ReadGate, null]| select g {
  null as _ => "no resolver, so no read gate",
  `Open => "open — answering read clients",
  `Shut => "shut — refusing read clients until opened",
  `Until(t) => "shut — refusing read clients until [t]"
};

// what a gate change risks, or null when it changes nothing worth a stop
let gate_warning = |s: ServerInfo, gate: GateReq, now: datetime| {
  let who = "[s.id] at [s.addr]";
  select (gate, s.read_gate) {
    (`Open, `Until(t)) if t > now =>
      "Start [who] answering read clients [fmt_dur(sys::time::diff(t, now))] early?\n\nIt is waiting for publishers to find it. Anything that has not been republished yet will look absent to subscribers resolving through it.",
    (`Open, `Shut) =>
      "Start [who] answering read clients?\n\nIt will answer from whatever it holds now. If it was taken out of service, that may be a stale picture of the namespace.",
    (`Open, _) => null,
    (`Shut, _) =>
      "Stop [who] answering read clients?\n\nSubscribers stop resolving through it until someone opens the gate again. Publishers keep writing to it, so its records stay fresh — it just stops answering.",
    (`ShutFor(d), _) =>
      "Stop [who] answering read clients for [fmt_dur(d)]?\n\nSubscribers stop resolving through it until then. Publishers keep writing to it, so its records stay fresh — it just stops answering.",
    (`Until(t), _) =>
      "Stop [who] answering read clients until [t]?\n\nSubscribers stop resolving through it until then. Publishers keep writing to it, so its records stay fresh — it just stops answering."
  }
};

// comma-separated text ⇄ a list, blanks dropped
let csv = |s: string| array::filter_map(str::split(#pat: ",", s), |p|
  select str::trim(p) {
    "" => null,
    t => t
  });

let list_text = |xs: Array<string>| str::join(#sep: ", ", xs);

// "7d", "12h", "30m", "90s", "2w", "1y" — a count and a unit letter
let parse_duration = |s: string| {
  let t = str::trim(s);
  select re::captures(#pat: r"^([0-9]+(?:\.[0-9]+)?)\s*([a-zA-Z]*)$", t)$ {
    [] => null,
    [m, ..] => {
      let n = cast<f64>(m[1]$)$;
      let factor = select m[2]$ {
        null as _ => 1.0,
        "" => 1.0,
        "s" => 1.0,
        "m" => 60.0,
        "h" => 3600.0,
        "d" => 86400.0,
        "w" => 604800.0,
        "y" => 31557600.0,
        _ => null
      };
      select factor {
        null as _ => null,
        f => sys::time::scale(duration:1.s, n * f)$
      }
    }
  }
};

// a duration as the largest whole unit it measures
let dur_text = |d: duration| {
  let secs = cast<i64>(d)$;
  select secs {
    n if n % 86400 == 0 && n > 0 => "[n / 86400]d",
    n if n % 3600 == 0 && n > 0 => "[n / 3600]h",
    n if n % 60 == 0 && n > 0 => "[n / 60]m",
    n => "[n]s"
  }
};

let yes_no = |s: string| select str::to_lower(str::trim(s)) {
  "y" | "yes" | "true" => true,
  _ => false
};

let policy_fields = |p: Policy| [
  { label: "allowed SAN", value: list_text(p.allowed_san) },
  { label: "max validity", value: dur_text(p.max_validity) },
  { label: "id-map groups", value: list_text(p.id_map_groups) },
  { label: "enroll scopes", value: list_text(p.server_enroll_scopes) },
  { label: "enroll roles", value: list_text(p.server_enroll_roles) },
  { label: "perms scopes", value: list_text(p.perms_edit_scopes) },
  { label: "manage admins", value: select p.may_manage_admins { true => "yes", false => "no" } },
  { label: "service scopes", value: list_text(p.service_control_scopes) }
];

let empty_policy = {
  allowed_san: [],
  max_validity: duration:604800.s,
  id_map_groups: [],
  server_enroll_scopes: [],
  server_enroll_roles: [],
  perms_edit_scopes: [],
  may_manage_admins: false,
  service_control_scopes: []
};

// the eight policy fields, in `policy_fields` order, back to a policy
let read_policy = |v: Array<string>| select parse_duration(v[1]$) {
  null as _ => `BadValidity,
  d => {
    allowed_san: csv(v[0]$),
    max_validity: d,
    id_map_groups: csv(v[2]$),
    server_enroll_scopes: csv(v[3]$),
    server_enroll_roles: csv(v[4]$),
    perms_edit_scopes: csv(v[5]$),
    may_manage_admins: yes_no(v[6]$),
    service_control_scopes: csv(v[7]$)
  }
};

let fmt_unit_state = |st: UnitState| select st {
  `NotStarted => "not started",
  `Running(null) => "running",
  `Running(pid) => "running (pid [pid])",
  `Stopped => "stopped",
  `Died => "died"
};

let fmt_service_op = |op: ServiceOp| select op {
  `Start => "Started",
  `Stop => "Stopped",
  `Restart => "Restarted",
  `Status => "Listed"
};

let note = |title: string, lines: Array<string>| -> Toast { title, lines, error: false };

let failure = |title: string, a: AdminError| -> Toast { title, lines: [admin_text(a)], error: true };

let peer_lines = |peers: Array<PeerResult>| array::map(peers, |p| select p.error {
  null as _ => "updated [p.server]",
  e => "failed [p.server]: [e]"
});

let one_time_password = |pw: string|
  note("One-time password", ["Record this now; it is never shown again:", pw]);

// a panel's rows: absent until a load answers, then what the last load
// that succeeded returned; a failed load says why on the toast
let rows_of = |#toast: &[Toast, null], #failed: string, r: Result<Array<'a>, AdminError>|
  -> [Array<'a>, null] {
  let rows: [Array<'a>, null] = null;
  catch(e) *toast <- failure(failed, (e.0).error);
  rows <- r?;
  rows
};

// what a finished action does: toast what `say` makes of its result and
// name the panel to reload; a failed one toasts why and reloads nothing
let outcome = |
  #toast: &[Toast, null],
  #failed: string,
  #reload: PanelKind,
  r: Result<'a, AdminError>,
  say: fn(v: 'a) -> Toast
| -> PanelKind {
  catch(e) *toast <- failure(failed, (e.0).error);
  seq r {
    let v = r?;
    *toast <- say(v);
    v ~ reload
  }
};

let panels = |
  #q: &Question,
  #entry: Entry,
  #on_close: fn(why: CloseReason) -> null,
  target: Target
| -> Panels {
  let menu_legend = line(#style: hint, " ↑/↓ move · Enter open · Esc disconnect ");
  let pick_legend = line(#style: hint, " ↑/↓ move · Enter open · Esc back ");
  let bold = style(#add_modifier: [`Bold]);
  let screen: Screen = select entry {
    `Menu => `Menu,
    `Roster => `Panel(`Roster),
    `Perms(_) => `Panel(`Perms)
  };
  // ── shared ui state ──
  let menu_sel = 0;
  let row_sel = 0;
  row_sel <- entry ~ 0;
  let toast: [Toast, null] = null;
  let pick_sel = 0;
  let service_server: [ServiceServer, null] = null;
  let perms_at = select entry {
    `Perms(at) => at,
    _ => null
  };
  let gate_for: [ServerInfo, null] = null;
  let gate_sel = 0;
  let perm_fields = never();
  let perm_open = false;
  let run = never<Act>();
  let perm_form = form(
    #title: "Permission entry",
    #help: "Bits are a permission string such as swlpd; an empty entity is anonymous.",
    #on_submit: |v| {
      run <- `SetPerm({ path: v[0]$, entity: v[1]$, bits: v[2]$ });
      perm_open <- v ~ false;
      null
    },
    #on_cancel: |e| { perm_open <- e ~ false; null },
    perm_fields
  );
  let policy_fields_in = never();
  let policy_title = "";
  let policy_open = false;
  let policy_target: [`Add, `Edit(string)] = `Add;
  let bad_validity = {
    title: "Bad validity",
    lines: ["Write the validity as a count and a unit, such as 7d or 12h."],
    error: true
  };
  let policy_form = form(
    #title: policy_title,
    #help: "Lists are comma-separated; validity is a count and a unit (7d, 12h, 30m); roles are Ca, Resolver, IdMap.",
    #on_submit: |v| {
      select v ~ policy_target {
        `Add => select read_policy(v[1..]$) {
          `BadValidity => toast <- v ~ bad_validity,
          p => { run <- `AddAdmin({ name: v[0]$, policy: p }); policy_open <- p ~ false }
        },
        `Edit(name) => select read_policy(v) {
          `BadValidity => toast <- v ~ bad_validity,
          p => { run <- `SetPolicy({ name, policy: p }); policy_open <- p ~ false }
        }
      };
      null
    },
    #on_cancel: |e| { policy_open <- e ~ false; null },
    policy_fields_in
  );
  let confirm: [Confirm<Act>, null] = null;
  // ── panel loads: each (re)load starts a fresh list ceremony ──
  let load = never<PanelKind>();
  load <- select entry {
    `Roster => `Roster,
    `Perms(_) => `Perms,
    `Menu => never()
  };
  let queue_r = conduct(q, {
    let x = select load { x@ `Queue => x, _ => never() };
    list_queue(x ~ target)
  });
  let deleg_r = conduct(q, {
    let x = select load { x@ `Delegations => x, _ => never() };
    list_pending_delegations(x ~ target)
  });
  let servers_r = conduct(q, {
    let x = select load { x@ `Servers => x, _ => never() };
    servers::list(x ~ target)
  });
  let certs_r = conduct(q, {
    let x = select load { x@ `Certs => x, _ => never() };
    issued(x ~ target)
  });
  let roster_r = {
    let x = select load { x@ `Roster => x, _ => never() };
    admins::list(x ~ target)
  };
  let units_r = conduct(q, {
    let x = select load { x@ `Services => x, _ => never() };
    let s = (x ~ service_server)$;
    service_control(#units: [], #op: `Status, #server: s.id, x ~ target)
  });
  let perms_r = {
    let x = select load { x@ `Perms => x, _ => never() };
    perms::show(#at: (x ~ perms_at)$, x ~ target)
  };
  // ── the pick screens' lists ──
  let pick = never<[`Servers, `Clusters]>();
  let svc_servers_r = conduct(q, {
    let x = select pick { x@ `Servers => x, _ => never() };
    list_service_servers(x ~ target)
  });
  let clusters_r = {
    let x = select pick { x@ `Clusters => x, _ => never() };
    list_resolver_clusters(x ~ target)
  };
  let queue_rows = rows_of(#toast: &toast, #failed: "Loading the queue failed", queue_r);
  let deleg_rows = rows_of(#toast: &toast, #failed: "Loading delegations failed", deleg_r);
  let server_rows = rows_of(#toast: &toast, #failed: "Loading servers failed", servers_r);
  let cert_rows = rows_of(#toast: &toast, #failed: "Loading certificates failed", certs_r);
  let roster_rows = rows_of(#toast: &toast, #failed: "Loading the roster failed", roster_r);
  let unit_rows = rows_of(#toast: &toast, #failed: "Listing the services failed", units_r);
  let perm_rows = rows_of(#toast: &toast, #failed: "Loading the permissions failed", perms_r);
  let svc_servers = rows_of(#toast: &toast, #failed: "Listing the resolver servers failed", svc_servers_r);
  let clusters = rows_of(#toast: &toast, #failed: "Listing the resolver clusters failed", clusters_r);
  // the servers table's clock: "shut for another 29m" is relative to
  // when the rows arrived
  let now = sys::time::now(server_rows);
  // ── the selected row's action key, per panel ──
  let queue_fp = select selected(queue_rows, row_sel) {
    null as _ => null,
    i => i.code
  };
  let deleg_fp = select selected(deleg_rows, row_sel) {
    null as _ => null,
    i => i.code
  };
  // the approver reads the glyph and code against the enrollee's screen
  let verify_lines = |question: string, whose: string, fp: Fingerprint| array::concat(
    [
      line(question),
      line(""),
      line("Verify this glyph and code match the screenshot [whose] sent you, out of band:"),
      line("")
    ],
    identity_lines(fp)
  );
  let roster_sel = selected(roster_rows, row_sel);
  let roster_name = select roster_sel {
    null as _ => null,
    a => select a.kind {
      `Signing => null,
      `Role => a.admin
    }
  };
  let server_sel = selected(server_rows, row_sel);
  let server_id = select server_sel {
    null as _ => null,
    s if s.ca => null,
    s => s.id
  };
  let unit_sel = select service_server {
    null as _ => null,
    s => select selected(unit_rows, row_sel) {
      null as _ => null,
      u => { server: s.id, unit: u.unit }
    }
  };
  let perm_sel = selected(perm_rows, row_sel);
  let cert_serial = select selected(cert_rows, row_sel) {
    null as _ => null,
    c => "[c.serial]"
  };
  // ── action dispatch: each run event starts the op's ceremony ──
  let approve_r = conduct(q, {
    let code = select run { `Approve(code) => code, _ => never() };
    approve(#code: code, code ~ target)
  });
  let deny_r = conduct(q, {
    let code = select run { `Deny(code) => code, _ => never() };
    deny(#code: code, code ~ target)
  });
  let renewals_r = conduct(q, {
    let x = select run { x@ `Renewals => x, _ => never() };
    approve_renewals(x ~ target)
  });
  let apdel_r = conduct(q, {
    let code = select run { `ApproveDelegation(code) => code, _ => never() };
    approve_delegation(#code: code, code ~ target)
  });
  let dendel_r = conduct(q, {
    let code = select run { `DenyDelegation(code) => code, _ => never() };
    deny_delegation(#code: code, code ~ target)
  });
  let revoke_r = conduct(q, {
    let serial = select run { `Revoke(serial) => serial, _ => never() };
    revoke(serial, serial ~ target)
  });
  let resetpw_r = {
    let name = select run { `ResetPassword(name) => name, _ => never() };
    reset_password(name, name ~ target)
  };
  let chpw_r = conduct(q, {
    let x = select run { x@ `ChangeOwnPassword => x, _ => never() };
    change_password(x ~ target)
  });
  let rmadmin_r = {
    let name = select run { `RemoveAdmin(name) => name, _ => never() };
    admins::remove(name, name ~ target)
  };
  let rmserver_r = conduct(q, {
    let id = select run { `RemoveServer(id) => id, _ => never() };
    servers::remove(id, id ~ target)
  });
  let reconcile_r = conduct(q, {
    let x = select run { x@ `Reconcile => x, _ => never() };
    reconcile_ca(x ~ target)
  });
  let svcc_r = conduct(q, {
    let a = select run { `Service(a) => a, _ => never() };
    service_control(#units: [a.unit], #op: a.op, #server: a.server, a ~ target)
  });
  let gate_r = conduct(q, {
    let a = select run { `Gate(a) => a, _ => never() };
    set_read_gate(#server: a.server, a.gate, a ~ target)
  });
  let setperm_r = {
    let e = select run { `SetPerm(e) => e, _ => never() };
    perms::set(#at: (e ~ perms_at)$, #path: e.path, #entity: e.entity, #bits: e.bits, e ~ target)
  };
  let addadmin_r = {
    let a = select run { `AddAdmin(a) => a, _ => never() };
    admins::add(a.name, a.policy, a ~ target)
  };
  let setpolicy_r = {
    let a = select run { `SetPolicy(a) => a, _ => never() };
    admins::set_policy(a.name, a.policy, a ~ target)
  };
  let rmperm_r = {
    let e = select run { `RemovePerm(e) => e, _ => never() };
    perms::remove(#at: (e ~ perms_at)$, #path: e.path, #entity: e.entity, e ~ target)
  };
  // ── action outcomes: toast the summary, then refresh the panel ──
  load <- outcome(#toast: &toast, #failed: "Approve failed", #reload: `Queue, approve_r, |r| note(
    "Approved",
    array::concat(
      ["[r.requested_name] approved", "id-map groups: [str::join(#sep: ", ", r.id_map_groups)]"],
      r.warnings
    )
  ));
  load <- outcome(#toast: &toast, #failed: "Deny failed", #reload: `Queue, deny_r,
    |name| note("Denied", ["Denied [name]"]));
  load <- outcome(#toast: &toast, #failed: "Approving renewals failed", #reload: `Queue, renewals_r,
    |rs| note("Renewals", select array::len(rs) {
      0 => ["No verified renewals were pending"],
      _ => array::map(rs, |r| select r.error {
        null as _ => "renewed [r.requested_name]",
        e => "failed [r.requested_name]: [e]"
      })
    }));
  load <- outcome(#toast: &toast, #failed: "Approving the delegation failed", #reload: `Delegations, apdel_r,
    |r| note("Delegation approved", array::concat(["[r.proposed_path] approved"], peer_lines(r.peers))));
  load <- outcome(#toast: &toast, #failed: "Denying the delegation failed", #reload: `Delegations, dendel_r,
    |r| note("Delegation denied", ["Denied [r.proposed_path]"]));
  load <- outcome(#toast: &toast, #failed: "Revoke failed", #reload: `Certs, revoke_r, |r| note(
    "Revoked",
    array::concat(array::map(r.revoked, |c| "revoked serial [c.serial] ([c.name])"), r.warnings)
  ));
  load <- outcome(#toast: &toast, #failed: "Password reset failed", #reload: `Roster, resetpw_r,
    one_time_password);
  load <- outcome(#toast: &toast, #failed: "Adding the admin failed", #reload: `Roster, addadmin_r,
    one_time_password);
  load <- outcome(#toast: &toast, #failed: "Removing the admin failed", #reload: `Roster, rmadmin_r,
    |_| note("Admin removed", ["The keyslot was removed"]));
  load <- outcome(#toast: &toast, #failed: "Setting the policy failed", #reload: `Roster, setpolicy_r,
    |_| note("Policy updated", ["The admin's policy was replaced."]));
  load <- outcome(#toast: &toast, #failed: "Removing the server failed", #reload: `Servers, rmserver_r,
    |r| note("Server removed", array::concat(["revoked [r.revoked] certificates"], peer_lines(r.peers))));
  load <- outcome(#toast: &toast, #failed: "Reconcile failed", #reload: `Servers, reconcile_r,
    |r| note("Reconciled", peer_lines(r.peers)));
  load <- outcome(#toast: &toast, #failed: "Setting the read gate failed", #reload: `Servers, gate_r,
    |_| note("Read gate set",
      ["The member applies it at its next register; the Servers panel shows what it reports."]));
  load <- outcome(#toast: &toast, #failed: "Recording the permission failed", #reload: `Perms, setperm_r,
    |r| note("Permissions updated", [select r.changed {
      true => "Recorded as version [r.version]. Every member of the cluster converges within a poll interval.",
      false => "Already so — nothing changed (version [r.version])."
    }]));
  load <- outcome(#toast: &toast, #failed: "Removing the permission failed", #reload: `Perms, rmperm_r,
    |r| note("Permissions updated", [select r.changed {
      true => "Removed; recorded as version [r.version].",
      false => "There was no such entry (version [r.version])."
    }]));
  {
    let op = never();
    op <- select run { `Service(a) => a.op, _ => never() };
    load <- outcome(#toast: &toast, #failed: "Service control failed", #reload: `Services, svcc_r,
      |units| note(fmt_service_op(op), array::map(units, |u| "[u.unit]: [fmt_unit_state(u.state)]")))
  };
  {
    catch(e) toast <- failure("Changing the password failed", (e.0).error);
    seq chpw_r {
      chpw_r?;
      toast <- note("Password changed",
        ["The session's credential is gone — connect again with the new password."]);
      on_close(`SessionLost)
    }
  };
  // ── key handling ──
  let panel_last = select screen {
    `Menu => 0,
    `Panel(`Queue) => max(0, opt_len(queue_rows) - 1),
    `Panel(`Delegations) => max(0, opt_len(deleg_rows) - 1),
    `Panel(`Roster) => max(0, opt_len(roster_rows) - 1),
    `Panel(`Servers) => max(0, opt_len(server_rows) - 1),
    `Panel(`Certs) => max(0, opt_len(cert_rows) - 1),
    `Panel(`Services) => max(0, opt_len(unit_rows) - 1),
    `Panel(`Perms) => max(0, opt_len(perm_rows) - 1),
    `ServerPick => 0,
    `ClusterPick => 0
  };
  let pick_last = select screen {
    `ServerPick => max(0, opt_len(svc_servers) - 1),
    `ClusterPick => max(0, opt_len(clusters) - 1),
    _ => 0
  };
  let menu_keys = |k: KeyEvent| select k.code {
    `Up | `Char("k") => { menu_sel <- k ~ max(0, menu_sel - 1); `Stop },
    `Down | `Char("j") => {
      menu_sel <- k ~ min(array::len(menu_entries) - 1, menu_sel + 1);
      `Stop
    },
    kk@ `Enter => {
      let p = kk ~ (menu_entries[menu_sel]$).kind;
      select p {
        `Services => { screen <- p ~ `ServerPick; pick <- p ~ `Servers },
        `Perms => { screen <- p ~ `ClusterPick; pick <- p ~ `Clusters },
        _ => { screen <- `Panel(p); load <- p }
      };
      row_sel <- p ~ 0;
      pick_sel <- p ~ 0;
      `Stop
    },
    kk@ `Esc => { on_close(kk ~ `Back); `Stop },
    _ => `Continue
  };
  let pick_keys = |k: KeyEvent| select k.code {
    `Up | `Char("k") => { pick_sel <- k ~ max(0, pick_sel - 1); `Stop },
    `Down | `Char("j") => { pick_sel <- k ~ min(pick_last, pick_sel + 1); `Stop },
    kk@ `Esc => { screen <- kk ~ `Menu; `Stop },
    kk@ `Enter => {
      select kk ~ (screen, svc_servers, clusters, pick_sel) {
        (`ServerPick, rows, _, i) => select selected(rows, i) {
          null as _ => never(),
          s => {
            service_server <- s;
            screen <- kk ~ `Panel(`Services);
            load <- kk ~ `Services
          }
        },
        (`ClusterPick, _, bases, i) => select selected(bases, i) {
          null as _ => never(),
          at => {
            perms_at <- at;
            screen <- kk ~ `Panel(`Perms);
            load <- kk ~ `Perms
          }
        },
        _ => never()
      };
      row_sel <- kk ~ 0;
      `Stop
    },
    _ => `Continue
  };
  let queue_keys = |k: KeyEvent| select k.code {
    kk@ `Char("a") => {
      let fp = (kk ~ queue_fp)$;
      confirm <- {
        message: verify_lines("Approve this enrollment?", "the enrollee", fp),
        action: `Approve(fp.code)
      };
      `Stop
    },
    kk@ `Char("d") => {
      run <- `Deny(((kk ~ queue_fp)$).code);
      `Stop
    },
    kk@ `Char("R") => { run <- kk ~ `Renewals; `Stop },
    _ => `Continue
  };
  let deleg_keys = |k: KeyEvent| select k.code {
    kk@ `Char("a") => {
      let fp = (kk ~ deleg_fp)$;
      confirm <- {
        message: verify_lines("Approve or reconcile this delegation?", "the child resolver's operator", fp),
        action: `ApproveDelegation(fp.code)
      };
      `Stop
    },
    kk@ `Char("d") => {
      run <- `DenyDelegation(((kk ~ deleg_fp)$).code);
      `Stop
    },
    _ => `Continue
  };
  let roster_keys = |k: KeyEvent| select k.code {
    kk@ `Char("a") => {
      policy_title <- kk ~ "Add a role admin";
      policy_target <- kk ~ `Add;
      policy_fields_in <- kk ~ array::push_front(policy_fields(empty_policy), { label: "name", value: "" });
      policy_open <- kk ~ true;
      `Stop
    },
    kk@ `Char("e") => {
      let a = (kk ~ roster_sel)$;
      select a.kind {
        `Signing => toast <- { title: "Signing slot", lines: ["[a.admin] is a signing slot; its policy is not editable."], error: true },
        `Role => {
          policy_title <- "Edit [a.admin]'s policy";
          policy_target <- `Edit(a.admin);
          policy_fields_in <- policy_fields(a.policy);
          policy_open <- a ~ true
        }
      };
      `Stop
    },
    kk@ `Char("c") => { run <- kk ~ `ChangeOwnPassword; `Stop },
    kk@ `Char("p") => {
      let name = (kk ~ roster_name)$;
      confirm <- {
        message: "Reset [name]'s password? The password they have stops working immediately and every session they hold is closed. You will get a one-time password to give them.",
        action: `ResetPassword(name)
      };
      `Stop
    },
    kk@ `Char("d") => {
      let name = (kk ~ roster_name)$;
      confirm <- {
        message: "Remove admin [name]? Their password will no longer authenticate to this CA.",
        action: `RemoveAdmin(name)
      };
      `Stop
    },
    _ => `Continue
  };
  let server_keys = |k: KeyEvent| select k.code {
    kk@ `Char("c") => { run <- kk ~ `Reconcile; `Stop },
    kk@ `Char("g") => {
      let s = (kk ~ server_sel)$;
      select s.resolver {
        null as _ => toast <- {
          title: "No read gate",
          lines: ["[s.id] runs no resolver, so it has no read gate to set."],
          error: true
        },
        _ => { gate_for <- s; gate_sel <- s ~ 0 }
      };
      `Stop
    },
    kk@ `Char("x") => {
      let id = (kk ~ server_id)$;
      confirm <- {
        message: "Permanently remove server [id]? Its certificates are revoked and the removal is pushed domain-wide.",
        action: `RemoveServer(id)
      };
      `Stop
    },
    _ => `Continue
  };
  let cert_keys = |k: KeyEvent| select k.code {
    kk@ `Char("x") => {
      let serial = (kk ~ cert_serial)$;
      confirm <- {
        message: "Revoke certificate serial [serial]? This is irreversible — the admin domain re-signs its CRL and the holder can no longer authenticate.",
        action: `Revoke(serial)
      };
      `Stop
    },
    _ => `Continue
  };
  let service_act = |kk, op| {
    let u = (kk ~ unit_sel)$;
    run <- `Service({ server: u.server, unit: u.unit, op });
    null
  };
  let services_keys = |k: KeyEvent| select k.code {
    kk@ `Char("s") => { service_act(kk, `Start); `Stop },
    kk@ `Char("t") => { service_act(kk, `Stop); `Stop },
    kk@ `Char("R") => { service_act(kk, `Restart); `Stop },
    _ => `Continue
  };
  let perms_keys = |k: KeyEvent| select k.code {
    kk@ `Char("a") => {
      perm_fields <- kk ~ [
        { label: "path", value: "/" },
        { label: "entity", value: "" },
        { label: "bits", value: "" }
      ];
      perm_open <- kk ~ true;
      `Stop
    },
    kk@ `Char("e") => {
      seq let r = (kk ~ perm_sel)$ {
        perm_fields <- [
          { label: "path", value: r.path },
          { label: "entity", value: r.entity },
          { label: "bits", value: r.bits }
        ];
        perm_open <- true
      };
      `Stop
    },
    kk@ `Char("d") => {
      let r = (kk ~ perm_sel)$;
      confirm <- {
        message: "Remove [r.entity]'s permissions at [r.path]?",
        action: `RemovePerm({ path: r.path, entity: r.entity })
      };
      `Stop
    },
    _ => `Continue
  };
  let panel_keys = |k: KeyEvent, p| select k.code {
    kk@ `Esc => {
      select kk ~ entry {
        `Menu => screen <- kk ~ `Menu,
        _ => on_close(kk ~ `Back)
      };
      `Stop
    },
    kk@ `Char("r") => { load <- kk ~ p; `Stop },
    `Up | `Char("k") => { row_sel <- k ~ max(0, row_sel - 1); `Stop },
    `Down | `Char("j") => {
      row_sel <- k ~ min(panel_last, row_sel + 1);
      `Stop
    },
    _ => select p {
      `Queue => queue_keys(k),
      `Delegations => deleg_keys(k),
      `Roster => roster_keys(k),
      `Servers => server_keys(k),
      `Certs => cert_keys(k),
      `Services => services_keys(k),
      `Perms => perms_keys(k)
    }
  };
  let handle = |e: Event| on_press(e, |k| select k ~ screen {
    `Menu => menu_keys(k),
    `Panel(p) => panel_keys(k, p),
    `ServerPick => pick_keys(k),
    `ClusterPick => pick_keys(k)
  });
  // ── the read-gate chooser and the permission form ──
  let gate_handle = |e: Event| {
    on_press(e, |k| select k.code {
      `Up | `Char("k") => { gate_sel <- k ~ max(0, gate_sel - 1); `Stop },
      `Down | `Char("j") => {
        gate_sel <- k ~ min(array::len(gate_choices) - 1, gate_sel + 1);
        `Stop
      },
      kk@ `Enter => {
        let g = kk ~ (gate_choices[gate_sel]$).gate;
        let at = kk ~ now;
        select kk ~ gate_for {
          null as _ => never(),
          s => select gate_warning(s, g, at) {
            null as _ => run <- `Gate({ server: s.id, gate: g }),
            w => confirm <- { message: w, action: `Gate({ server: s.id, gate: g }) }
          }
        };
        gate_for <- kk ~ null;
        `Stop
      },
      kk@ `Esc => { gate_for <- kk ~ null; `Stop },
      _ => `Stop
    });
    e ~ `Stop
  };
  let gate_widget = select gate_for {
    null as _ => paragraph(&""),
    s => {
      let items = array::map(gate_choices, |c| line(c.label));
      let detail = [
        line(#style: hint, "server: [s.id] at [s.addr]"),
        line(#style: hint, "now: [gate_detail(s.read_gate)]")
      ];
      block(
        #border: &`All,
        #title: &line("Read gate"),
        #title_bottom: &line(#style: hint, " ↑/↓ move · Enter choose · Esc back "),
        &layout(#direction: &`Vertical, &[
          child(#constraint: `Length(2), paragraph(#trim: &false, &detail)),
          child(#constraint: `Min(1),
            list(#highlight_style: &selstyle, #selected: &gate_sel, &items))
        ])
      )
    }
  };
  let layers = {
    let gl = select gate_for {
      null as _ => [],
      _ => [layer(#width: &`Percentage(60), #height: &`Percentage(50),
        input_handler(#handle: &gate_handle, &gate_widget))]
    };
    let pl = select perm_open {
      false => [],
      true => [layer(#width: &`Percentage(60), #height: &`Percentage(40),
        input_handler(#handle: &perm_form.handle, &perm_form.view))]
    };
    let yl = select policy_open {
      false => [],
      true => [layer(#width: &`Percentage(70), #height: &`Percentage(70),
        input_handler(#handle: &policy_form.handle, &policy_form.view))]
    };
    let cl = confirm_layers(#on_confirm: |a| { run <- a; null }, &confirm);
    let tl = toast_layers(&toast);
    array::concat(gl, pl, yl, cl, tl)
  };
  // ── views ──
  let menu_view = {
    let items = array::map(menu_entries, |p| line(p.title));
    let desc = [line(#style: hint, (menu_entries[menu_sel]$).desc)];
    let title = select info(target) {
      `Remote({ server, admin, identity }) => "[identity.domain] — [server] as [admin]",
      `Local({ cfg_path }) => "this host — [cfg_path]"
    };
    block(
      #border: &`All,
      #title: &line(title),
      #title_bottom: &menu_legend,
      &layout(#direction: &`Vertical, &[
        child(#constraint: `Length(array::len(menu_entries)),
          list(#highlight_style: &selstyle, #selected: &menu_sel, &items)),
        child(#constraint: `Min(1), paragraph(#trim: &false, &desc))
      ])
    )
  };
  let queue_trs = select queue_rows {
    null as _ => [],
    rows => array::map(rows, |i| {
      let name = select i.enroll_listen {
        null as _ => i.requested_name,
        l => "admin-server enrollment @ [l]"
      };
      let mark = select i.verified_renewal {
        true => "renewal ",
        false => ""
      };
      let code_s = select i.code {
        null as _ => "unparseable — deny only",
        c => c.short
      };
      &row([
        cell(line("[mark][name]")),
        cell(line(i.kind)),
        cell(line(code_s)),
        cell(line(fmt_age(i.age_secs))),
        cell(line(i.peer))
      ])
    })
  };
  let queue_view = table(
    #header: &row(#style: bold, [
      cell(line("Name")), cell(line("Kind")), cell(line("Code")),
      cell(line("Age")), cell(line("From"))
    ]),
    #row_highlight_style: &selstyle,
    #selected: &row_sel,
    #widths: &[`Percentage(40), `Length(10), `Length(24), `Length(8), `Percentage(25)],
    &queue_trs
  );
  let deleg_trs = select deleg_rows {
    null as _ => [],
    rows => array::map(rows, |i| {
      let state = select i.approved {
        true => "approved — a reconciles",
        false => "pending"
      };
      &row([
        cell(line(i.proposed_path)),
        cell(line(state)),
        cell(line((i.code).short)),
        cell(line(fmt_age(i.age_secs))),
        cell(line(i.peer))
      ])
    })
  };
  let deleg_view = table(
    #header: &row(#style: bold, [
      cell(line("Path")), cell(line("State")), cell(line("Code")),
      cell(line("Age")), cell(line("From"))
    ]),
    #row_highlight_style: &selstyle,
    #selected: &row_sel,
    #widths: &[`Percentage(35), `Length(24), `Length(24), `Length(8), `Percentage(20)],
    &deleg_trs
  );
  let roster_trs = select roster_rows {
    null as _ => [],
    rows => array::map(rows, |a| {
      let chg = select a.must_change {
        true => "must change password",
        false => ""
      };
      &row([
        cell(line(a.admin)),
        cell(line(fmt_slot(a.kind))),
        cell(line(a.slot_id)),
        cell(line(chg))
      ])
    })
  };
  let roster_detail = select roster_sel {
    null as _ => [],
    a => {
      let p = a.policy;
      let san = str::join(#sep: ", ", p.allowed_san);
      let groups = str::join(#sep: ", ", p.id_map_groups);
      let enroll = str::join(#sep: ", ", p.server_enroll_scopes);
      let perms = str::join(#sep: ", ", p.perms_edit_scopes);
      let manage = select p.may_manage_admins {
        true => "yes",
        false => "no"
      };
      [
        line(#style: hint, "allowed SAN: [san]"),
        line(#style: hint, "id-map groups: [groups]"),
        line(#style: hint, "server enroll scopes: [enroll]"),
        line(#style: hint, "perms edit scopes: [perms]"),
        line(#style: hint, "may manage admins: [manage] · max validity [dur_text(p.max_validity)]")
      ]
    }
  };
  let roster_view = layout(#direction: &`Vertical, &[
    child(#constraint: `Min(3), table(
      #header: &row(#style: bold, [
        cell(line("Admin")), cell(line("Kind")), cell(line("Slot")),
        cell(line(""))
      ]),
      #row_highlight_style: &selstyle,
      #selected: &row_sel,
      #widths: &[`Percentage(30), `Length(8), `Percentage(30), `Length(20)],
      &roster_trs
    )),
    child(#constraint: `Length(5), paragraph(#trim: &false, &roster_detail))
  ]);
  let server_trs = select server_rows {
    null as _ => [],
    rows => array::map(rows, |s| {
      let cluster = select s.cluster_base {
        null as _ => "(none)",
        c => c
      };
      let roles = str::join(#sep: ", ", s.roles);
      let tag = select s.ca {
        true => "[s.state], CA",
        false => s.state
      };
      &row([
        cell(line(cluster)),
        cell(line(s.id)),
        cell(line(s.addr)),
        cell(line(roles)),
        cell(line(tag)),
        cell(line(gate_label(s.read_gate, now)))
      ])
    })
  };
  let server_detail = select server_sel {
    null as _ => [],
    s => [line(#style: hint, "read gate: [gate_detail(s.read_gate)]")]
  };
  let servers_view = layout(#direction: &`Vertical, &[
    child(#constraint: `Min(3), table(
      #header: &row(#style: bold, [
        cell(line("Cluster")), cell(line("Id")), cell(line("Address")),
        cell(line("Roles")), cell(line("State")), cell(line("Gate"))
      ]),
      #row_highlight_style: &selstyle,
      #selected: &row_sel,
      #widths: &[`Percentage(18), `Percentage(24), `Length(22), `Length(18), `Percentage(12), `Length(14)],
      &server_trs
    )),
    child(#constraint: `Length(1), text(&server_detail))
  ]);
  let cert_trs = select cert_rows {
    null as _ => [],
    rows => array::map(rows, |c| {
      let state = select c.revoked {
        true => "revoked",
        false => ""
      };
      let expiry = "[cast<datetime>(c.not_after_unix)$]";
      &row([
        cell(line("[c.serial]")),
        cell(line(c.name)),
        cell(line(expiry)),
        cell(line(state))
      ])
    })
  };
  let certs_view = table(
    #header: &row(#style: bold, [
      cell(line("Serial")), cell(line("Name")), cell(line("Expires")),
      cell(line(""))
    ]),
    #row_highlight_style: &selstyle,
    #selected: &row_sel,
    #widths: &[`Length(10), `Percentage(40), `Length(22), `Length(10)],
    &cert_trs
  );
  let unit_trs = select unit_rows {
    null as _ => [],
    rows => array::map(rows, |u| {
      let (exe, trigger, restart) = select u.definition {
        null as _ => ("(no definition on disk)", "", ""),
        d => (str::join(#sep: " ", array::push_front(d.args, d.exe)), d.trigger, d.restart)
      };
      &row([
        cell(line(u.unit)),
        cell(line(fmt_unit_state(u.state))),
        cell(line(exe)),
        cell(line(trigger)),
        cell(line(restart))
      ])
    })
  };
  let services_view = {
    let header = select service_server {
      null as _ => [],
      s => [line(#style: bold, "Services @ [s.addr] ([s.id]) · [s.base]")]
    };
    layout(#direction: &`Vertical, &[
      child(#constraint: `Length(1), text(&header)),
      child(#constraint: `Min(3), table(
        #header: &row(#style: bold, [
          cell(line("Unit")), cell(line("State")), cell(line("Command")),
          cell(line("Trigger")), cell(line("Restart"))
        ]),
        #row_highlight_style: &selstyle,
        #selected: &row_sel,
        #widths: &[`Percentage(20), `Length(20), `Percentage(40), `Length(12), `Length(10)],
        &unit_trs
      ))
    ])
  };
  let perm_trs = select perm_rows {
    null as _ => [],
    rows => array::map(rows, |e| {
      let entity = select e.entity {
        "" => "(anonymous)",
        n => n
      };
      &row([cell(line(e.path)), cell(line(entity)), cell(line(e.bits))])
    })
  };
  let perms_view = {
    let header = select perms_at {
      null as _ => [],
      at => [line(#style: bold, "Permissions of the cluster at [at]")]
    };
    let body = select perm_rows {
      null as _ => [],
      [] => [line(#style: hint, "(no permissions set)")],
      _ => []
    };
    layout(#direction: &`Vertical, &[
      child(#constraint: `Length(1), text(&header)),
      child(#constraint: `Length(1), text(&body)),
      child(#constraint: `Min(3), table(
        #header: &row(#style: bold, [
          cell(line("Path")), cell(line("Entity")), cell(line("Bits"))
        ]),
        #row_highlight_style: &selstyle,
        #selected: &row_sel,
        #widths: &[`Percentage(50), `Percentage(35), `Length(10)],
        &perm_trs
      ))
    ])
  };
  let server_pick_view = {
    let items = select svc_servers {
      null as _ => [line(#style: hint, "listing the admin domain's resolver servers…")],
      [] => [line(#style: hint, "no registered admin server runs a resolver")],
      rows => array::map(rows, |s| line("[s.addr]  [s.id]  [s.base]"))
    };
    block(
      #border: &`All,
      #title: &line("Pick an admin server"),
      #title_bottom: &pick_legend,
      &list(#highlight_style: &selstyle, #selected: &pick_sel, &items)
    )
  };
  let cluster_pick_view = {
    let items = select clusters {
      null as _ => [line(#style: hint, "listing the admin domain's resolver clusters…")],
      [] => [line(#style: hint, "no active resolver cluster")],
      bases => array::map(bases, |b| line(b))
    };
    block(
      #border: &`All,
      #title: &line("Pick a resolver cluster"),
      #title_bottom: &pick_legend,
      &list(#highlight_style: &selstyle, #selected: &pick_sel, &items)
    )
  };
  let panel_view = |p, w| {
    let m = menu_entries[0]$;
    let entry = select array::find(menu_entries, |e| e.kind == p) {
      null as _ => m,
      e => e
    };
    block(#border: &`All, #title: &line(entry.title), &w)
  };
  let body = select screen {
    `Menu => menu_view,
    `Panel(`Queue) => panel_view(`Queue, queue_view),
    `Panel(`Delegations) => panel_view(`Delegations, deleg_view),
    `Panel(`Roster) => panel_view(`Roster, roster_view),
    `Panel(`Servers) => panel_view(`Servers, servers_view),
    `Panel(`Certs) => panel_view(`Certs, certs_view),
    `Panel(`Services) => panel_view(`Services, services_view),
    `Panel(`Perms) => panel_view(`Perms, perms_view),
    `ServerPick => server_pick_view,
    `ClusterPick => cluster_pick_view
  };
  let status = select screen {
    `Menu => menu_legend,
    `ServerPick | `ClusterPick => pick_legend,
    `Panel(p) => {
      let m = menu_entries[0]$;
      let entry = select array::find(menu_entries, |e| e.kind == p) {
        null as _ => m,
        e => e
      };
      line(#style: hint, entry.keys)
    }
  };
  {
    view: body,
    handle,
    status,
    layers
  }
}
