use package::{
  AdminError, Fingerprint, Target, info,
  admins::{self, Policy, SlotKind, change_password, reset_password},
  certs::{approve, approve_renewals, deny, issued, list_queue, revoke},
  perms::{self, list_resolver_clusters},
  servers::{
    self, PeerResult, ReadGate, ServerInfo, ServiceServer, approve_delegation,
    deny_delegation, list_pending_delegations, list_service_servers, reconcile_ca,
    service_control, set_read_gate
  },
  units::{ServiceOp, UnitState}
};
use super::{
  Confirm, Toast, admin_text, conduct, confirm_layers, hint, identity_lines, opt_len,
  selected, selstyle, toast_layers
};
use tui::{
  line, style,
  block::block,
  form::form,
  input_handler::{Event, KeyEvent, input_handler, on_press},
  layout::{child, layout},
  list::list,
  overlay::layer,
  paragraph::paragraph,
  table::{cell, row, table},
  text::text
};

type Screen = [`Menu, `Panel(PanelKind), `ServerPick, `ClusterPick];

type GateReq = [ReadGate, `ShutFor(duration)];

type Act = [
  `Approve(string),
  `Deny(string),
  `Renewals,
  `ApproveDelegation(string),
  `DenyDelegation(string),
  `Revoke(string),
  `ResetPassword(string),
  `ChangeOwnPassword,
  `RemoveAdmin(string),
  `RemoveServer(string),
  `Reconcile,
  `Service({ server: string, unit: string, op: ServiceOp }),
  `Gate({ server: string, gate: GateReq }),
  `SetPerm({ path: string, entity: string, bits: string }),
  `RemovePerm({ path: string, entity: string }),
  `AddAdmin({ name: string, policy: Policy }),
  `SetPolicy({ name: string, policy: Policy })
];

type MenuEntry = { kind: PanelKind, title: string, desc: string, keys: string };

