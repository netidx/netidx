use package::AdminError;
use package::discovery::{discover_domains, identity_at, local_domain};
use super::{admin_text, fingerprint_lines, glyph};
use tui::{line, span, style};
use tui::block::{self, *};
use tui::input_handler::{self, *};
use tui::layout::{self, *};
use tui::list::{self, *};
use tui::paragraph::{self, *};
use tui::text::{self, *};

// record a domain under its fingerprint: a new address joins the
// saved ones, a changed name replaces the saved one
let upsert = |book: Book, domain: string, addr: string, fp: string| -> Book
  select array::find(book.domains, |k| k.fingerprint == fp) {
    null as _ => { domains: array::push(book.domains, { domain, fingerprint: fp, addrs: [addr] }) },
    _ => {
      domains: array::map(book.domains, |k| select k.fingerprint == fp {
        true => {
          domain,
          fingerprint: fp,
          addrs: select array::find(k.addrs, |a| a == addr) {
            null as _ => array::push(k.addrs, addr),
            _ => k.addrs
          }
        },
        false => k
      })
    }
  };

// the saved admin domains: loaded once (the bookmarks file under `dir`,
// then this host's own domain from its install record), and after that
// whatever `edit` last said, which is also what the file gets. Absent
// until the load is done, so an edit computed from it waits for the load
let saved_domains = |#notice: &[string, null], dir: [string, null], edit: Book| -> Book {
  let path = sys::join_path(dir$, "admin-domains.json");
  let known: Book = seq {
    let blank: Book = { domains: [] };
    let book = select dir {
      null as _ => blank,
      _ => select sys::fs::is_file(path) {
        error as _ => blank,
        file => seq {
          try {
            let loaded: Book = json::read(sys::fs::read_all(file)?)?;
            loaded
          } with(e) {
            *notice <- "could not load the admin domain list: [(e.0).error]";
            blank
          }
        }
      }
    };
    select local_domain(true) {
      null as _ => book,
      own => select own.addr {
        null as _ => book,
        addr => upsert(book, own.domain, addr, own.fingerprint)
      }
    }
  };
  known <- edit;
  {
    catch(e) *notice <- "could not save the admin domain list: [(e.0).error]";
    seqq let (dir, edit) = (dir$, edit) {
      sys::fs::create_dir(#all: true, dir)?;
      sys::fs::write_all(#path: path, json::write_str(#pretty: true, edit)?)?
    }
  };
  known
};

let landing = |
  #q: &Question,
  #book_dir: [string, null],
  #connected: &[Connected, null],
  #on_connect: fn(c: Connect) -> null,
  #on_manual: fn(e: Any) -> null
| -> Landing {
  let hint = style(#fg: `DarkGray);
  let selstyle = style(#add_modifier: [`Reversed]);
  let bold = style(#add_modifier: [`Bold]);
  // ── the bookmarks ──
  let notice: [string, null] = null;
  let edit = never();
  let known = saved_domains(#notice: &notice, book_dir, edit);
  // ── verification: each saved domain, at each address, in order —
  // at load, after every change to the set, and on demand ──
  let verify: Any = known;
  let polling = true;
  let visible = [];
  seqq sys::time::after_idle(duration:250.ms, verify) {
    polling <- true;
    visible <- array::filter_map(known.domains, |k| {
      let verified = array::filter_map(k.addrs, |a| select identity_at(a) {
        error as _ => null,
        id if id.fingerprint.code == k.fingerprint => a,
        _ => null
      });
      select verified {
        [] => null,
        [addr, ..] => { known: k, addr }
      }
    });
    polling <- false
  };
  // ── a session the tab established is remembered, and re-checked ──
  seq let session = (*connected)$ {
    edit <- upsert(known, session.domain, session.server, session.fingerprint)
  };
  // ── discovery: what verified is recorded ──
  let discover_at = never();
  let toast: [{ title: string, lines: Array<string> }, null] = null;
  {
    catch(e) toast <- { title: "Discovery failed", lines: [admin_text((e.0).error)] };
    seq discover_at {
      let found = discover_domains(discover_at)?;
      let verified = array::filter_map(found.domains, |r| select r.identity {
        null as _ => null,
        id => { domain: r.domain, servers: r.servers, fp: id.fingerprint.code }
      });
      edit <- array::fold(verified, known, |acc, v| array::fold(
        v.servers,
        acc,
        |b, s| upsert(b, v.domain, s, v.fp)
      ));
      toast <- select array::len(found.diagnosis) {
        0 => select array::len(verified) {
          0 => { title: "Discovery", lines: ["No admin domain answered on the local network."] },
          n => { title: "Discovery", lines: ["Found [n] admin domain(s); they are saved."] }
        },
        _ => { title: "Discovery", lines: found.diagnosis }
      }
    }
  };
  // ── keys ──
  let sel = 0;
  let handle = |e: Event| on_press(e, |k| select k.code {
    `Up | `Char("k") => { sel <- k ~ max(0, sel - 1); `Stop },
    `Down | `Char("j") => {
      sel <- k ~ min(max(0, array::len(visible) - 1), sel + 1);
      `Stop
    },
    kk@ `Char("d") => { discover_at <- kk; `Stop },
    kk@ `Char("c") => { on_manual(kk); `Stop },
    kk@ `Char("r") => { verify <- kk; `Stop },
    kk@ `Enter => {
      select kk ~ (toast, visible, sel) {
        (null, [], _) => never(),
        (null, rows, i) => {
          let row = rows[min(i, array::len(rows) - 1)]$;
          on_connect({
            server: row.addr,
            glyph: package::parse_fingerprint(row.known.fingerprint)$
          })
        },
        _ => toast <- null
      };
      `Stop
    },
    kk@ `Esc => { toast <- kk ~ null; `Stop },
    _ => `Continue
  });
  // ── the view ──
  let empty = select (array::len(known.domains), polling, array::len(visible)) {
    (0, _, _) => [line(#style: hint,
      "No saved admin domains yet. Press d to discover admin domains on the local network, or c to connect to one by address.")],
    (_, true, 0) => [line(#style: hint, "Checking saved admin domains…")],
    (_, false, 0) => [line(#style: hint,
      "No saved admin domain is reachable here right now (an admin domain only shows once its identity has been re-verified at a saved address). Press r to re-check.")],
    _ => []
  };
  let items = array::map(visible, |v| line(array::concat(
    [span("[v.known.domain] ")],
    [span(#style: hint, "([v.addr])")]
  )));
  let side = select visible {
    [] => [],
    rows => {
      let row = rows[min(sel, array::len(rows) - 1)]$;
      let parsed = package::parse_fingerprint(row.known.fingerprint);
      select is_err(parsed) {
        true => [line(#style: hint, "saved fingerprint does not parse")],
        false => {
          let fp = parsed$;
          array::concat([line(#style: hint, "CA glyph")], glyph(fp), fingerprint_lines(fp))
        }
      }
    }
  };
  let notice_lines = select notice {
    null as _ => [],
    m => [line(#style: style(#fg: `Red), m)]
  };
  let toast_lines = select toast {
    null as _ => [],
    t => array::concat([line(#style: bold, t.title)], array::map(t.lines, |l| line(l)))
  };
  let view = block(
    #border: &`All,
    #title: &line("Admin Domains"),
    #title_bottom: &line(#style: hint, " Enter connect · d discover · c connect direct · r refresh "),
    &layout(#direction: &`Horizontal, &[
      child(#constraint: `Min(30), layout(#direction: &`Vertical, &[
        child(#constraint: `Length(array::len(empty)), paragraph(#trim: &false, &empty)),
        child(#constraint: `Min(1), list(#highlight_style: &selstyle, #selected: &sel, &items)),
        child(#constraint: `Length(array::len(toast_lines)), paragraph(#trim: &false, &toast_lines)),
        child(#constraint: `Length(array::len(notice_lines)), text(&notice_lines))
      ])),
      child(#constraint: `Length(28), paragraph(#alignment: &`Center, #trim: &false, &side))
    ])
  );
  {
    view,
    handle,
    status: line(#style: hint, " Enter connect · d discover · c connect direct · r refresh ")
  }
}
