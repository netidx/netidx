use package::{
  Fingerprint, Target, change_password_at, connect, info,
  ceremony::{questions, result}
};
use super::{Toast, admin_text, hint, panels, toast_layers, landing::{self, Connected}};
use tui::{
  line, line_edit, style,
  block::block,
  input_handler::{Event, KeyEvent, on_press},
  layout::{child, layout},
  paragraph::paragraph,
  text::text
};

type Screen = [`Landing, `Connect, `Panels];

let remote = |#q: &Question, #book_dir: [string, null], #server: string = ""| -> Remote {
  // ── connection state ──
  let target = never<Target>();
  let screen: Screen = select server {
    "" => `Landing,
    _ => `Connect
  };
  let ed = line_edit::state(server);
  // a connect request. A domain the landing screen verified against its
  // saved fingerprint brings that glyph and connects without the gesture
  let connect_req = never<{ server: string, glyph: [Fingerprint, null] }>();
  let conn_err: [string, null] = null;
  conn_err <- connect_req ~ null;
  let connect_c = connect(#glyph: connect_req.glyph, connect_req.server);
  *q <- questions(connect_c);
  // ── the landing screen: known admin domains ──
  let connected: [Connected, null] = null;
  let land = landing::landing(
    #book_dir: book_dir,
    #connected: &connected,
    #on_connect: |c| {
      connect_req <- { server: c.server, glyph: c.glyph };
      ed <- { value: c.server, cursor: str::len(c.server) };
      screen <- c ~ `Connect;
      null
    },
    #on_manual: |e| { screen <- e ~ `Connect; null }
  );
  // the CA fingerprint the operator confirmed during this connect, so
  // a follow-on ceremony against the same server skips the gesture
  let glyph: [Fingerprint, null] = null;
  glyph <- connect_req ~ null;
  glyph <- select questions(connect_c) {
    `ConfirmIdentity({ identity, .. }) => identity.fingerprint,
    _ => never()
  };
  // a reset password authorizes nothing but its own replacement: the
  // CA refuses the session and names the admin, and that routes here
  let must_change = never<string>();
  let connect_r = result(connect_c);
  {
    catch(e) select (e.0).error {
      `PasswordChangeRequired(name) => must_change <- name,
      other => conn_err <- admin_text(other)
    };
    seq connect_r {
      let t = connect_r?;
      target <- t;
      screen <- `Panels;
      connected <- select info(t) {
        `Remote({ server, identity, .. }) =>
          { domain: identity.domain, server, fingerprint: identity.fingerprint.code },
        `Local(_) => null
      }
    }
  };
  let toast: [Toast, null] = null;
  let chpw_at_c = change_password_at(
    #admin: must_change,
    #glyph: must_change ~ glyph,
    (must_change ~ connect_req).server
  );
  *q <- questions(chpw_at_c);
  let chpw_r = result(chpw_at_c);
  {
    catch(e) conn_err <- admin_text((e.0).error);
    seq chpw_r {
      chpw_r?;
      toast <- {
        title: "Password changed",
        lines: ["Connect again with the new password."],
        error: false
      }
    }
  };
  let connect_keys = |ev, k: KeyEvent| select k.code {
    kk@ `Enter => {
      select kk ~ ed.value {
        "" => never(),
        v => connect_req <- { server: v, glyph: null }
      };
      `Stop
    },
    kk@ `Esc => { screen <- kk ~ `Landing; `Stop },
    _ => line_edit::handle(&ed, ev)
  };
  let pan = panels::panels(
    #q: q,
    #entry: `Menu,
    #on_close: |why| {
      screen <- select why {
        `Back => `Landing,
        `SessionLost => `Connect
      };
      null
    },
    target
  );
  let handle = |e: Event| on_press(e, |k| select k ~ screen {
    `Landing => land.handle(e),
    `Connect => connect_keys(e, k),
    `Panels => pan.handle(e)
  });
  let conn_err_lines = select conn_err {
    null as _ => [],
    m => [line(#style: style(#fg: `Red), m)]
  };
  let connect_view = block(
    #border: &`All,
    #title: &line("Connect to an admin domain"),
    #title_bottom: &line(#style: hint, " Enter connect · Esc back "),
    &layout(#direction: &`Vertical, &[
      child(#constraint: `Length(2),
        paragraph(#style: &hint, &"Enter the admin server's address (host:port).")),
      child(#constraint: `Length(1), text(&[line_edit::view(&ed)])),
      child(#constraint: `Length(1), text(&conn_err_lines))
    ])
  );
  let body = select screen {
    `Landing => land.view,
    `Connect => connect_view,
    `Panels => pan.view
  };
  let status = select screen {
    `Landing => land.status,
    `Connect => line(#style: hint, " type an address · Enter connect · Esc back "),
    `Panels => pan.status
  };
  {
    view: body,
    handle,
    status,
    layers: array::concat(pan.layers, toast_layers(&toast))
  }
}
