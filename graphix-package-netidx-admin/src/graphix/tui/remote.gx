use package::{
  AdminError, AdminInfo, Fingerprint, IssuedEntry, PendingDelegation, PermEntry,
  QueueItem, ReadGate, RecordedEdit, ServerInfo, ServiceOp, ServiceServer, ServiceUnit,
  SlotKind, Target, UnitState, approve, approve_delegation, approve_renewals,
  change_password, change_password_at, connect, deny, deny_delegation, info,
  issued, list_admins, list_pending_delegations, list_queue,
  list_resolver_clusters, list_servers, list_service_servers, questions,
  reconcile_ca, remove_admin, remove_perm, remove_server, reset_password,
  result, revoke, service_control, set_perm, set_read_gate, show_perms
};
use tui::{line, style};
use tui::block::{self, *};
use tui::input_handler::{self, *};
use tui::layout::{self, *};
use tui::line_edit::{self, *};
use tui::list::{self, *};
use tui::overlay::{self, layer, Layer};
use tui::paragraph::{self, *};
use tui::table::{self, *};
use tui::text::{self, *};

type PanelKind = [`Queue, `Delegations, `Roster, `Servers, `Certs, `Services, `Perms];

type Screen = [`Connect, `Menu, `Panel(PanelKind), `ServerPick, `ClusterPick];

type GateReq = [ReadGate, `ShutFor(duration)];

type Act = [
  `Approve(string),
  `Deny(string),
  `Renewals,
  `ApproveDelegation(string),
  `DenyDelegation(string),
  `Revoke(string),
  `ResetPassword(string),
  `ChangeOwnPassword,
  `RemoveAdmin(string),
  `RemoveServer(string),
  `Reconcile,
  `Service({ server: string, unit: string, op: ServiceOp }),
  `Gate({ server: string, gate: GateReq }),
  `SetPerm({ path: string, entity: string, bits: string }),
  `RemovePerm({ path: string, entity: string })
];

type MenuEntry = { kind: PanelKind, title: string, desc: string, keys: string };

type Toast = { title: string, lines: Array<string>, error: bool };

let panels: Array<MenuEntry> = [
  {
    kind: `Queue,
    title: "Enrollment Queue",
    desc: "Review and approve certificate-enrollment requests from nodes joining the admin domain.",
    keys: " a approve · d deny · R renewals · r refresh · Esc back "
  },
  {
    kind: `Delegations,
    title: "Delegation Requests",
    desc: "Review and approve requests from resolvers asking to attach under this resolver cluster.",
    keys: " a approve · d deny · r refresh · Esc back "
  },
  {
    kind: `Roster,
    title: "Admin Roster",
    desc: "The admin domain's admins and their scopes.",
    keys: " c change my password · p reset-password · d remove · r refresh · Esc back "
  },
  {
    kind: `Servers,
    title: "Admin Servers",
    desc: "Every CA-authoritative server identity — reconcile CA state, or permanently remove a dead node.",
    keys: " g read gate · c reconcile CA · x remove · r refresh · Esc back "
  },
  {
    kind: `Certs,
    title: "Issued Certificates",
    desc: "Certificates this CA has issued — revoke one to bar the holder from the admin domain.",
    keys: " x revoke · r refresh · Esc back "
  },
  {
    kind: `Services,
    title: "Services",
    desc: "Start, stop, or restart the activation units of one admin server's resolver.",
    keys: " s start · t stop · R restart · r refresh · Esc back "
  },
  {
    kind: `Perms,
    title: "Permissions",
    desc: "View and edit the permissions of a resolver cluster's namespace.",
    keys: " a add · e edit · d remove · r refresh · Esc back "
  }
];

let gate_choices: Array<{ label: string, gate: GateReq }> = [
  { label: "Open — answer read clients", gate: `Open },
  { label: "Shut — until someone opens the gate again", gate: `Shut },
  { label: "Shut for 5 minutes", gate: `ShutFor(duration:300.s) },
  { label: "Shut for 30 minutes", gate: `ShutFor(duration:1800.s) },
  { label: "Shut for 2 hours", gate: `ShutFor(duration:7200.s) },
  { label: "Shut for 8 hours", gate: `ShutFor(duration:28800.s) }
];

let admin_text = |a: AdminError| -> string select a {
  `Admin(m) => m,
  `PasswordChangeRequired(name) =>
    "[name]'s password was reset and must be changed before anything else",
  `Unsupported(m) => "unsupported on this platform: [m]"
};

let fmt_age = |secs: u64| -> string select secs {
  s if s < u64:60 => "[s]s",
  s if s < u64:3600 => "[s / u64:60]m",
  s => "[s / u64:3600]h[(s % u64:3600) / u64:60]m"
};

let fmt_slot = |k: SlotKind| -> string select k {
  `Signing => "signing",
  `Role => "role"
};

let fmt_dur = |d: duration| -> string fmt_age(cast<u64>(d)$);

let gate_label = |g: [ReadGate, null], now: datetime| -> string select g {
  null as _ => "-",
  `Open => "open",
  `Shut => "shut",
  `Until(t) if t > now => "shut [fmt_dur(sys::time::diff(t, now))]",
  `Until(_) => "open (expired)"
};

let gate_detail = |g: [ReadGate, null]| -> string select g {
  null as _ => "no resolver, so no read gate",
  `Open => "open — answering read clients",
  `Shut => "shut — refusing read clients until opened",
  `Until(t) => "shut — refusing read clients until [t]"
};

// what a gate change risks, or null when it changes nothing worth a stop
let gate_warning = |s: ServerInfo, gate: GateReq, now: datetime| -> [string, null] {
  let who = "[s.id] at [s.addr]";
  select (gate, s.read_gate) {
    (`Open, `Until(t)) if t > now =>
      "Start [who] answering read clients [fmt_dur(sys::time::diff(t, now))] early?\n\nIt is waiting for publishers to find it. Anything that has not been republished yet will look absent to subscribers resolving through it.",
    (`Open, `Shut) =>
      "Start [who] answering read clients?\n\nIt will answer from whatever it holds now. If it was taken out of service, that may be a stale picture of the namespace.",
    (`Open, _) => null,
    (`Shut, _) =>
      "Stop [who] answering read clients?\n\nSubscribers stop resolving through it until someone opens the gate again. Publishers keep writing to it, so its records stay fresh — it just stops answering.",
    (`ShutFor(d), _) =>
      "Stop [who] answering read clients for [fmt_dur(d)]?\n\nSubscribers stop resolving through it until then. Publishers keep writing to it, so its records stay fresh — it just stops answering.",
    (`Until(t), _) =>
      "Stop [who] answering read clients until [t]?\n\nSubscribers stop resolving through it until then. Publishers keep writing to it, so its records stay fresh — it just stops answering."
  }
};

let fmt_unit_state = |st: UnitState| -> string select st {
  `NotStarted => "not started",
  `Running(null) => "running",
  `Running(pid) => "running (pid [pid])",
  `Stopped => "stopped",
  `Died => "died"
};

let fmt_service_op = |op: ServiceOp| -> string select op {
  `Start => "Started",
  `Stop => "Stopped",
  `Restart => "Restarted",
  `Status => "Listed"
};

let opt_len = |o: [Array<'a>, null]| -> i64 select o {
  null as _ => 0,
  a => array::len(a)
};

let remote = |#q: &Question, #server: string = ""| -> Remote {
  let hint = style(#fg: `DarkGray);
  let selstyle = style(#add_modifier: [`Reversed]);
  let bold = style(#add_modifier: [`Bold]);
  // ── connection state ──
  let target: Target = never();
  let screen: Screen = `Connect;
  let ed = line_edit::state(server);
  let connect_to: string = never();
  let conn_err: [string, null] = null;
  conn_err <- connect_to ~ null;
  let connect_c = connect(connect_to);
  *q <- questions(connect_c);
  // the CA fingerprint the operator confirmed during this connect, so
  // a follow-on ceremony against the same server skips the gesture
  let glyph: [Fingerprint, null] = null;
  glyph <- connect_to ~ null;
  glyph <- select questions(connect_c) {
    `ConfirmIdentity({ identity, .. }) => identity.fingerprint,
    _ => never()
  };
  // a reset password authorizes nothing but its own replacement: the
  // CA refuses the session and names the admin, and that routes here
  let must_change: string = never();
  {
    catch(e) select (e.0).error {
      `PasswordChangeRequired(name) => must_change <- name,
      other => conn_err <- admin_text(other)
    };
    let t = result(connect_c)?;
    target <- t;
    screen <- t ~ `Menu
  };
  // ── shared ui state ──
  let menu_sel = 0;
  let row_sel = 0;
  let toast: [Toast, null] = null;
  let pick_sel = 0;
  let service_server: [ServiceServer, null] = null;
  let perms_at: [string, null] = null;
  let gate_for: [ServerInfo, null] = null;
  let gate_sel = 0;
  let perm_form: [`Add, `Edit, null] = null;
  let pf_path = line_edit::state("");
  let pf_entity = line_edit::state("");
  let pf_bits = line_edit::state("");
  let pf_focus = 0;
  let chpw_at_c = change_password_at(
    #admin: must_change,
    #glyph: must_change ~ glyph,
    must_change ~ connect_to
  );
  *q <- questions(chpw_at_c);
  {
    catch(e) conn_err <- admin_text((e.0).error);
    let r = result(chpw_at_c)?;
    toast <- r ~ {
      title: "Password changed",
      lines: ["Connect again with the new password."],
      error: false
    }
  };
  let confirm: [{ message: string, action: Act }, null] = null;
  let fail = |title: string, a: AdminError| -> null {
    toast <- { title, lines: [admin_text(a)], error: true };
    null
  };
  // ── panel loads: each (re)load starts a fresh list ceremony ──
  let load: PanelKind = never();
  let queue_c = select load {
    x@ `Queue => list_queue(x ~ target),
    _ => never()
  };
  let deleg_c = select load {
    x@ `Delegations => list_pending_delegations(x ~ target),
    _ => never()
  };
  let servers_c = select load {
    x@ `Servers => list_servers(x ~ target),
    _ => never()
  };
  let certs_c = select load {
    x@ `Certs => issued(x ~ target),
    _ => never()
  };
  let roster_r = select load {
    x@ `Roster => list_admins(x ~ target),
    _ => never()
  };
  let units_c = select load {
    x@ `Services => select x ~ service_server {
      null as _ => never(),
      s => service_control(#units: [], #op: `Status, #server: s.id, x ~ target)
    },
    _ => never()
  };
  let perms_r: Result<Array<PermEntry>, AdminError> = select load {
    x@ `Perms => select x ~ perms_at {
      null as _ => never(),
      at => show_perms(#at: at, x ~ target)
    },
    _ => never()
  };
  // ── the pick screens' lists ──
  let pick: [`Servers, `Clusters] = never();
  let svc_servers_c = select pick {
    x@ `Servers => list_service_servers(x ~ target),
    _ => never()
  };
  let clusters_r: Result<Array<string>, AdminError> = select pick {
    x@ `Clusters => list_resolver_clusters(x ~ target),
    _ => never()
  };
  *q <- questions(queue_c);
  *q <- questions(deleg_c);
  *q <- questions(servers_c);
  *q <- questions(certs_c);
  *q <- questions(units_c);
  *q <- questions(svc_servers_c);
  let queue_rows: [Array<QueueItem>, null] = null;
  {
    catch(e) fail("Loading the queue failed", (e.0).error);
    queue_rows <- result(queue_c)?
  };
  let deleg_rows: [Array<PendingDelegation>, null] = null;
  {
    catch(e) fail("Loading delegations failed", (e.0).error);
    deleg_rows <- result(deleg_c)?
  };
  let server_rows: [Array<ServerInfo>, null] = null;
  {
    catch(e) fail("Loading servers failed", (e.0).error);
    server_rows <- result(servers_c)?
  };
  let cert_rows: [Array<IssuedEntry>, null] = null;
  {
    catch(e) fail("Loading certificates failed", (e.0).error);
    cert_rows <- result(certs_c)?
  };
  let roster_rows: [Array<AdminInfo>, null] = null;
  {
    catch(e) fail("Loading the roster failed", (e.0).error);
    roster_rows <- roster_r?
  };
  let unit_rows: [Array<ServiceUnit>, null] = null;
  {
    catch(e) fail("Listing the services failed", (e.0).error);
    unit_rows <- result(units_c)?
  };
  let perm_rows: [Array<PermEntry>, null] = null;
  {
    catch(e) fail("Loading the permissions failed", (e.0).error);
    perm_rows <- perms_r?
  };
  let svc_servers: [Array<ServiceServer>, null] = null;
  {
    catch(e) fail("Listing the resolver servers failed", (e.0).error);
    svc_servers <- result(svc_servers_c)?
  };
  let clusters: [Array<string>, null] = null;
  {
    catch(e) fail("Listing the resolver clusters failed", (e.0).error);
    clusters <- clusters_r?
  };
  // the servers table's clock: "shut for another 29m" is relative to
  // when the rows arrived
  let now = sys::time::now(server_rows);
  // ── the selected row's action key, per panel ──
  let queue_code: [string, null] = select queue_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => select (rows[min(row_sel, n - 1)]$).code {
        null as _ => null,
        c => c.code
      }
    }
  };
  let deleg_code: [string, null] = select deleg_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => ((rows[min(row_sel, n - 1)]$).code).code
    }
  };
  let roster_name: [string, null] = select roster_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => {
        let a = rows[min(row_sel, n - 1)]$;
        select a.kind {
          `Signing => null,
          `Role => a.admin
        }
      }
    }
  };
  let server_id: [string, null] = select server_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => {
        let s = rows[min(row_sel, n - 1)]$;
        select s.ca {
          true => null,
          false => s.id
        }
      }
    }
  };
  let server_sel: [ServerInfo, null] = select server_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => rows[min(row_sel, n - 1)]$
    }
  };
  let unit_sel: [{ server: string, unit: string }, null] = select service_server {
    null as _ => null,
    s => select unit_rows {
      null as _ => null,
      rows => select array::len(rows) {
        0 => null,
        n => { server: s.id, unit: (rows[min(row_sel, n - 1)]$).unit }
      }
    }
  };
  let perm_sel: [PermEntry, null] = select perm_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => rows[min(row_sel, n - 1)]$
    }
  };
  let cert_serial: [string, null] = select cert_rows {
    null as _ => null,
    rows => select array::len(rows) {
      0 => null,
      n => "[(rows[min(row_sel, n - 1)]$).serial]"
    }
  };
  // ── action dispatch: each run event starts the op's ceremony ──
  let run: Act = never();
  let approve_c = select run {
    `Approve(code) => approve(#code: code, code ~ target),
    _ => never()
  };
  let deny_c = select run {
    `Deny(code) => deny(#code: code, code ~ target),
    _ => never()
  };
  let renewals_c = select run {
    x@ `Renewals => approve_renewals(x ~ target),
    _ => never()
  };
  let apdel_c = select run {
    `ApproveDelegation(code) => approve_delegation(#code: code, code ~ target),
    _ => never()
  };
  let dendel_c = select run {
    `DenyDelegation(code) => deny_delegation(#code: code, code ~ target),
    _ => never()
  };
  let revoke_c = select run {
    `Revoke(serial) => revoke(serial, serial ~ target),
    _ => never()
  };
  let resetpw_r = select run {
    `ResetPassword(name) => reset_password(name, name ~ target),
    _ => never()
  };
  let chpw_c = select run {
    x@ `ChangeOwnPassword => change_password(x ~ target),
    _ => never()
  };
  let rmadmin_r = select run {
    `RemoveAdmin(name) => remove_admin(name, name ~ target),
    _ => never()
  };
  let rmserver_c = select run {
    `RemoveServer(id) => remove_server(id, id ~ target),
    _ => never()
  };
  let reconcile_c = select run {
    x@ `Reconcile => reconcile_ca(x ~ target),
    _ => never()
  };
  let svc_c = select run {
    `Service(a) => service_control(#units: [a.unit], #op: a.op, #server: a.server, a ~ target),
    _ => never()
  };
  let gate_c = select run {
    `Gate(a) => set_read_gate(#server: a.server, a.gate, a ~ target),
    _ => never()
  };
  let setperm_r: Result<RecordedEdit, AdminError> = select run {
    `SetPerm(e) => select e ~ perms_at {
      null as _ => never(),
      at => set_perm(#at: at, #path: e.path, #entity: e.entity, #bits: e.bits, e ~ target)
    },
    _ => never()
  };
  let rmperm_r: Result<RecordedEdit, AdminError> = select run {
    `RemovePerm(e) => select e ~ perms_at {
      null as _ => never(),
      at => remove_perm(#at: at, #path: e.path, #entity: e.entity, e ~ target)
    },
    _ => never()
  };
  *q <- questions(approve_c);
  *q <- questions(deny_c);
  *q <- questions(renewals_c);
  *q <- questions(apdel_c);
  *q <- questions(dendel_c);
  *q <- questions(revoke_c);
  *q <- questions(chpw_c);
  *q <- questions(rmserver_c);
  *q <- questions(reconcile_c);
  *q <- questions(svc_c);
  *q <- questions(gate_c);
  // ── action outcomes: toast the summary, then refresh the panel ──
  {
    catch(e) fail("Approve failed", (e.0).error);
    let r = result(approve_c)?;
    let groups = str::join(#sep: ", ", r.id_map_groups);
    toast <- {
      title: "Approved",
      lines: array::concat(
        ["[r.requested_name] approved", "id-map groups: [groups]"],
        r.warnings
      ),
      error: false
    };
    load <- r ~ `Queue
  };
  {
    catch(e) fail("Deny failed", (e.0).error);
    let name = result(deny_c)?;
    toast <- { title: "Denied", lines: ["Denied [name]"], error: false };
    load <- name ~ `Queue
  };
  {
    catch(e) fail("Approving renewals failed", (e.0).error);
    let rs = result(renewals_c)?;
    toast <- {
      title: "Renewals",
      lines: select array::len(rs) {
        0 => ["No verified renewals were pending"],
        _ => array::map(rs, |r| select r.error {
          null as _ => "renewed [r.requested_name]",
          e => "failed [r.requested_name]: [e]"
        })
      },
      error: false
    };
    load <- rs ~ `Queue
  };
  {
    catch(e) fail("Approving the delegation failed", (e.0).error);
    let r = result(apdel_c)?;
    let lines = array::map(r.peers, |p| select p.error {
      null as _ => "updated [p.server]",
      e => "failed [p.server]: [e]"
    });
    toast <- {
      title: "Delegation approved",
      lines: array::concat(["[r.proposed_path] approved"], lines),
      error: false
    };
    load <- r ~ `Delegations
  };
  {
    catch(e) fail("Denying the delegation failed", (e.0).error);
    let r = result(dendel_c)?;
    toast <- {
      title: "Delegation denied",
      lines: ["Denied [r.proposed_path]"],
      error: false
    };
    load <- r ~ `Delegations
  };
  {
    catch(e) fail("Revoke failed", (e.0).error);
    let r = result(revoke_c)?;
    let lines = array::map(r.revoked, |c| "revoked serial [c.serial] ([c.name])");
    toast <- {
      title: "Revoked",
      lines: array::concat(lines, r.warnings),
      error: false
    };
    load <- r ~ `Certs
  };
  {
    catch(e) fail("Password reset failed", (e.0).error);
    let pw = resetpw_r?;
    toast <- {
      title: "One-time password",
      lines: ["Record this now; it is never shown again:", pw],
      error: false
    };
    load <- pw ~ `Roster
  };
  {
    catch(e) fail("Changing the password failed", (e.0).error);
    let r = result(chpw_c)?;
    toast <- r ~ {
      title: "Password changed",
      lines: ["The session's credential is gone — connect again with the new password."],
      error: false
    };
    screen <- r ~ `Connect
  };
  {
    catch(e) fail("Removing the admin failed", (e.0).error);
    let r = rmadmin_r?;
    toast <- r ~ {
      title: "Admin removed",
      lines: ["The keyslot was removed"],
      error: false
    };
    load <- r ~ `Roster
  };
  {
    catch(e) fail("Removing the server failed", (e.0).error);
    let r = result(rmserver_c)?;
    let lines = array::map(r.peers, |p| select p.error {
      null as _ => "updated [p.server]",
      e => "failed [p.server]: [e]"
    });
    toast <- {
      title: "Server removed",
      lines: array::concat(["revoked [r.revoked] certificates"], lines),
      error: false
    };
    load <- r ~ `Servers
  };
  {
    catch(e) fail("Reconcile failed", (e.0).error);
    let r = result(reconcile_c)?;
    let lines = array::map(r.peers, |p| select p.error {
      null as _ => "updated [p.server]",
      e => "failed [p.server]: [e]"
    });
    toast <- { title: "Reconciled", lines, error: false };
    load <- r ~ `Servers
  };
  {
    catch(e) fail("Service control failed", (e.0).error);
    let units = result(svc_c)?;
    let verb = select run { `Service(a) => fmt_service_op(a.op), _ => "Applied" };
    toast <- {
      title: units ~ verb,
      lines: array::map(units, |u| "[u.unit]: [fmt_unit_state(u.state)]"),
      error: false
    };
    load <- units ~ `Services
  };
  {
    catch(e) fail("Setting the read gate failed", (e.0).error);
    let r = result(gate_c)?;
    toast <- r ~ {
      title: "Read gate set",
      lines: ["The member applies it at its next register; the Servers panel shows what it reports."],
      error: false
    };
    load <- r ~ `Servers
  };
  {
    catch(e) fail("Recording the permission failed", (e.0).error);
    let r = setperm_r?;
    let what = select r.changed {
      true => "Recorded as version [r.version]. Every member of the cluster converges within a poll interval.",
      false => "Already so — nothing changed (version [r.version])."
    };
    toast <- { title: "Permissions updated", lines: [what], error: false };
    load <- r ~ `Perms
  };
  {
    catch(e) fail("Removing the permission failed", (e.0).error);
    let r = rmperm_r?;
    let what = select r.changed {
      true => "Removed; recorded as version [r.version].",
      false => "There was no such entry (version [r.version])."
    };
    toast <- { title: "Permissions updated", lines: [what], error: false };
    load <- r ~ `Perms
  };
  // ── key handling ──
  let panel_last: i64 = select screen {
    `Connect => 0,
    `Menu => 0,
    `Panel(`Queue) => max(0, opt_len(queue_rows) - 1),
    `Panel(`Delegations) => max(0, opt_len(deleg_rows) - 1),
    `Panel(`Roster) => max(0, opt_len(roster_rows) - 1),
    `Panel(`Servers) => max(0, opt_len(server_rows) - 1),
    `Panel(`Certs) => max(0, opt_len(cert_rows) - 1),
    `Panel(`Services) => max(0, opt_len(unit_rows) - 1),
    `Panel(`Perms) => max(0, opt_len(perm_rows) - 1),
    `ServerPick => 0,
    `ClusterPick => 0
  };
  let pick_last: i64 = select screen {
    `ServerPick => max(0, opt_len(svc_servers) - 1),
    `ClusterPick => max(0, opt_len(clusters) - 1),
    _ => 0
  };
  let connect_keys = |ev: Event, k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Enter => {
      select kk ~ ed.value {
        "" => never(),
        v => connect_to <- v
      };
      `Stop
    },
    _ => line_edit::handle(&ed, ev)
  };
  let menu_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    `Up | `Char("k") => { menu_sel <- max(0, (k ~ menu_sel) - 1); `Stop },
    `Down | `Char("j") => {
      menu_sel <- min(array::len(panels) - 1, (k ~ menu_sel) + 1);
      `Stop
    },
    kk@ `Enter => {
      let p = (panels[kk ~ menu_sel]$).kind;
      select p {
        `Services => { screen <- `ServerPick; pick <- `Servers },
        `Perms => { screen <- `ClusterPick; pick <- `Clusters },
        _ => { screen <- `Panel(p); load <- p }
      };
      row_sel <- p ~ 0;
      pick_sel <- p ~ 0;
      `Stop
    },
    kk@ `Esc => { screen <- kk ~ `Connect; `Stop },
    _ => `Continue
  };
  let pick_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    `Up | `Char("k") => { pick_sel <- max(0, (k ~ pick_sel) - 1); `Stop },
    `Down | `Char("j") => { pick_sel <- min(k ~ pick_last, (k ~ pick_sel) + 1); `Stop },
    kk@ `Esc => { screen <- kk ~ `Menu; `Stop },
    kk@ `Enter => {
      let i = kk ~ pick_sel;
      select kk ~ (screen, svc_servers, clusters) {
        (`ServerPick, rows, _) => select rows {
          null as _ => never(),
          rows => select array::len(rows) {
            0 => never(),
            n => {
              service_server <- rows[min(i, n - 1)]$;
              screen <- `Panel(`Services);
              load <- `Services
            }
          }
        },
        (`ClusterPick, _, bases) => select bases {
          null as _ => never(),
          bases => select array::len(bases) {
            0 => never(),
            n => {
              perms_at <- bases[min(i, n - 1)]$;
              screen <- `Panel(`Perms);
              load <- `Perms
            }
          }
        },
        _ => never()
      };
      row_sel <- kk ~ 0;
      `Stop
    },
    _ => `Continue
  };
  let queue_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("a") => {
      select kk ~ queue_code {
        null as _ => never(),
        code => confirm <- {
          message: "Approve this enrollment?\n\nVerify this glyph and code match the screenshot the enrollee sent you, out of band:\n\n[code]",
          action: `Approve(code)
        }
      };
      `Stop
    },
    kk@ `Char("d") => {
      select kk ~ queue_code {
        null as _ => never(),
        code => run <- `Deny(code)
      };
      `Stop
    },
    kk@ `Char("R") => { run <- kk ~ `Renewals; `Stop },
    _ => `Continue
  };
  let deleg_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("a") => {
      select kk ~ deleg_code {
        null as _ => never(),
        code => confirm <- {
          message: "Approve or reconcile this delegation?\n\nVerify this glyph and code match the screenshot the child resolver's operator sent you, out of band:\n\n[code]",
          action: `ApproveDelegation(code)
        }
      };
      `Stop
    },
    kk@ `Char("d") => {
      select kk ~ deleg_code {
        null as _ => never(),
        code => run <- `DenyDelegation(code)
      };
      `Stop
    },
    _ => `Continue
  };
  let roster_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("c") => { run <- kk ~ `ChangeOwnPassword; `Stop },
    kk@ `Char("p") => {
      select kk ~ roster_name {
        null as _ => never(),
        name => confirm <- {
          message: "Reset [name]'s password? The password they have stops working immediately and every session they hold is closed. You will get a one-time password to give them.",
          action: `ResetPassword(name)
        }
      };
      `Stop
    },
    kk@ `Char("d") => {
      select kk ~ roster_name {
        null as _ => never(),
        name => confirm <- {
          message: "Remove admin [name]? Their password will no longer authenticate to this CA.",
          action: `RemoveAdmin(name)
        }
      };
      `Stop
    },
    _ => `Continue
  };
  let server_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("c") => { run <- kk ~ `Reconcile; `Stop },
    kk@ `Char("g") => {
      select kk ~ server_sel {
        null as _ => never(),
        s => select s.resolver {
          null as _ => toast <- {
            title: "No read gate",
            lines: ["[s.id] runs no resolver, so it has no read gate to set."],
            error: true
          },
          _ => { gate_for <- s; gate_sel <- 0 }
        }
      };
      `Stop
    },
    kk@ `Char("x") => {
      select kk ~ server_id {
        null as _ => never(),
        id => confirm <- {
          message: "Permanently remove server [id]? Its certificates are revoked and the removal is pushed domain-wide.",
          action: `RemoveServer(id)
        }
      };
      `Stop
    },
    _ => `Continue
  };
  let cert_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("x") => {
      select kk ~ cert_serial {
        null as _ => never(),
        serial => confirm <- {
          message: "Revoke certificate serial [serial]? This is irreversible — the admin domain re-signs its CRL and the holder can no longer authenticate.",
          action: `Revoke(serial)
        }
      };
      `Stop
    },
    _ => `Continue
  };
  let service_act = |kk: Any, op: ServiceOp| -> null {
    select kk ~ unit_sel {
      null as _ => never(),
      u => run <- `Service({ server: u.server, unit: u.unit, op })
    };
    null
  };
  let services_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("s") => { service_act(kk, `Start); `Stop },
    kk@ `Char("t") => { service_act(kk, `Stop); `Stop },
    kk@ `Char("R") => { service_act(kk, `Restart); `Stop },
    _ => `Continue
  };
  let perms_keys = |k: KeyEvent| -> [`Stop, `Continue] select k.code {
    kk@ `Char("a") => {
      pf_path <- line_edit::state(kk ~ "/");
      pf_entity <- line_edit::state(kk ~ "");
      pf_bits <- line_edit::state(kk ~ "");
      pf_focus <- kk ~ 0;
      perm_form <- kk ~ `Add;
      `Stop
    },
    kk@ `Char("e") => {
      select kk ~ perm_sel {
        null as _ => never(),
        r => {
          pf_path <- line_edit::state(r.path);
          pf_entity <- line_edit::state(r.entity);
          pf_bits <- line_edit::state(r.bits);
          pf_focus <- r ~ 2;
          perm_form <- r ~ `Edit
        }
      };
      `Stop
    },
    kk@ `Char("d") => {
      select kk ~ perm_sel {
        null as _ => never(),
        r => confirm <- {
          message: "Remove [r.entity]'s permissions at [r.path]?",
          action: `RemovePerm({ path: r.path, entity: r.entity })
        }
      };
      `Stop
    },
    _ => `Continue
  };
  let panel_keys = |k: KeyEvent, p: PanelKind| -> [`Stop, `Continue] select k.code {
    kk@ `Esc => { screen <- kk ~ `Menu; `Stop },
    kk@ `Char("r") => { load <- kk ~ p; `Stop },
    `Up | `Char("k") => { row_sel <- max(0, (k ~ row_sel) - 1); `Stop },
    `Down | `Char("j") => {
      row_sel <- min(k ~ panel_last, (k ~ row_sel) + 1);
      `Stop
    },
    _ => select p {
      `Queue => queue_keys(k),
      `Delegations => deleg_keys(k),
      `Roster => roster_keys(k),
      `Servers => server_keys(k),
      `Certs => cert_keys(k),
      `Services => services_keys(k),
      `Perms => perms_keys(k)
    }
  };
  let handle = |e: Event| -> [`Stop, `Continue] select e {
    ev@ `Key(k) => select k.kind {
      `Press => select screen {
        `Connect => connect_keys(ev, k),
        `Menu => menu_keys(k),
        `Panel(p) => panel_keys(k, p),
        `ServerPick => pick_keys(k),
        `ClusterPick => pick_keys(k)
      },
      _ => `Continue
    },
    _ => `Continue
  };
  // ── the read-gate chooser and the permission form ──
  let gate_handle = |e: Event| -> [`Stop, `Continue] select e {
    `Key(k) => select k.kind {
      `Press => select k.code {
        `Up | `Char("k") => { gate_sel <- max(0, (k ~ gate_sel) - 1); `Stop },
        `Down | `Char("j") => {
          gate_sel <- min(array::len(gate_choices) - 1, (k ~ gate_sel) + 1);
          `Stop
        },
        kk@ `Enter => {
          let g = (gate_choices[kk ~ gate_sel]$).gate;
          let at = kk ~ now;
          select kk ~ gate_for {
            null as _ => never(),
            s => select gate_warning(s, g, at) {
              null as _ => run <- `Gate({ server: s.id, gate: g }),
              w => confirm <- { message: w, action: `Gate({ server: s.id, gate: g }) }
            }
          };
          gate_for <- kk ~ null;
          `Stop
        },
        kk@ `Esc => { gate_for <- kk ~ null; `Stop },
        _ => `Stop
      },
      _ => `Stop
    },
    _ => `Stop
  };
  let perm_form_handle = |e: Event| -> [`Stop, `Continue] select e {
    ev@ `Key(k) => select k.kind {
      `Press => select k.code {
        `Tab | `Down => { pf_focus <- (k ~ pf_focus + 1) % 3; `Stop },
        `BackTab | `Up => { pf_focus <- (k ~ pf_focus + 2) % 3; `Stop },
        kk@ `Enter => {
          run <- kk ~ `SetPerm({ path: pf_path.value, entity: pf_entity.value, bits: pf_bits.value });
          perm_form <- kk ~ null;
          `Stop
        },
        kk@ `Esc => { perm_form <- kk ~ null; `Stop },
        _ => select pf_focus {
          0 => line_edit::handle(&pf_path, ev),
          1 => line_edit::handle(&pf_entity, ev),
          _ => line_edit::handle(&pf_bits, ev)
        }
      },
      _ => `Stop
    },
    _ => `Stop
  };
  // ── the confirm and toast modals ──
  let confirm_handle = |e: Event| -> [`Stop, `Continue] select e {
    `Key(k) => select k.kind {
      `Press => select k.code {
        kk@ `Char("y") => {
          select kk ~ confirm {
            null as _ => never(),
            c => {
              run <- c.action;
              confirm <- c ~ null
            }
          };
          `Stop
        },
        kk@ `Enter => {
          select kk ~ confirm {
            null as _ => never(),
            c => {
              run <- c.action;
              confirm <- c ~ null
            }
          };
          `Stop
        },
        kk@ `Char("n") => { confirm <- kk ~ null; `Stop },
        kk@ `Esc => { confirm <- kk ~ null; `Stop },
        _ => `Stop
      },
      _ => `Stop
    },
    _ => `Stop
  };
  let toast_handle = |e: Event| -> [`Stop, `Continue] select e {
    `Key(k) => select k.kind {
      `Press => select k.code {
        kk@ `Enter => { toast <- kk ~ null; `Stop },
        kk@ `Esc => { toast <- kk ~ null; `Stop },
        kk@ `Char(" ") => { toast <- kk ~ null; `Stop },
        _ => `Stop
      },
      _ => `Stop
    },
    _ => `Stop
  };
  let confirm_widget = select confirm {
    null as _ => paragraph(&""),
    c => block(
      #border: &`All,
      #title: &line("Confirm"),
      #title_bottom: &line(#style: hint, " y confirm · n cancel "),
      &paragraph(#trim: &false, &c.message)
    )
  };
  let toast_widget = select toast {
    null as _ => paragraph(&""),
    t => {
      let body = str::join(#sep: "\n", t.lines);
      let tstyle = select t.error {
        true => style(#fg: `Red),
        false => style(#fg: `Green)
      };
      block(
        #border: &`All,
        #title: &line(#style: tstyle, t.title),
        #title_bottom: &line(#style: hint, " Enter dismiss "),
        &paragraph(#trim: &false, &body)
      )
    }
  };
  let gate_widget = select gate_for {
    null as _ => paragraph(&""),
    s => {
      let items = array::map(gate_choices, |c| line(c.label));
      let detail: Array<tui::Line> = [
        line(#style: hint, "server: [s.id] at [s.addr]"),
        line(#style: hint, "now: [gate_detail(s.read_gate)]")
      ];
      block(
        #border: &`All,
        #title: &line("Read gate"),
        #title_bottom: &line(#style: hint, " ↑/↓ move · Enter choose · Esc back "),
        &layout(#direction: &`Vertical, &[
          child(#constraint: `Length(2), paragraph(#trim: &false, &detail)),
          child(#constraint: `Min(1),
            list(#highlight_style: &selstyle, #selected: &gate_sel, &items))
        ])
      )
    }
  };
  let perm_form_widget = select perm_form {
    null as _ => paragraph(&""),
    mode => {
      let title = select mode {
        `Add => "Add a permission entry",
        `Edit => "Edit permission bits"
      };
      let field = |label: string, i: i64, st: &line_edit::State| -> tui::Tui
        layout(#direction: &`Horizontal, &[
          child(#constraint: `Length(9), text(&[line(#style: hint, "[label]:")])),
          child(#constraint: `Min(1), text(&[line_edit::view(#focused: pf_focus == i, st)]))
        ]);
      block(
        #border: &`All,
        #title: &line(title),
        #title_bottom: &line(#style: hint, " Tab next field · Enter record · Esc cancel "),
        &layout(#direction: &`Vertical, &[
          child(#constraint: `Length(2), paragraph(#style: &hint,
            &"Bits are a permission string such as swlpd; an empty entity is anonymous.")),
          child(#constraint: `Length(1), field("path", 0, &pf_path)),
          child(#constraint: `Length(1), field("entity", 1, &pf_entity)),
          child(#constraint: `Length(1), field("bits", 2, &pf_bits))
        ])
      )
    }
  };
  let layers: Array<Layer> = {
    let gl: Array<Layer> = select gate_for {
      null as _ => [],
      _ => [layer(#width: &`Percentage(60), #height: &`Percentage(50),
        input_handler(#handle: &gate_handle, &gate_widget))]
    };
    let pl: Array<Layer> = select perm_form {
      null as _ => [],
      _ => [layer(#width: &`Percentage(60), #height: &`Percentage(40),
        input_handler(#handle: &perm_form_handle, &perm_form_widget))]
    };
    let cl: Array<Layer> = select confirm {
      null as _ => [],
      _ => [layer(#width: &`Percentage(60), #height: &`Percentage(50),
        input_handler(#handle: &confirm_handle, &confirm_widget))]
    };
    let tl: Array<Layer> = select toast {
      null as _ => [],
      _ => [layer(#width: &`Percentage(60), #height: &`Percentage(50),
        input_handler(#handle: &toast_handle, &toast_widget))]
    };
    array::concat(gl, pl, cl, tl)
  };
  // ── views ──
  let conn_err_lines: Array<tui::Line> = select conn_err {
    null as _ => [],
    m => [line(#style: style(#fg: `Red), m)]
  };
  let connect_view = block(
    #border: &`All,
    #title: &line("Connect to an admin domain"),
    #title_bottom: &line(#style: hint, " Enter connect "),
    &layout(#direction: &`Vertical, &[
      child(#constraint: `Length(2),
        paragraph(#style: &hint, &"Enter the admin server's address (host:port).")),
      child(#constraint: `Length(1), text(&[line_edit::view(&ed)])),
      child(#constraint: `Length(1), text(&conn_err_lines))
    ])
  );
  let menu_view = {
    let items = array::map(panels, |p| line(p.title));
    let desc: Array<tui::Line> = [line(#style: hint, (panels[menu_sel]$).desc)];
    let title = select info(target) {
      `Remote({ server, admin, identity }) => "[identity.domain] — [server] as [admin]",
      `Local({ cfg_path }) => "this host — [cfg_path]"
    };
    block(
      #border: &`All,
      #title: &line(title),
      #title_bottom: &line(#style: hint, " ↑/↓ move · Enter open · Esc disconnect "),
      &layout(#direction: &`Vertical, &[
        child(#constraint: `Length(array::len(panels)),
          list(#highlight_style: &selstyle, #selected: &menu_sel, &items)),
        child(#constraint: `Min(1), paragraph(#trim: &false, &desc))
      ])
    )
  };
  let queue_trs: Array<&Row> = select queue_rows {
    null as _ => [],
    rows => array::map(rows, |i| {
      let name = select i.enroll_listen {
        null as _ => i.requested_name,
        l => "admin-server enrollment @ [l]"
      };
      let mark = select i.verified_renewal {
        true => "renewal ",
        false => ""
      };
      let code_s = select i.code {
        null as _ => "unparseable — deny only",
        c => c.short
      };
      &row([
        cell(line("[mark][name]")),
        cell(line(i.kind)),
        cell(line(code_s)),
        cell(line(fmt_age(i.age_secs))),
        cell(line(i.peer))
      ])
    })
  };
  let queue_view = table(
    #header: &row(#style: bold, [
      cell(line("Name")), cell(line("Kind")), cell(line("Code")),
      cell(line("Age")), cell(line("From"))
    ]),
    #row_highlight_style: &selstyle,
    #selected: &row_sel,
    #widths: &[`Percentage(40), `Length(10), `Length(24), `Length(8), `Percentage(25)],
    &queue_trs
  );
  let deleg_trs: Array<&Row> = select deleg_rows {
    null as _ => [],
    rows => array::map(rows, |i| {
      let state = select i.approved {
        true => "approved — a reconciles",
        false => "pending"
      };
      &row([
        cell(line(i.proposed_path)),
        cell(line(state)),
        cell(line((i.code).short)),
        cell(line(fmt_age(i.age_secs))),
        cell(line(i.peer))
      ])
    })
  };
  let deleg_view = table(
    #header: &row(#style: bold, [
      cell(line("Path")), cell(line("State")), cell(line("Code")),
      cell(line("Age")), cell(line("From"))
    ]),
    #row_highlight_style: &selstyle,
    #selected: &row_sel,
    #widths: &[`Percentage(35), `Length(24), `Length(24), `Length(8), `Percentage(20)],
    &deleg_trs
  );
  let roster_trs: Array<&Row> = select roster_rows {
    null as _ => [],
    rows => array::map(rows, |a| {
      let chg = select a.must_change {
        true => "must change password",
        false => ""
      };
      &row([
        cell(line(a.admin)),
        cell(line(fmt_slot(a.kind))),
        cell(line(a.slot_id)),
        cell(line(chg))
      ])
    })
  };
  let roster_detail: Array<tui::Line> = select roster_rows {
    null as _ => [],
    rows => select array::len(rows) {
      0 => [],
      n => {
        let p = (rows[min(row_sel, n - 1)]$).policy;
        let san = str::join(#sep: ", ", p.allowed_san);
        let groups = str::join(#sep: ", ", p.id_map_groups);
        let enroll = str::join(#sep: ", ", p.server_enroll_scopes);
        let perms = str::join(#sep: ", ", p.perms_edit_scopes);
        let manage = select p.may_manage_admins {
          true => "yes",
          false => "no"
        };
        [
          line(#style: hint, "allowed SAN: [san]"),
          line(#style: hint, "id-map groups: [groups]"),
          line(#style: hint, "server enroll scopes: [enroll]"),
          line(#style: hint, "perms edit scopes: [perms]"),
          line(#style: hint, "may manage admins: [manage] · max validity [p.max_validity]")
        ]
      }
    }
  };
  let roster_view = layout(#direction: &`Vertical, &[
    child(#constraint: `Min(3), table(
      #header: &row(#style: bold, [
        cell(line("Admin")), cell(line("Kind")), cell(line("Slot")),
        cell(line(""))
      ]),
      #row_highlight_style: &selstyle,
      #selected: &row_sel,
      #widths: &[`Percentage(30), `Length(8), `Percentage(30), `Length(20)],
      &roster_trs
    )),
    child(#constraint: `Length(5), paragraph(#trim: &false, &roster_detail))
  ]);
  let server_trs: Array<&Row> = select server_rows {
    null as _ => [],
    rows => array::map(rows, |s| {
      let cluster = select s.cluster_base {
        null as _ => "(none)",
        c => c
      };
      let roles = str::join(#sep: ", ", s.roles);
      let tag = select s.ca {
        true => "[s.state], CA",
        false => s.state
      };
      &row([
        cell(line(cluster)),
        cell(line(s.id)),
        cell(line(s.addr)),
        cell(line(roles)),
        cell(line(tag)),
        cell(line(gate_label(s.read_gate, now)))
      ])
    })
  };
  let server_detail: Array<tui::Line> = select server_sel {
    null as _ => [],
    s => [line(#style: hint, "read gate: [gate_detail(s.read_gate)]")]
  };
  let servers_view = layout(#direction: &`Vertical, &[
    child(#constraint: `Min(3), table(
      #header: &row(#style: bold, [
        cell(line("Cluster")), cell(line("Id")), cell(line("Address")),
        cell(line("Roles")), cell(line("State")), cell(line("Gate"))
      ]),
      #row_highlight_style: &selstyle,
      #selected: &row_sel,
      #widths: &[`Percentage(18), `Percentage(24), `Length(22), `Length(18), `Percentage(12), `Length(14)],
      &server_trs
    )),
    child(#constraint: `Length(1), text(&server_detail))
  ]);
  let cert_trs: Array<&Row> = select cert_rows {
    null as _ => [],
    rows => array::map(rows, |c| {
      let state = select c.revoked {
        true => "revoked",
        false => ""
      };
      let expiry = "[cast<datetime>(c.not_after_unix)$]";
      &row([
        cell(line("[c.serial]")),
        cell(line(c.name)),
        cell(line(expiry)),
        cell(line(state))
      ])
    })
  };
  let certs_view = table(
    #header: &row(#style: bold, [
      cell(line("Serial")), cell(line("Name")), cell(line("Expires")),
      cell(line(""))
    ]),
    #row_highlight_style: &selstyle,
    #selected: &row_sel,
    #widths: &[`Length(10), `Percentage(40), `Length(22), `Length(10)],
    &cert_trs
  );
  let unit_trs: Array<&Row> = select unit_rows {
    null as _ => [],
    rows => array::map(rows, |u| {
      let (exe, trigger, restart) = select u.definition {
        null as _ => ("(no definition on disk)", "", ""),
        d => (str::join(#sep: " ", array::push_front(d.args, d.exe)), d.trigger, d.restart)
      };
      &row([
        cell(line(u.unit)),
        cell(line(fmt_unit_state(u.state))),
        cell(line(exe)),
        cell(line(trigger)),
        cell(line(restart))
      ])
    })
  };
  let services_view = {
    let header: Array<tui::Line> = select service_server {
      null as _ => [],
      s => [line(#style: bold, "Services @ [s.addr] ([s.id]) · [s.base]")]
    };
    layout(#direction: &`Vertical, &[
      child(#constraint: `Length(1), text(&header)),
      child(#constraint: `Min(3), table(
        #header: &row(#style: bold, [
          cell(line("Unit")), cell(line("State")), cell(line("Command")),
          cell(line("Trigger")), cell(line("Restart"))
        ]),
        #row_highlight_style: &selstyle,
        #selected: &row_sel,
        #widths: &[`Percentage(20), `Length(20), `Percentage(40), `Length(12), `Length(10)],
        &unit_trs
      ))
    ])
  };
  let perm_trs: Array<&Row> = select perm_rows {
    null as _ => [],
    rows => array::map(rows, |e| {
      let entity = select e.entity {
        "" => "(anonymous)",
        n => n
      };
      &row([cell(line(e.path)), cell(line(entity)), cell(line(e.bits))])
    })
  };
  let perms_view = {
    let header: Array<tui::Line> = select perms_at {
      null as _ => [],
      at => [line(#style: bold, "Permissions of the cluster at [at]")]
    };
    let body: Array<tui::Line> = select perm_rows {
      null as _ => [],
      [] => [line(#style: hint, "(no permissions set)")],
      _ => []
    };
    layout(#direction: &`Vertical, &[
      child(#constraint: `Length(1), text(&header)),
      child(#constraint: `Length(1), text(&body)),
      child(#constraint: `Min(3), table(
        #header: &row(#style: bold, [
          cell(line("Path")), cell(line("Entity")), cell(line("Bits"))
        ]),
        #row_highlight_style: &selstyle,
        #selected: &row_sel,
        #widths: &[`Percentage(50), `Percentage(35), `Length(10)],
        &perm_trs
      ))
    ])
  };
  let server_pick_view = {
    let items: Array<tui::Line> = select svc_servers {
      null as _ => [line(#style: hint, "listing the admin domain's resolver servers…")],
      [] => [line(#style: hint, "no registered admin server runs a resolver")],
      rows => array::map(rows, |s| line("[s.addr]  [s.id]  [s.base]"))
    };
    block(
      #border: &`All,
      #title: &line("Pick an admin server"),
      #title_bottom: &line(#style: hint, " ↑/↓ move · Enter open · Esc back "),
      &list(#highlight_style: &selstyle, #selected: &pick_sel, &items)
    )
  };
  let cluster_pick_view = {
    let items: Array<tui::Line> = select clusters {
      null as _ => [line(#style: hint, "listing the admin domain's resolver clusters…")],
      [] => [line(#style: hint, "no active resolver cluster")],
      bases => array::map(bases, |b| line(b))
    };
    block(
      #border: &`All,
      #title: &line("Pick a resolver cluster"),
      #title_bottom: &line(#style: hint, " ↑/↓ move · Enter open · Esc back "),
      &list(#highlight_style: &selstyle, #selected: &pick_sel, &items)
    )
  };
  let panel_view = |p: PanelKind, w: tui::Tui| -> tui::Tui {
    let m = panels[0]$;
    let entry = select array::find(panels, |e| e.kind == p) {
      null as _ => m,
      e => e
    };
    block(#border: &`All, #title: &line(entry.title), &w)
  };
  let body: tui::Tui = select screen {
    `Connect => connect_view,
    `Menu => menu_view,
    `Panel(`Queue) => panel_view(`Queue, queue_view),
    `Panel(`Delegations) => panel_view(`Delegations, deleg_view),
    `Panel(`Roster) => panel_view(`Roster, roster_view),
    `Panel(`Servers) => panel_view(`Servers, servers_view),
    `Panel(`Certs) => panel_view(`Certs, certs_view),
    `Panel(`Services) => panel_view(`Services, services_view),
    `Panel(`Perms) => panel_view(`Perms, perms_view),
    `ServerPick => server_pick_view,
    `ClusterPick => cluster_pick_view
  };
  let status: tui::Line = select screen {
    `Connect => line(#style: hint, " type an address · Enter connect "),
    `Menu => line(#style: hint, " ↑/↓ move · Enter open · Esc disconnect "),
    `ServerPick => line(#style: hint, " ↑/↓ move · Enter open · Esc back "),
    `ClusterPick => line(#style: hint, " ↑/↓ move · Enter open · Esc back "),
    `Panel(p) => {
      let m = panels[0]$;
      let entry = select array::find(panels, |e| e.kind == p) {
        null as _ => m,
        e => e
      };
      line(#style: hint, entry.keys)
    }
  };
  {
    view: body,
    handle,
    status,
    layers
  }
}
