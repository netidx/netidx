use package::ceremony::Question;
use super::{local, pump, remote, theme};
use tui::{
  line,
  block::block,
  input_handler::{Event, input_handler, on_press},
  layout::{child, layout},
  overlay::overlay,
  tabs::tabs,
  text::text
};

let app = |#server: string = ""| -> tui::Tui {
  let q = never<Question>();
  let p = pump(q);
  let loc = local::local(#q: &mut q);
  let book_dir = opt::map(sys::dirs::config_dir(), |d| sys::join_path(d, "netidx-admin-tui"));
  let rem = remote::remote(#q: &mut q, #book_dir: book_dir, #server: server);
  // which tab the operator asked for: a tag, never the tab itself,
  // which re-fires with every change inside it
  let front: [`Local, `Remote] = select server {
    "" => `Local,
    _ => `Remote
  };
  // which tab is in front: the Local tab is the only one until
  // something is installed here
  let shown = select loc.installed {
    false => `Local,
    true => front
  };
  // inside a tool (an admin panel, the services list, the connect
  // screen) the tab bar is gone and Tab stays put: Esc backs out first
  let in_tool = select shown {
    `Local => loc.in_tool,
    `Remote => rem.in_tool
  };
  // the tab's own keys come first; what it leaves alone reaches the
  // global ones
  let tab_handle = |e: Event| select e ~ shown {
    `Local => loc.handle(e),
    `Remote => rem.handle(e)
  };
  let global = |e: Event| on_press(e, |k| select k.code {
    `Tab => {
      front <- select k ~ (loc.installed, in_tool, front) {
        (_, true, _) => never(),
        (true, false, `Local) => `Remote,
        _ => `Local
      };
      `Stop
    },
    `Char("q") => { tui::exit(k ~ null); `Stop },
    _ => `Continue
  });
  let selected = select shown {
    `Local => 0,
    `Remote => 1
  };
  let view = select shown {
    `Local => loc.view,
    `Remote => rem.view
  };
  let body = select (loc.installed, in_tool) {
    (true, false) => {
      // the bar alone: each tab's view is laid out below it
      let bar = tabs(
        #selected: &selected,
        #highlight_style: &theme::selected,
        &[(line("Local"), text(&[])), (line("Admin Domain"), text(&[]))]
      );
      layout(#direction: &`Vertical, &[
        child(#constraint: `Length(3), theme::panel(#title: "netidx admin", bar)),
        child(#constraint: `Min(1), view)
      ])
    },
    _ => view
  };
  let tab_layers = select shown {
    `Local => loc.layers,
    `Remote => rem.layers
  };
  // the keys of what is in front: the tab's, a dialog's (every dialog
  // closes on Esc), or none while the pump shows work under way
  let status = select (p.busy, array::len(p.layers), array::len(tab_layers)) {
    (false, 0, 0) => select shown {
      `Local => loc.status,
      `Remote => rem.status
    },
    (false, 0, _) | (true, _, _) => line(" answer above · Esc cancel "),
    _ => line(" working… · Ctrl-C quit ")
  };
  let layers = array::concat(tab_layers, p.layers);
  // a dialog stands alone on the backdrop, nothing behind it
  let screen = select array::len(layers) {
    0 => body,
    _ => text(&[])
  };
  block(#style: &theme::backdrop, &overlay(#layers: &layers,
    input_handler(#handle: &tab_handle,
      &input_handler(#handle: &global,
        &layout(#direction: &`Vertical, &[
          child(#constraint: `Min(1), screen),
          child(#constraint: `Length(1), text(&[status]))
        ])))))
}
