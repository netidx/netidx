use package::ceremony::Question;
use super::{local, pump, remote};
use tui::{line, style};
use tui::input_handler::{self, *};
use tui::layout::{self, *};
use tui::overlay::{self, *};
use tui::tabs::{self, *};
use tui::text::{self, *};

let app = |#server: string = ""| -> tui::Tui {
  let hint = style(#fg: `DarkGray);
  let selstyle = style(#add_modifier: [`Reversed]);
  let q = never<Question>();
  let p = pump(q);
  let loc = local::local(#q: &q);
  let book_dir = opt::map(sys::dirs::config_dir(), |d| sys::join_path(d, "netidx-admin-tui"));
  let rem = remote::remote(#q: &q, #book_dir: book_dir, #server: server);
  let order = select server {
    "" => [`Local(loc), `Remote(rem)],
    _ => [`Remote(rem), `Local(loc)]
  };
  let tab = order[0]$;
  // the tab's own keys come first; what it leaves alone reaches the
  // global ones
  let tab_handle = |e: Event| select e ~ tab {
    `Local(t) => t.handle(e),
    `Remote(t) => t.handle(e)
  };
  let global = |e: Event| on_press(e, |k| select k.code {
    `Tab => {
      order <- k ~ select loc.installed {
        true => array::rotate(order),
        false => [`Local(loc), `Remote(rem)]
      };
      `Stop
    },
    `Char("q") => { tui::exit(k ~ null); `Stop },
    _ => `Continue
  });
  let selected = select tab {
    `Local(_) => 0,
    `Remote(_) => 1
  };
  let body = select loc.installed {
    false => loc.view,
    true => tabs(
      #selected: &selected,
      #highlight_style: &selstyle,
      &[(line("Local"), loc.view), (line("Admin Domain"), rem.view)]
    )
  };
  let status = select p.progress {
    null as _ => select tab {
      `Local(t) => t.status,
      `Remote(t) => t.status
    },
    pr => line(#style: hint, " working… [pr.message] ")
  };
  let layers = array::concat(
    select tab {
      `Local(t) => t.layers,
      `Remote(t) => t.layers
    },
    p.layers
  );
  overlay(#layers: &layers,
    input_handler(#handle: &tab_handle,
      &input_handler(#handle: &global,
        &layout(#direction: &`Vertical, &[
          child(#constraint: `Min(1), body),
          child(#constraint: `Length(1), text(&[status]))
        ]))))
}
