/// The error union every admin operation can fail with.
/// `PasswordChangeRequired` is its own variant because frontends route
/// on it (open the change-password flow); the payload is the admin name.
/// `Unsupported` is a unix-only operation invoked on another platform.
type AdminError = [
  `Admin(string),
  `PasswordChangeRequired(string),
  `Unsupported(string)
];

/// A grouped-base32 SPKI fingerprint: the out-of-band code operators
/// relay and match. `code` is the full grouped text an operator reads
/// out; `short` is the abbreviated display form.
type Fingerprint = { code: string, short: string };

/// How one piece of a server's state compares to what the CA recorded.
type Agreement = [
  `Current({ version: u64 }),
  `Behind({ reported: [u64, null], want: u64 }),
  `Unrecorded,
  `Ahead({ reported: u64, ca: u64 })
];

/// One server's agreement with the CA, per kind of state. A null
/// agreement means that kind of state doesn't apply to this server.
type ServerDrift = {
  server: string,
  addr: string,
  perms: [Agreement, null],
  id_map: [Agreement, null],
  config: [Agreement, null],
  config_drift: bool
};

/// Whether an admin keyslot can recover the CA key (`Signing`) or only
/// authenticate a scoped role admin (`Role`).
type SlotKind = [`Signing, `Role];

/// What the admin server will do on an admin's behalf. Roles are
/// named `Ca`, `Resolver`, or `IdMap`.
type Policy = {
  allowed_san: Array<string>,
  max_validity: duration,
  id_map_groups: Array<string>,
  server_enroll_scopes: Array<string>,
  server_enroll_roles: Array<string>,
  perms_edit_scopes: Array<string>,
  may_manage_admins: bool,
  service_control_scopes: Array<string>
};

/// One admin keyslot's public facts, from the roster.
type AdminInfo = {
  slot_id: string,
  admin: string,
  kind: SlotKind,
  policy: Policy,
  must_change: bool
};

/// Which admin server an operation talks to: this host's own (over its
/// local control socket) or an authenticated remote session.
type Target;

/// This host's own admin server as a target, over its local control
/// socket (unix only). Discovers the admin-server config when
/// `#cfg_path` is null. Fires per `trigger` delivery.
val local: fn(?#cfg_path: [string, null], trigger: Any) -> Result<Target, AdminError>;

/// Every registered server's agreement with the CA, in stable server-id
/// order. Re-queries per `t` delivery — sample to refresh:
/// `drift(tick ~ t)`.
val drift: fn(t: Target) -> Result<Array<ServerDrift>, AdminError>;

/// The admin roster: every keyslot's public facts.
val list_admins: fn(t: Target) -> Result<Array<AdminInfo>, AdminError>;

/// Parse and normalize a fingerprint code an operator typed. The
/// returned `code` is the canonical grouped form.
val parse_fingerprint: fn(code: string) -> Result<Fingerprint, `Admin(string)>;

/// The fingerprint's 8x8 identicon as data: which cells are set, and
/// the (deterministic) color. Rendering is the frontend's job.
val identicon: fn(fp: Fingerprint) -> Result<{cells: Array<Array<bool>>, color: {r: u8, g: u8, b: u8}}, `Admin(string)>;

/// The confirmed identity of an admin server's CA: what the operator
/// verifies out of band before anything is trusted.
type CaIdentity = {
  fingerprint: Fingerprint,
  domain: string,
  roles: Array<string>,
  server_id: string,
  ca: bool
};

/// A netidx admin domain discovered on the local network.
type AdminDomain = { domain: string, identity: CaIdentity };

/// What a target is: this host's own admin server (its config path),
/// or a remote session — the server address, the admin it
/// authenticates, and the CA identity the operator confirmed.
/// Presentation data for a title or a status line.
type TargetInfo = [
  `Local({ cfg_path: string }),
  `Remote({ server: string, admin: string, identity: CaIdentity })
];

/// Describe a target.
val info: fn(t: Target) -> TargetInfo;

/// The presentation descriptor of a question: the CLI flag a script
/// would pass (the question's stable identity), a short label, and
/// newcomer-actionable help.
type FieldInfo = { flag: string, label: string, help: string };

/// The phase a long-running step is in.
type Stage = [`Discovering, `Enrolling, `WaitingApproval, `Applying, `Done];

/// Which shown-once secret a `OneTimeSecret` event presents. The
/// payload of `AdminPassword` is the admin's name.
type OneTimeSecretKind = [`CaRecovery, `AdminPassword(string)];

/// A running interactive admin flow. Inert until the first `events`
/// observation; dropping every reference cancels it.
type Ceremony<'r>;

/// The identity of one blocking question. Abstract — only an `Event`
/// can mint one, so an answer can never name a question that was never
/// asked, and two ceremonies' questions can never be confused. It does
/// not keep a cancelled ceremony alive.
type QuestionId;

/// A ceremony event that is not the terminal `Done` — uniformly typed
/// whatever the ceremony computes, so one modal pump can serve every
/// action. Events carrying an `id` are blocking questions — the flow
/// is parked until `answer` resolves that id (or cancels). The rest
/// are presentation: verification codes, progress, notes, warnings.
type Question = [
  `Text({ id: QuestionId, field: FieldInfo, default: [string, null], required: bool }),
  `Secret({ id: QuestionId, field: FieldInfo }),
  `Choice({ id: QuestionId, field: FieldInfo, choices: Array<string>, default: [string, null] }),
  `Confirm({ id: QuestionId, field: FieldInfo, default: bool }),
  `SelectAdminDomain({ id: QuestionId, domains: Array<AdminDomain> }),
  `Announce({ id: QuestionId, title: string, body: string }),
  `AnnounceIdentity({ id: QuestionId, body: string, fp: Fingerprint }),
  `ConfirmIdentity({ id: QuestionId, identity: CaIdentity }),
  `OneTimeSecret({ id: QuestionId, kind: OneTimeSecretKind, password: string }),
  `VerificationCode({ purpose: string, fp: Fingerprint }),
  `ClearVerificationCode,
  `Progress({ stage: Stage, message: string, duration: [duration, null] }),
  `Note(string),
  `Warn(string)
];

/// One event from a ceremony: a `Question`, or the terminal `Done`
/// carrying the ceremony's result.
type Event<'r> = [Question, `Done(Result<'r, AdminError>)];

/// The reply to a blocking question. The answer kind must match the
/// question (`Confirm` answers a `Confirm` or `ConfirmIdentity`, `Ack`
/// an `Announce`/`AnnounceIdentity`/`OneTimeSecret`, `Domain` a
/// `SelectAdminDomain`); `Cancel` aborts the whole ceremony.
type Answer = [
  `Text([string, null]),
  `Secret(string),
  `Choice(string),
  `Confirm(bool),
  `Domain([`Discovered(i64), `Manual, `PollMore]),
  `Ack,
  `Cancel
];

/// Open an authenticated remote-admin session: the security gesture
/// (`ConfirmIdentity`), the admin name, and the password arrive as
/// events unless provided. `#glyph` is a CA fingerprint the operator
/// already confirmed out of band — an identity that matches it is
/// accepted without the gesture, one that doesn't is refused. `Done`
/// carries the session as a `Target`.
val connect: fn(
  ?#admin: [string, null],
  ?#password: [string, null],
  ?#ca_dir: [string, null],
  ?#glyph: [Fingerprint, null],
  server: string
) -> Ceremony<Target>;

/// The ceremony's event stream. Starts the flow on first observation.
/// Keep the observer OUTSIDE sleeping select arms — an event delivered
/// while every observer sleeps is missed, not replayed.
val events: fn(c: Ceremony<'r>) -> Event<'r>;

/// The ceremony's questions and presentation events, without the
/// terminal `Done` — feed these to a shared question pump and read the
/// outcome from `result`. The same observation rules as `events`.
val questions: fn(c: Ceremony<'r>) -> Question;

/// The ceremony's result: fires exactly once, when the flow finishes.
/// Observing it starts the flow, like `events`.
val result: fn(c: Ceremony<'r>) -> Result<'r, AdminError>;

/// Answer the outstanding question `id`. The id routes to its own
/// ceremony, so there is no ceremony argument. Errors (as a value) if
/// the id is stale, the answer kind doesn't match, a required text
/// answer is null, or a choice isn't one of the offered ones — the
/// question stays armed, so re-prompt and answer again.
val answer: fn(id: QuestionId, a: Answer) -> [null, Error<`Admin(string)>];

/// One admin server's push/propagation result. A null error means it
/// was updated.
type PeerResult = { server: string, addr: string, error: [string, null] };

/// A pending enrollment-queue entry, keyed by its code — recomputed
/// locally from the CSR, never trusted from the wire. A null code means
/// the queued CSR doesn't parse; it can only be denied.
type QueueItem = {
  code: [Fingerprint, null],
  kind: string,
  requested_name: string,
  requested_validity: duration,
  age_secs: u64,
  peer: string,
  verified_renewal: bool,
  enroll_listen: [string, null],
  requested_roles: Array<string>,
  cluster_base: [string, null],
  replaces_serial: [u64, null]
};

/// The outcome of approving one request.
type ApproveOutcome = {
  requested_name: string,
  enroll_listen: [string, null],
  id_map_groups: Array<string>,
  warnings: Array<string>
};

/// One verified renewal's result from the code-free batch.
type RenewalResult = { requested_name: string, error: [string, null] };

/// One issued certificate, from the CA's records.
type IssuedEntry = {
  serial: u64,
  name: string,
  spki_fp: string,
  not_after_unix: u64,
  revoked: bool
};

/// The outcome of a revocation.
type RevokeOutcome = {
  revoked: Array<IssuedEntry>,
  warnings: Array<string>,
  operation_id: [string, null],
  peers: Array<PeerResult>
};

/// A pending delegation request from a child resolver hierarchy.
type PendingDelegation = {
  code: Fingerprint,
  proposed_path: string,
  parent_base: string,
  child_base: string,
  parent: Array<string>,
  child: Array<string>,
  approved: bool,
  age_secs: u64,
  peer: string
};

/// The outcome of approving a delegation.
type DelegationDecision = { proposed_path: string, peers: Array<PeerResult> };

/// One registered admin server.
type ServerInfo = {
  id: string,
  addr: string,
  roles: Array<string>,
  state: string,
  resolver: [string, null],
  cluster_base: [string, null],
  cluster_state: [string, null],
  ca: bool,
  read_gate: string
};

/// The outcome of removing a server from the admin domain.
type RemoveServerOutcome = {
  version: u64,
  operation_id: [string, null],
  revoked: u64,
  removed: bool,
  affected_clusters: Array<string>,
  peers: Array<PeerResult>,
  crl_peers: Array<PeerResult>,
  gated: [PeerResult, null]
};

/// The outcome of a CA-wide reconcile push.
type ReconcileOutcome = { operation: string, peers: Array<PeerResult> };

/// One identity in the id-map.
type Identity = { name: string, primary_group: string, groups: Array<string> };

/// The id-map as the CA holds it.
type IdMap = {
  default_group: [string, null],
  groups: Array<string>,
  identities: Array<Identity>
};

/// A recorded CA state edit: the version it produced and whether it
/// changed anything (asking for something already true is not an error).
type RecordedEdit = { version: u64, changed: bool };

/// A netidx admin server discovered on the local network via mDNS. A
/// display hint only — nothing security-relevant is decided from it.
type Discovered = {
  addrs: Array<string>,
  port: u16,
  domain: string,
  roles: Array<string>,
  fp_short: string
};

/// The pending enrollment queue, each row keyed by its code. Requires
/// a connected (remote) target; re-list per `t` delivery.
val list_queue: fn(t: Target) -> Ceremony<Array<QueueItem>>;

/// Approve the queued request whose recomputed code matches. Passing
/// `#groups` skips the id-map-groups question; a server enrollment or
/// `#no_id_map` forces empty groups.
val approve: fn(
  ?#groups: [Array<string>, null],
  ?#no_id_map: [bool, null],
  #code: string,
  t: Target
) -> Ceremony<ApproveOutcome>;

/// Approve every verified renewal — code-free by construction (a
/// verified renewal is cryptographic proof of possession).
val approve_renewals: fn(t: Target) -> Ceremony<Array<RenewalResult>>;

/// Deny the queued request whose code matches; returns the denied name.
val deny: fn(?#reason: [string, null], #code: string, t: Target) -> Ceremony<string>;

/// The CA's issued certificates.
val issued: fn(
  ?#include_revoked: [bool, null],
  ?#name_filter: [string, null],
  t: Target
) -> Ceremony<Array<IssuedEntry>>;

/// Revoke by serial or name. `selector` is a serial number or an
/// identity name; a name that matches several certs with different
/// keys needs `#glyph` to assert which.
val revoke: fn(
  ?#glyph: [string, null],
  ?#reason: [string, null],
  selector: string,
  t: Target
) -> Ceremony<RevokeOutcome>;

/// Pending delegation requests from child resolver hierarchies.
val list_pending_delegations: fn(t: Target) -> Ceremony<Array<PendingDelegation>>;

/// Approve the pending delegation whose code matches.
val approve_delegation: fn(#code: string, t: Target) -> Ceremony<DelegationDecision>;

/// Deny the pending delegation whose code matches.
val deny_delegation: fn(
  ?#reason: [string, null],
  #code: string,
  t: Target
) -> Ceremony<PendingDelegation>;

/// Every registered admin server.
val list_servers: fn(t: Target) -> Ceremony<Array<ServerInfo>>;

/// Remove a server from the admin domain by its id (revokes its certs
/// and pushes the removal domain-wide).
val remove_server: fn(id: string, t: Target) -> Ceremony<RemoveServerOutcome>;

/// Push the CA's state to every registered server.
val reconcile_ca: fn(t: Target) -> Ceremony<ReconcileOutcome>;

/// Change the authenticated admin's own password. With `#new_password`
/// null the ceremony asks for it (and its confirmation). The credential
/// the target was opened with is gone afterwards — connect again.
val change_password: fn(?#new_password: [string, null], t: Target) -> Ceremony<null>;

/// Change an admin's password from scratch — the route when `connect`
/// fails with `PasswordChangeRequired`: the CA refuses every session
/// but the one that replaces a reset password, so there is no `Target`
/// to hand `change_password`. The identity gesture (unless `#glyph`
/// matches), the admin name, the current password, and the new one
/// twice arrive as events unless provided. Connect again afterwards.
val change_password_at: fn(
  ?#admin: [string, null],
  ?#password: [string, null],
  ?#ca_dir: [string, null],
  ?#glyph: [Fingerprint, null],
  ?#new_password: [string, null],
  server: string
) -> Ceremony<null>;

/// Resolver cluster base paths known to the CA.
val list_resolver_clusters: fn(t: Target) -> Result<Array<string>, AdminError>;

/// The id-map as the CA holds it.
val show_id_map: fn(t: Target) -> Result<IdMap, AdminError>;

/// Create a group.
val id_map_add_group: fn(name: string, t: Target) -> Result<RecordedEdit, AdminError>;

/// Remove a group.
val id_map_remove_group: fn(name: string, t: Target) -> Result<RecordedEdit, AdminError>;

/// Register an identity with a primary group (and optional extra
/// groups).
val id_map_add_user: fn(
  ?#groups: [Array<string>, null],
  san: string,
  primary_group: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Remove an identity.
val id_map_remove_user: fn(san: string, t: Target) -> Result<RecordedEdit, AdminError>;

/// Add an identity to a group.
val id_map_add_member: fn(
  san: string,
  group: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Remove an identity from a group.
val id_map_remove_member: fn(
  san: string,
  group: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Mint a role admin with the given policy. Returns the ONE-TIME
/// password — shown once, never persisted; convey it to its owner.
val add_role_admin: fn(
  name: string,
  policy: Policy,
  t: Target
) -> Result<string, AdminError>;

/// Reset an admin's password. Returns the ONE-TIME replacement password.
val reset_password: fn(name: string, t: Target) -> Result<string, AdminError>;

/// Replace an admin's policy.
val set_admin_policy: fn(
  name: string,
  policy: Policy,
  t: Target
) -> Result<null, AdminError>;

/// Remove an admin's keyslot.
val remove_admin: fn(name: string, t: Target) -> Result<null, AdminError>;

/// Browse the local network for admin servers (mDNS). One shot per
/// `trigger` delivery; `#timeout` defaults to 2 seconds.
val discover: fn(
  ?#timeout: [duration, null],
  trigger: Any
) -> Result<Array<Discovered>, AdminError>;

mod tui;
