/// The error union every admin operation can fail with.
/// `PasswordChangeRequired` is its own variant because frontends route
/// on it (open the change-password flow); the payload is the admin name.
/// `Unsupported` is a unix-only operation invoked on another platform.
type AdminError = [
  `Admin(string),
  `PasswordChangeRequired(string),
  `Unsupported(string)
];

/// A grouped-base32 SPKI fingerprint: the out-of-band code operators
/// relay and match. `code` is the full grouped text an operator reads
/// out; `short` is the abbreviated display form.
type Fingerprint = { code: string, short: string };

/// How one piece of a server's state compares to what the CA recorded.
type Agreement = [
  `Current({ version: u64 }),
  `Behind({ reported: [u64, null], want: u64 }),
  `Unrecorded,
  `Ahead({ reported: u64, ca: u64 })
];

/// One server's agreement with the CA, per kind of state. A null
/// agreement means that kind of state doesn't apply to this server.
type ServerDrift = {
  server: string,
  addr: string,
  perms: [Agreement, null],
  id_map: [Agreement, null],
  config: [Agreement, null],
  config_drift: bool
};

/// Whether an admin keyslot can recover the CA key (`Signing`) or only
/// authenticate a scoped role admin (`Role`).
type SlotKind = [`Signing, `Role];

/// What the admin server will do on an admin's behalf. Roles are
/// named `Ca`, `Resolver`, or `IdMap`.
type Policy = {
  allowed_san: Array<string>,
  max_validity: duration,
  id_map_groups: Array<string>,
  server_enroll_scopes: Array<string>,
  server_enroll_roles: Array<string>,
  perms_edit_scopes: Array<string>,
  may_manage_admins: bool,
  service_control_scopes: Array<string>
};

/// One admin keyslot's public facts, from the roster.
type AdminInfo = {
  slot_id: string,
  admin: string,
  kind: SlotKind,
  policy: Policy,
  must_change: bool
};

/// Which admin server an operation talks to: this host's own (over its
/// local control socket) or an authenticated remote session.
type Target;

/// This host's own admin server as a target, over its local control
/// socket (unix only). Discovers the admin-server config when
/// `#cfg_path` is null. Fires per `trigger` delivery.
val local: fn(?#cfg_path: [string, null], trigger: Any) -> Result<Target, AdminError>;

/// Every registered server's agreement with the CA, in stable server-id
/// order. Re-queries per `t` delivery — sample to refresh:
/// `drift(tick ~ t)`.
val drift: fn(t: Target) -> Result<Array<ServerDrift>, AdminError>;

/// The admin roster: every keyslot's public facts.
val list_admins: fn(t: Target) -> Result<Array<AdminInfo>, AdminError>;

/// Parse and normalize a fingerprint code an operator typed. The
/// returned `code` is the canonical grouped form.
val parse_fingerprint: fn(code: string) -> Result<Fingerprint, `Admin(string)>;

/// The fingerprint's 8x8 identicon as data: which cells are set, and
/// the (deterministic) color. Rendering is the frontend's job.
val identicon: fn(fp: Fingerprint) -> Result<{cells: Array<Array<bool>>, color: {r: u8, g: u8, b: u8}}, `Admin(string)>;

/// The confirmed identity of an admin server's CA: what the operator
/// verifies out of band before anything is trusted.
type CaIdentity = {
  fingerprint: Fingerprint,
  domain: string,
  roles: Array<string>,
  server_id: string,
  ca: bool
};

/// A netidx admin domain discovered on the local network.
type AdminDomain = { domain: string, identity: CaIdentity };

/// What a target is: this host's own admin server (its config path),
/// or a remote session — the server address, the admin it
/// authenticates, and the CA identity the operator confirmed.
/// Presentation data for a title or a status line.
type TargetInfo = [
  `Local({ cfg_path: string }),
  `Remote({ server: string, admin: string, identity: CaIdentity })
];

/// Describe a target.
val info: fn(t: Target) -> TargetInfo;

/// The presentation descriptor of a question: the CLI flag a script
/// would pass (the question's stable identity), a short label, and
/// newcomer-actionable help.
type FieldInfo = { flag: string, label: string, help: string };

/// The phase a long-running step is in.
type Stage = [`Discovering, `Enrolling, `WaitingApproval, `Applying, `Done];

/// Which shown-once secret a `OneTimeSecret` event presents. The
/// payload of `AdminPassword` is the admin's name.
type OneTimeSecretKind = [`CaRecovery, `AdminPassword(string)];

/// A running interactive admin flow. Inert until the first `events`
/// observation; dropping every reference cancels it.
type Ceremony<'r>;

/// The identity of one blocking question. Abstract — only an `Event`
/// can mint one, so an answer can never name a question that was never
/// asked, and two ceremonies' questions can never be confused. It does
/// not keep a cancelled ceremony alive.
type QuestionId;

/// A ceremony event that is not the terminal `Done` — uniformly typed
/// whatever the ceremony computes, so one modal pump can serve every
/// action. Events carrying an `id` are blocking questions — the flow
/// is parked until `answer` resolves that id (or cancels). The rest
/// are presentation: verification codes, progress, notes, warnings.
type Question = [
  `Text({ id: QuestionId, field: FieldInfo, default: [string, null], required: bool }),
  `Secret({ id: QuestionId, field: FieldInfo }),
  `Choice({ id: QuestionId, field: FieldInfo, choices: Array<string>, default: [string, null] }),
  `Confirm({ id: QuestionId, field: FieldInfo, default: bool }),
  `SelectAdminDomain({ id: QuestionId, domains: Array<AdminDomain> }),
  `Announce({ id: QuestionId, title: string, body: string }),
  `AnnounceIdentity({ id: QuestionId, body: string, fp: Fingerprint }),
  `ConfirmIdentity({ id: QuestionId, identity: CaIdentity }),
  `OneTimeSecret({ id: QuestionId, kind: OneTimeSecretKind, password: string }),
  `VerificationCode({ purpose: string, fp: Fingerprint }),
  `ClearVerificationCode,
  `Progress({ stage: Stage, message: string, duration: [duration, null] }),
  `Note(string),
  `Warn(string)
];

/// One event from a ceremony: a `Question`, or the terminal `Done`
/// carrying the ceremony's result.
type Event<'r> = [Question, `Done(Result<'r, AdminError>)];

/// The reply to a blocking question. The answer kind must match the
/// question (`Confirm` answers a `Confirm` or `ConfirmIdentity`, `Ack`
/// an `Announce`/`AnnounceIdentity`/`OneTimeSecret`, `Domain` a
/// `SelectAdminDomain`); `Cancel` aborts the whole ceremony.
type Answer = [
  `Text([string, null]),
  `Secret(string),
  `Choice(string),
  `Confirm(bool),
  `Domain([`Discovered(i64), `Manual, `PollMore]),
  `Ack,
  `Cancel
];

/// Open an authenticated remote-admin session: the security gesture
/// (`ConfirmIdentity`), the admin name, and the password arrive as
/// events unless provided. `#glyph` is a CA fingerprint the operator
/// already confirmed out of band — an identity that matches it is
/// accepted without the gesture, one that doesn't is refused. `Done`
/// carries the session as a `Target`.
val connect: fn(
  ?#admin: [string, null],
  ?#password: [string, null],
  ?#ca_dir: [string, null],
  ?#glyph: [Fingerprint, null],
  server: string
) -> Ceremony<Target>;

/// The ceremony's event stream. Starts the flow on first observation.
/// Keep the observer OUTSIDE sleeping select arms — an event delivered
/// while every observer sleeps is missed, not replayed.
val events: fn(c: Ceremony<'r>) -> Event<'r>;

/// The ceremony's questions and presentation events, without the
/// terminal `Done` — feed these to a shared question pump and read the
/// outcome from `result`. The same observation rules as `events`.
val questions: fn(c: Ceremony<'r>) -> Question;

/// The ceremony's result: fires exactly once, when the flow finishes.
/// Observing it starts the flow, like `events`.
val result: fn(c: Ceremony<'r>) -> Result<'r, AdminError>;

/// Answer the outstanding question `id`. The id routes to its own
/// ceremony, so there is no ceremony argument. Errors (as a value) if
/// the id is stale, the answer kind doesn't match, a required text
/// answer is null, or a choice isn't one of the offered ones — the
/// question stays armed, so re-prompt and answer again.
val answer: fn(id: QuestionId, a: Answer) -> [null, Error<`Admin(string)>];

/// One admin server's push/propagation result. A null error means it
/// was updated.
type PeerResult = { server: string, addr: string, error: [string, null] };

/// A pending enrollment-queue entry, keyed by its code — recomputed
/// locally from the CSR, never trusted from the wire. A null code means
/// the queued CSR doesn't parse; it can only be denied.
type QueueItem = {
  code: [Fingerprint, null],
  kind: string,
  requested_name: string,
  requested_validity: duration,
  age_secs: u64,
  peer: string,
  verified_renewal: bool,
  enroll_listen: [string, null],
  requested_roles: Array<string>,
  cluster_base: [string, null],
  replaces_serial: [u64, null]
};

/// The outcome of approving one request.
type ApproveOutcome = {
  requested_name: string,
  enroll_listen: [string, null],
  id_map_groups: Array<string>,
  warnings: Array<string>
};

/// One verified renewal's result from the code-free batch.
type RenewalResult = { requested_name: string, error: [string, null] };

/// One issued certificate, from the CA's records.
type IssuedEntry = {
  serial: u64,
  name: string,
  spki_fp: string,
  not_after_unix: u64,
  revoked: bool
};

/// The outcome of a revocation.
type RevokeOutcome = {
  revoked: Array<IssuedEntry>,
  warnings: Array<string>,
  operation_id: [string, null],
  peers: Array<PeerResult>
};

/// A pending delegation request from a child resolver hierarchy.
type PendingDelegation = {
  code: Fingerprint,
  proposed_path: string,
  parent_base: string,
  child_base: string,
  parent: Array<string>,
  child: Array<string>,
  approved: bool,
  age_secs: u64,
  peer: string
};

/// The outcome of approving a delegation.
type DelegationDecision = { proposed_path: string, peers: Array<PeerResult> };

/// A resolver member's read gate as it reports it: answering read
/// clients, refusing them until an admin opens the gate, or refusing
/// them until an instant (a member that joined a serving cluster
/// waits for publishers to find it).
type ReadGate = [`Open, `Shut, `Until(datetime)];

/// One registered admin server. `read_gate` is null for a server that
/// runs no resolver or has not reported yet.
type ServerInfo = {
  id: string,
  addr: string,
  roles: Array<string>,
  state: string,
  resolver: [string, null],
  cluster_base: [string, null],
  cluster_state: [string, null],
  ca: bool,
  read_gate: [ReadGate, null]
};

/// The outcome of removing a server from the admin domain.
type RemoveServerOutcome = {
  version: u64,
  operation_id: [string, null],
  revoked: u64,
  removed: bool,
  affected_clusters: Array<string>,
  peers: Array<PeerResult>,
  crl_peers: Array<PeerResult>,
  gated: [PeerResult, null]
};

/// The outcome of a CA-wide reconcile push.
type ReconcileOutcome = { operation: string, peers: Array<PeerResult> };

/// One identity in the id-map.
type Identity = { name: string, primary_group: string, groups: Array<string> };

/// The id-map as the CA holds it.
type IdMap = {
  default_group: [string, null],
  groups: Array<string>,
  identities: Array<Identity>
};

/// A recorded CA state edit: the version it produced and whether it
/// changed anything (asking for something already true is not an error).
type RecordedEdit = { version: u64, changed: bool };

/// A netidx admin server discovered on the local network via mDNS. A
/// display hint only — nothing security-relevant is decided from it.
type Discovered = {
  addrs: Array<string>,
  port: u16,
  domain: string,
  roles: Array<string>,
  fp_short: string
};

/// The pending enrollment queue, each row keyed by its code. Requires
/// a connected (remote) target; re-list per `t` delivery.
val list_queue: fn(t: Target) -> Ceremony<Array<QueueItem>>;

/// Approve the queued request whose recomputed code matches. Passing
/// `#groups` skips the id-map-groups question; a server enrollment or
/// `#no_id_map` forces empty groups.
val approve: fn(
  ?#groups: [Array<string>, null],
  ?#no_id_map: [bool, null],
  #code: string,
  t: Target
) -> Ceremony<ApproveOutcome>;

/// Approve every verified renewal — code-free by construction (a
/// verified renewal is cryptographic proof of possession).
val approve_renewals: fn(t: Target) -> Ceremony<Array<RenewalResult>>;

/// Deny the queued request whose code matches; returns the denied name.
val deny: fn(?#reason: [string, null], #code: string, t: Target) -> Ceremony<string>;

/// The CA's issued certificates.
val issued: fn(
  ?#include_revoked: [bool, null],
  ?#name_filter: [string, null],
  t: Target
) -> Ceremony<Array<IssuedEntry>>;

/// Revoke by serial or name. `selector` is a serial number or an
/// identity name; a name that matches several certs with different
/// keys needs `#glyph` to assert which.
val revoke: fn(
  ?#glyph: [string, null],
  ?#reason: [string, null],
  selector: string,
  t: Target
) -> Ceremony<RevokeOutcome>;

/// Pending delegation requests from child resolver hierarchies.
val list_pending_delegations: fn(t: Target) -> Ceremony<Array<PendingDelegation>>;

/// Approve the pending delegation whose code matches.
val approve_delegation: fn(#code: string, t: Target) -> Ceremony<DelegationDecision>;

/// Deny the pending delegation whose code matches.
val deny_delegation: fn(
  ?#reason: [string, null],
  #code: string,
  t: Target
) -> Ceremony<PendingDelegation>;

/// Every registered admin server.
val list_servers: fn(t: Target) -> Ceremony<Array<ServerInfo>>;

/// Remove a server from the admin domain by its id (revokes its certs
/// and pushes the removal domain-wide).
val remove_server: fn(id: string, t: Target) -> Ceremony<RemoveServerOutcome>;

/// Push the CA's state to every registered server.
val reconcile_ca: fn(t: Target) -> Ceremony<ReconcileOutcome>;

/// Open or shut one resolver member's read gate. `ShutFor` shuts it
/// now and opens it that long from now. The ceremony warns (a `Warn`
/// event) about what the change risks, given the member's current gate.
val set_read_gate: fn(
  #server: string,
  gate: [ReadGate, `ShutFor(duration)],
  t: Target
) -> Ceremony<null>;

/// One admin server whose activation units the operator can control:
/// its id (what a control op targets), its address, its resolver
/// cluster's base path (the authorization scope), and its roles.
type ServiceServer = { id: string, addr: string, base: string, roles: Array<string> };

/// A unit's run state as its supervisor reports it.
type UnitState = [`NotStarted, `Running([u32, null]), `Stopped, `Died];

/// The display fields of a unit's definition.
type ServiceUnitDef = { exe: string, args: Array<string>, trigger: string, restart: string };

/// One activation unit on a server, with its definition when the
/// supervisor has one on disk for it.
type ServiceUnit = {
  unit: string,
  state: UnitState,
  definition: [ServiceUnitDef, null]
};

/// A service-control operation. `Status` changes nothing and lists.
type ServiceOp = [`Start, `Stop, `Restart, `Status];

/// Every registered admin server running a resolver, from the CA's
/// map — the pick list for service control.
val list_service_servers: fn(t: Target) -> Ceremony<Array<ServiceServer>>;

/// Apply `#op` to `#units` (empty: every unit) on the admin server
/// `#server`, and return that server's per-unit states. The CA
/// enforces the caller's service-control scopes.
val service_control: fn(
  #units: Array<string>,
  #op: ServiceOp,
  #server: string,
  t: Target
) -> Ceremony<Array<ServiceUnit>>;

/// One permission entry: the entity's permission bits at a path.
type PermEntry = { path: string, entity: string, bits: string };

/// The permissions of the resolver cluster mounted at `#at`, one entry
/// per (path, entity), sorted.
val show_perms: fn(#at: string, t: Target) -> Result<Array<PermEntry>, AdminError>;

/// Set (insert or replace) an entity's permission bits at a path in
/// the cluster mounted at `#at`.
val set_perm: fn(
  #at: string,
  #path: string,
  #entity: string,
  #bits: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Remove an entity's entry at a path. An entry that was already
/// absent is reported (`changed: false`), not refused.
val remove_perm: fn(
  #at: string,
  #path: string,
  #entity: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Change the authenticated admin's own password. With `#new_password`
/// null the ceremony asks for it (and its confirmation). The credential
/// the target was opened with is gone afterwards — connect again.
val change_password: fn(?#new_password: [string, null], t: Target) -> Ceremony<null>;

/// Change an admin's password from scratch — the route when `connect`
/// fails with `PasswordChangeRequired`: the CA refuses every session
/// but the one that replaces a reset password, so there is no `Target`
/// to hand `change_password`. The identity gesture (unless `#glyph`
/// matches), the admin name, the current password, and the new one
/// twice arrive as events unless provided. Connect again afterwards.
val change_password_at: fn(
  ?#admin: [string, null],
  ?#password: [string, null],
  ?#ca_dir: [string, null],
  ?#glyph: [Fingerprint, null],
  ?#new_password: [string, null],
  server: string
) -> Ceremony<null>;

/// Resolver cluster base paths known to the CA.
val list_resolver_clusters: fn(t: Target) -> Result<Array<string>, AdminError>;

/// The id-map as the CA holds it.
val show_id_map: fn(t: Target) -> Result<IdMap, AdminError>;

/// Create a group.
val id_map_add_group: fn(name: string, t: Target) -> Result<RecordedEdit, AdminError>;

/// Remove a group.
val id_map_remove_group: fn(name: string, t: Target) -> Result<RecordedEdit, AdminError>;

/// Register an identity with a primary group (and optional extra
/// groups).
val id_map_add_user: fn(
  ?#groups: [Array<string>, null],
  san: string,
  primary_group: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Remove an identity.
val id_map_remove_user: fn(san: string, t: Target) -> Result<RecordedEdit, AdminError>;

/// Add an identity to a group.
val id_map_add_member: fn(
  san: string,
  group: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Remove an identity from a group.
val id_map_remove_member: fn(
  san: string,
  group: string,
  t: Target
) -> Result<RecordedEdit, AdminError>;

/// Mint a role admin with the given policy. Returns the ONE-TIME
/// password — shown once, never persisted; convey it to its owner.
val add_role_admin: fn(
  name: string,
  policy: Policy,
  t: Target
) -> Result<string, AdminError>;

/// Reset an admin's password. Returns the ONE-TIME replacement password.
val reset_password: fn(name: string, t: Target) -> Result<string, AdminError>;

/// Replace an admin's policy.
val set_admin_policy: fn(
  name: string,
  policy: Policy,
  t: Target
) -> Result<null, AdminError>;

/// Remove an admin's keyslot.
val remove_admin: fn(name: string, t: Target) -> Result<null, AdminError>;

/// Browse the local network for admin servers (mDNS). One shot per
/// `trigger` delivery; `#timeout` defaults to 2 seconds.
val discover: fn(
  ?#timeout: [duration, null],
  trigger: Any
) -> Result<Array<Discovered>, AdminError>;

/// One admin domain a discovery pass heard from: the servers that
/// advertised it, and its CA identity fetched from them — or why that
/// failed (`identity` null, `error` set), which is the beacon of a
/// server this host cannot reach.
type DomainReport = {
  domain: string,
  servers: Array<string>,
  identity: [CaIdentity, null],
  error: [string, null]
};

/// What a discovery pass found. `diagnosis` is non-empty exactly when
/// something answered and none of it verified — the lines explain why,
/// for an operator who would otherwise read it as "nothing found".
type Discovery = { domains: Array<DomainReport>, diagnosis: Array<string> };

/// Browse for admin domains AND verify each one's CA identity — the
/// discovery a landing screen records. One pass per `trigger`;
/// `#timeout` defaults to the discovery window.
val discover_domains: fn(
  ?#timeout: [duration, null],
  trigger: Any
) -> Result<Discovery, AdminError>;

/// The CA identity an admin server presents, fetched without
/// confirming or trusting it — what a saved domain is re-checked
/// against before it is offered. One fetch per `server` delivery; an
/// address that does not answer within `#timeout` (3 seconds) errors.
val identity_at: fn(
  ?#timeout: [duration, null],
  server: string
) -> Result<CaIdentity, AdminError>;

/// The admin domain this host belongs to, from its install record:
/// the domain, its CA fingerprint text, and this host's own admin
/// server address (or the first one it enrolled through). Null on a
/// host with no install record or a standalone one. Re-read per
/// `trigger`.
val local_domain: fn(trigger: Any) -> [{ domain: string, fingerprint: string, addr: [string, null] }, null];

/// Which role template produced an install on this host.
type InstallRole = [`Ca, `Workstation, `Resolver, `Publisher];

/// An install's OS service, as the service manager reports it.
type ServiceState = [`Active, `Inactive, `NotInstalled];

/// Where an install's config and record live: the user's config
/// directory or the system's.
type Scope = [`User, `System];

/// The CA tooling an install owns: its CA directory and the
/// admin-server config serving it (null for an offline CA).
type LocalCa = { ca_dir: string, cfg: [string, null] };

/// One install recorded on this host: its role, base path and
/// data-plane auth, the admin domain it founded or joined (null for a
/// standalone install), every admin server it knows, when it was
/// installed, its OS service's state, its scope and config root, the
/// CA it owns if any, and whether this host holds a TLS identity the
/// admin domain's CA could renew.
type Install = {
  role: InstallRole,
  base: string,
  auth: string,
  admin_domain: [{ domain: string, fingerprint: string }, null],
  admin_servers: Array<string>,
  created_unix: u64,
  service: ServiceState,
  scope: Scope,
  config_dir: string,
  local_ca: [LocalCa, null],
  renewable: bool
};

/// Every install recorded on this host, user scope first. Re-detects
/// per `trigger`.
val installs: fn(trigger: Any) -> Result<Array<Install>, AdminError>;

/// One edit a reconcile with the admin domain would make to this
/// host's configs.
type Change = [`Add(string), `Del(string), `Reauth(string)];

/// How an install's configs compare with the admin domain's map.
type Sync = [`InSync, `OutOfSync(Array<Change>)];

/// Check a joined install's configs against the admin domain — the
/// quiet half of `update`. Re-checks per `role` delivery.
val sync_check: fn(#config_root: string, role: InstallRole) -> Result<Sync, AdminError>;

/// The credential state of a CA this host owns: whether the
/// auto-approve slot exists and is wired into the daemon config,
/// whether the recovery-password slot exists, and whether the CA is
/// signed by an external PKI and has its certificate installed.
type CaCredentials = {
  auto_approve_present: bool,
  auto_approve_wired: bool,
  recovery_present: bool,
  external_signed: bool,
  external_installed: bool
};

/// Read a local CA's credential state — over the daemon's control
/// socket when it runs, from its files otherwise. Re-reads per
/// `ca_dir` delivery. Unix only.
val ca_credentials: fn(#cfg: [string, null], ca_dir: string) -> Result<CaCredentials, AdminError>;

/// The local activation supervisor's unit directory, or null when this
/// host has none. Re-reads per `trigger`.
val units_dir: fn(trigger: Any) -> [string, null];

/// The base path of the resolver this host runs, from its resolver
/// config, or null when it runs none. Re-reads per `trigger`.
val local_resolver_base: fn(trigger: Any) -> [string, null];

/// What starts an activation unit: the supervisor coming up, or a
/// subscription to any of these paths.
type UnitTrigger = [`OnStart, `OnAccess(Array<string>)];

/// What the supervisor does when the unit's process exits: nothing,
/// restart at once, or restart no more often than once per that many
/// seconds.
type UnitRestart = [`No, `Yes, `RateLimited(f64)];

/// The child's environment: the supervisor's with these overrides, or
/// exactly these.
type UnitEnvironment = [
  `Inherit(Array<{ name: string, value: string }>),
  `Replace(Array<{ name: string, value: string }>)
];

/// An activation unit's definition — every field of its `.unit` file.
type UnitDef = {
  exe: string,
  args: Array<string>,
  trigger: UnitTrigger,
  restart: UnitRestart,
  working_directory: [string, null],
  uid: [u32, null],
  gid: [u32, null],
  stdin: [string, null],
  stdout: [string, null],
  stderr: [string, null],
  environment: UnitEnvironment
};

/// One activation unit on this host: its definition on disk and the
/// state its supervisor reports — either side null when only the
/// other knows the unit (a definition the supervisor has not loaded,
/// a unit it reports with no file behind it, or no supervisor at all).
type LocalUnit = {
  name: string,
  state: [UnitState, null],
  definition: [UnitDef, null]
};

/// Every unit this host's unit directory defines or its supervisor
/// runs. Re-lists per `trigger`.
val list_units: fn(#units_dir: string, trigger: Any) -> Result<Array<LocalUnit>, AdminError>;

/// Apply `op` to one unit (`#unit`) or every unit (null) through this
/// host's supervisor; the result is what it reports for them
/// afterwards (definitions null). Errors when no supervisor answers.
val control_units: fn(#units_dir: string, #unit: [string, null], op: ServiceOp) -> Result<Array<LocalUnit>, AdminError>;

/// Write (create or replace) the unit `#name` after checking the
/// whole set for trigger conflicts, and tell a running supervisor to
/// re-read the directory; true when one was listening.
val install_unit: fn(#units_dir: string, #name: string, def: UnitDef) -> Result<bool, AdminError>;

/// Remove the unit `name` and reload; true when a supervisor was
/// listening.
val remove_unit: fn(#units_dir: string, name: string) -> Result<bool, AdminError>;

/// The starter definition a create flow seeds its form with.
val unit_template: fn(trigger: Any) -> UnitDef;

/// What installing a role did: a preview (nothing written), an
/// install, or a CA left waiting for its external PKI's signature. The
/// service is the OS service the role needs registered at that scope,
/// null when none.
type InstallOutcome = [
  `Preview({ service: [Scope, null] }),
  `Installed({ service: [Scope, null] }),
  `CaAwaitingSignature({ csr: string })
];

/// Install a role on this host — the guided flow: its questions
/// arrive as events. `#dry_run` shows the plan and writes nothing.
val install: fn(#role: InstallRole, #dry_run: bool, trigger: Any) -> Ceremony<InstallOutcome>;

/// Graduate this local-only workstation onto an admin domain,
/// enrolling a TLS identity. `#dry_run` previews.
val join: fn(#dry_run: bool, trigger: Any) -> Ceremony<null>;

/// A resolver this host's map offers as a parent: its admin server,
/// its resolver endpoint, and its cluster's base path.
type ParentCandidate = { admin: string, resolver: string, base: string };

/// The parents this resolver could attach under, from its admin
/// domain's map; empty when the map is unreachable. Re-reads per
/// `trigger`.
val parent_candidates: fn(#config_root: string, trigger: Any) -> Result<Array<ParentCandidate>, AdminError>;

/// The subtree this resolver now owns under its parent.
type AddParentOutcome = { proposed_path: string };

/// Attach this resolver under a parent by delegation: `#parent` is the
/// parent's admin-server address (host or host:port); `#resolvers`
/// names the parent resolvers picked from the candidates, or null when
/// the parent is not in this host's map; `#path` is the subtree.
val add_parent: fn(
  #config_root: string,
  #parent: string,
  #resolvers: [Array<string>, null],
  #path: string,
  trigger: Any
) -> Ceremony<AddParentOutcome>;

/// What a finished restore leaves: the role now installed, the OS
/// service it still needs (null when none), and the CA hierarchy
/// reconciliation a relocated resolver forced.
type RestoreOutcome = { role: InstallRole, service: [Scope, null], reconciled: [string, null] };

/// A restore parked between its two steps. Only `restore_stage` mints
/// one; `restore_finish` consumes it.
type Staged;

/// The OS service a restored CA must run under before its co-located
/// identities can re-enroll.
type ServiceIntent = { name: string, for_user: [string, null] };

/// Where a restore stands after staging: finished in one go, or parked
/// until the CA's service is registered at `scope`.
type RestoreStaged = [
  `Finish(RestoreOutcome),
  `ServiceThenFinish({ scope: Scope, service: ServiceIntent, staged: Staged })
];

/// Restore a backup bundle onto this host. With `#bundle` null the
/// ceremony asks for the bundle directory. A bundle with a CA stages,
/// hands back the service the CA needs, and waits for `restore_finish`.
val restore_stage: fn(#bundle: [string, null], trigger: Any) -> Ceremony<RestoreStaged>;

/// Finish a staged restore once its CA's service runs: re-enroll the
/// co-located identities.
val restore_finish: fn(staged: Staged) -> Ceremony<RestoreOutcome>;

/// What an uninstall removed and kept.
type UninstallReport = {
  service_was_installed: bool,
  removed: Array<string>,
  kept: Array<{ path: string, why: string }>,
  ca_destroyed: [string, null]
};

/// What uninstalling did: nothing was installed at that scope; the
/// teardown ran; or an elevated step must run first — the whole
/// teardown, or only the system-scope service a user-scope install
/// registered (uninstall again after it). `argv` is the `netidx`
/// invocation the elevated step runs.
type UninstallOutcome = [
  `Nothing,
  `Removed(UninstallReport),
  `Escalate({ scope: Scope, covers: [`Everything, `SystemServiceOnly], argv: Array<string>, plan: UninstallReport })
];

/// Tear down the install at `#scope` under `#config_dir`: its OS
/// service and its configuration; `#remove_ca` also destroys the CA
/// directory, irreversibly.
val uninstall: fn(#scope: Scope, #config_dir: string, #remove_ca: bool, trigger: Any) -> Ceremony<UninstallOutcome>;

/// A service registration: done in-process (the summary line), or a
/// `netidx` invocation to run privileged — `what` names the step for
/// the operator, `argv` is the invocation, and `name`/`for_user`
/// identify the service to verify afterwards.
type ServiceRegistration = [
  `Registered(string),
  `Privileged({ what: string, argv: Array<string>, name: string, for_user: string })
];

/// Register this host's OS service at `#scope` (`#name` defaults to
/// netidx, `#for_user` to the current user). User scope runs in-process;
/// system scope needs root and the terminal, so it hands back the
/// invocation — run it through `escalate_command` and
/// `tui::run_in_terminal`, then `verify_system_service`.
val install_service: fn(#scope: Scope, #name: [string, null], #for_user: [string, null], trigger: Any) -> Result<ServiceRegistration, AdminError>;

/// A program and its arguments.
type Command = { program: string, args: Array<string> };

/// The command that performs the `netidx` invocation `args` as root on
/// a released terminal: a shell that execs it directly when already
/// root, under sudo when the operator may (a cached credential first,
/// else one prompt), else under su with root's password. Unix only.
val escalate_command: fn(args: Array<string>, trigger: Any) -> Result<Command, AdminError>;

/// Judge a privileged service registration by the service manager's
/// state, not the child's exit code: only a running service is success.
/// `code` is the child's exit code; the result is the summary line.
val verify_system_service: fn(#name: string, #for_user: string, code: i64) -> Result<string, AdminError>;

/// What one renewal pass did: a one-line summary (null when nothing
/// was due), the certificates renewed, those awaiting an admin's
/// approval, and those that failed with why.
type RenewReport = {
  summary: [string, null],
  renewed: Array<string>,
  awaiting_approval: Array<string>,
  failed: Array<{ cert: string, why: string }>
};

/// Renew this host's TLS certificates from the admin domain's CA now.
val renew: fn(trigger: Any) -> Ceremony<RenewReport>;

/// What `update` did: nothing, or the edits it applied with the
/// reconcile's warnings and what must be restarted for them to take
/// effect.
type UpdateOutcome = [
  `UpToDate,
  `Applied({ changes: Array<Change>, warnings: Array<string>, restart_hint: string })
];

/// Reconcile a joined install's configs with the admin domain's map
/// and apply the edits.
val update: fn(#config_root: string, role: InstallRole) -> Ceremony<UpdateOutcome>;

/// A backup bundle as written.
type BackupOutcome = {
  target: string,
  role: InstallRole,
  components: Array<string>,
  files: u64,
  bytes: u64,
  identities_to_reenroll: u64,
  manifest_sha256: string
};

/// Back up the complete managed installation at `#config_root`. With
/// `#target` null the ceremony asks where to write the bundle.
val backup: fn(#config_root: string, #target: [string, null], scope: Scope) -> Ceremony<BackupOutcome>;

/// How an offline auto-approve setup wired the credential into the
/// CA's config.
type AutorenewWiring = [`Updated(string), `NoCaConfig, `Failed(string)];

/// What `auto_approve` did: the running daemon swapped the credential
/// in place, or it was minted offline.
type AutoApproveOutcome = [
  `HotSwapped({ warning: [string, null] }),
  `Offline({ rotate: bool, keytab: string, wiring: AutorenewWiring })
];

/// Enable (or with `#rotate` true, rotate) the local CA's auto-approve
/// credential, which lets its admin server renew the admin domain's
/// certificates without an admin approving each one. Unix only.
val auto_approve: fn(#rotate: bool, #cfg: [string, null], ca_dir: string) -> Ceremony<AutoApproveOutcome>;

/// Whether the recovery password was minted by the running daemon or
/// offline. The password itself arrives as a `OneTimeSecret` event.
type RecoveryRotateOutcome = [`HotSwapped, `Offline];

/// Mint a fresh CA recovery password, retiring the old one. Unix only.
val recovery_rotate: fn(#cfg: [string, null], ca_dir: string) -> Ceremony<RecoveryRotateOutcome>;

/// Write a subordinate-CA CSR for the external PKI to sign; the result
/// is the CSR's path. Unix only.
val external_csr: fn(ca_dir: string) -> Ceremony<string>;

/// What installing an externally-signed certificate did: the CA's
/// first install (its admin server is configured at `cfg_path` and
/// needs an OS service at `service_scope` when not null), an offline
/// CA's, a renewal the stopped daemon serves at its next start, or a
/// renewal the running daemon took in place.
type ExternalInstallOutcome = [
  `FirstInstall({ cfg_path: string, service_scope: [Scope, null] }),
  `OfflineCa,
  `Renewal,
  `HotRenewed({ ca_fingerprint: string })
];

/// Install the externally-signed CA certificate the PKI returned. With
/// `#signed` null the ceremony asks for its path (and for the PKI's
/// root certificate, optional). Unix only.
val external_install: fn(#signed: [string, null], #root: [string, null], ca_dir: string) -> Ceremony<ExternalInstallOutcome>;

mod tui;
