let drift = |t: Target| -> Result<Array<ServerDrift>, AdminError> 'netidx_admin_drift;
let list = |t: Target| -> Result<Ceremony<Array<ServerInfo>>, AdminError> 'netidx_admin_list_servers;
let remove = |id: string, t: Target| -> Result<Ceremony<RemoveServerOutcome>, AdminError> 'netidx_admin_remove_server;
let reconcile_ca = |t: Target| -> Result<Ceremony<ReconcileOutcome>, AdminError> 'netidx_admin_reconcile_ca;
let set_read_gate = |#server: string, gate: [ReadGate, `ShutFor(duration)], t: Target| -> Result<Ceremony<null>, AdminError> 'netidx_admin_set_read_gate;
let list_pending_delegations = |t: Target| -> Result<Ceremony<Array<PendingDelegation>>, AdminError> 'netidx_admin_list_pending_delegations;
let approve_delegation = |#code: string, t: Target| -> Result<Ceremony<DelegationDecision>, AdminError> 'netidx_admin_approve_delegation;
let deny_delegation = |#reason: [string, null] = null, #code: string, t: Target| -> Result<Ceremony<PendingDelegation>, AdminError> 'netidx_admin_deny_delegation;
let list_service_servers = |t: Target| -> Result<Ceremony<Array<ServiceServer>>, AdminError> 'netidx_admin_list_service_servers;
let service_control = |#units: Array<string>, #op: ServiceOp, #server: string, t: Target| -> Result<Ceremony<Array<ServiceUnit>>, AdminError> 'netidx_admin_service_control
