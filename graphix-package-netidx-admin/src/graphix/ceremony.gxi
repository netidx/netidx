use super::{AdminDomain, AdminError, CaIdentity, Fingerprint};

/// The presentation descriptor of a question: the CLI flag a script
/// would pass (the question's stable identity), a short label, and
/// newcomer-actionable help.
type FieldInfo = { flag: string, label: string, help: string };

/// The phase a long-running step is in.
type Stage = [`Discovering, `Enrolling, `WaitingApproval, `Applying, `Done];

/// Which shown-once secret a `OneTimeSecret` event presents. The
/// payload of `AdminPassword` is the admin's name.
type OneTimeSecretKind = [`CaRecovery, `AdminPassword(string)];

/// A running interactive admin flow. Inert until the first `events`
/// observation; dropping every reference cancels it.
type Ceremony<'r>;

/// The identity of one blocking question. Abstract — only an `Event`
/// can mint one, so an answer can never name a question that was never
/// asked, and two ceremonies' questions can never be confused. It does
/// not keep a cancelled ceremony alive.
type QuestionId;

/// A ceremony event that is not the terminal `Done` — uniformly typed
/// whatever the ceremony computes, so one modal pump can serve every
/// action. Events carrying an `id` are blocking questions — the flow
/// is parked until `answer` resolves that id (or cancels). The rest
/// are presentation: verification codes, progress, notes, warnings.
type Question = [
  `Text({ id: QuestionId, field: FieldInfo, default: [string, null], required: bool }),
  `Secret({ id: QuestionId, field: FieldInfo }),
  `Choice({ id: QuestionId, field: FieldInfo, choices: Array<string>, default: [string, null] }),
  `Confirm({ id: QuestionId, field: FieldInfo, default: bool }),
  `SelectAdminDomain({ id: QuestionId, domains: Array<AdminDomain> }),
  `Announce({ id: QuestionId, title: string, body: string }),
  `AnnounceIdentity({ id: QuestionId, body: string, fp: Fingerprint }),
  `ConfirmIdentity({ id: QuestionId, identity: CaIdentity }),
  `OneTimeSecret({ id: QuestionId, kind: OneTimeSecretKind, password: string }),
  `VerificationCode({ purpose: string, fp: Fingerprint }),
  `ClearVerificationCode,
  `Progress({ stage: Stage, message: string, duration: [duration, null] }),
  `Note(string),
  `Warn(string)
];

/// One event from a ceremony: a `Question`, or the terminal `Done`
/// carrying the ceremony's result.
type Event<'r> = [Question, `Done(Result<'r, AdminError>)];

/// The reply to a blocking question. The answer kind must match the
/// question (`Confirm` answers a `Confirm` or `ConfirmIdentity`, `Ack`
/// an `Announce`/`AnnounceIdentity`/`OneTimeSecret`, `Domain` a
/// `SelectAdminDomain`); `Cancel` aborts the whole ceremony.
type Answer = [
  `Text([string, null]),
  `Secret(string),
  `Choice(string),
  `Confirm(bool),
  `Domain([`Discovered(i64), `Manual, `PollMore]),
  `Ack,
  `Cancel
];

/// The ceremony's event stream. Starts the flow on first observation.
/// Keep the observer OUTSIDE sleeping select arms — an event delivered
/// while every observer sleeps is missed, not replayed.
val events: fn(c: Ceremony<'r>) -> Event<'r>;

/// The ceremony's questions and presentation events, without the
/// terminal `Done` — feed these to a shared question pump and read the
/// outcome from `result`. The same observation rules as `events`.
val questions: fn(c: Ceremony<'r>) -> Question;

/// The ceremony's result: fires exactly once, when the flow finishes.
/// Observing it starts the flow, like `events`.
val result: fn(c: Ceremony<'r>) -> Result<'r, AdminError>;

/// Answer the outstanding question `id`. The id routes to its own
/// ceremony, so there is no ceremony argument. Errors (as a value) if
/// the id is stale, the answer kind doesn't match, a required text
/// answer is null, or a choice isn't one of the offered ones — the
/// question stays armed, so re-prompt and answer again.
val answer: fn(id: QuestionId, a: Answer) -> [null, Error<`Admin(string)>];
