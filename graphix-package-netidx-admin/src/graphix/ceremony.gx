let events = |c: Ceremony<'r>| -> Event<'r> 'netidx_admin_events;
let started = |c: Result<Ceremony<'r>, AdminError>| -> Ceremony<'r> select c {
  error as _ => never(),
  c => c
};
let questions = |c: Result<Ceremony<'r>, AdminError>| -> Question select events(started(c)) {
  `Done(_) => never(),
  `Text(q) => `Text(q),
  `Secret(q) => `Secret(q),
  `Choice(q) => `Choice(q),
  `Confirm(q) => `Confirm(q),
  `SelectAdminDomain(q) => `SelectAdminDomain(q),
  `Announce(q) => `Announce(q),
  `AnnounceIdentity(q) => `AnnounceIdentity(q),
  `ConfirmIdentity(q) => `ConfirmIdentity(q),
  `OneTimeSecret(q) => `OneTimeSecret(q),
  `VerificationCode(q) => `VerificationCode(q),
  `ClearVerificationCode => `ClearVerificationCode,
  `Progress(q) => `Progress(q),
  `Note(s) => `Note(s),
  `Warn(s) => `Warn(s)
};
let result = |c: Result<Ceremony<'r>, AdminError>| -> Result<'r, AdminError> any(
  select c { error as e => e, _ => never() },
  select events(started(c)) { `Done(r) => r, _ => never() }
);
let answer = |id: QuestionId, a: Answer| -> [null, Error<`Admin(string)>] 'netidx_admin_answer
