let events = |c: Ceremony<'r>| -> Event<'r> 'netidx_admin_events;
let questions = |c: Ceremony<'r>| -> Question select events(c) {
  `Done(_) => never(),
  `Text(q) => `Text(q),
  `Secret(q) => `Secret(q),
  `Choice(q) => `Choice(q),
  `Confirm(q) => `Confirm(q),
  `SelectAdminDomain(q) => `SelectAdminDomain(q),
  `Announce(q) => `Announce(q),
  `AnnounceIdentity(q) => `AnnounceIdentity(q),
  `ConfirmIdentity(q) => `ConfirmIdentity(q),
  `OneTimeSecret(q) => `OneTimeSecret(q),
  `VerificationCode(q) => `VerificationCode(q),
  `ClearVerificationCode => `ClearVerificationCode,
  `Progress(q) => `Progress(q),
  `Note(s) => `Note(s),
  `Warn(s) => `Warn(s)
};
let result = |c: Ceremony<'r>| -> Result<'r, AdminError> select events(c) {
  `Done(r) => r,
  _ => never()
};
let answer = |id: QuestionId, a: Answer| -> [null, Error<`Admin(string)>] 'netidx_admin_answer
