let local = |#cfg_path: [string, null] = null, trigger: Any| -> Result<Target, AdminError> 'netidx_admin_local;
let drift = |t: Target| -> Result<Array<ServerDrift>, AdminError> 'netidx_admin_drift;
let list_admins = |t: Target| -> Result<Array<AdminInfo>, AdminError> 'netidx_admin_list_admins;
let parse_fingerprint = |code: string| -> Result<Fingerprint, `Admin(string)> 'netidx_admin_parse_fingerprint;
let identicon = |fp: Fingerprint| -> Result<{cells: Array<Array<bool>>, color: {r: u8, g: u8, b: u8}}, `Admin(string)> 'netidx_admin_identicon;
let connect = |#admin: [string, null] = null, #password: [string, null] = null, #ca_dir: [string, null] = null, server: string| -> Ceremony<Target> 'netidx_admin_connect;
let events = |c: Ceremony<'r>| -> Event<'r> 'netidx_admin_events;
let answer = |#id: u64, c: Ceremony<'r>, a: Answer| -> [null, Error<`Admin(string)>] 'netidx_admin_answer
