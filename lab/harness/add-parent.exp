#!/usr/bin/expect -f
# Child (.15) requests delegation of /eu from the parent conf server (.11:4565).
# Confirm the parent CA glyph (y), then poll until the parent admin approves.
set timeout 150
log_user 1
spawn /usr/local/bin/netidx conf resolver add-parent --server 192.168.50.11:4565 --path /eu
expect {
  -re {(denied|Denied|did not match|Error:)[^\n]*} { puts "\n<<<FAILED: $expect_out(0,string)>>>"; exp_continue }
  -re {does this match[^\n]*: ?$}  { send -- "y\r"; exp_continue }
  -re {match[^\n]*glyph[^\n]*: ?$} { send -- "y\r"; exp_continue }
  timeout { puts "\n<<<TIMEOUT (request may still be polling)>>>" }
  eof     { puts "\n<<<EXITED>>>" }
}
