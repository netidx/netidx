#!/usr/bin/expect -f
# Superuser eric mints a scoped eu-ops admin REMOTELY over the conf plane.
# Grant ⊆ eric's authority (no-escalation enforced by the CA).
set timeout 120
log_user 1
set ADMIN_PW "testpw12345"
set NEW_PW "euops12345"
spawn netidx conf ca admin add-role --server 192.168.50.11:4565 --ca-dir /root/.config/netidx/ca \
  --name eu-ops --allow-san *.eu.netidx.test --max-validity-days 365 \
  --id-map-group users --may-enroll-servers true --service-scope /eu --perms-scope /eu
expect {
  -re {(is not one of|must not be empty|did not match|please try again|Error:|authentication failed|denied|escalat|exceeds|not.*subset)[^\n]*} {
      puts "\n<<<GUARD: $expect_out(0,string)>>>"; exit 3 }
  -re {new role admin[^\n]*: ?$}        { send -- "$NEW_PW\r"; exp_continue }
  -re {again[^\n]*: ?$}                 { send -- "$NEW_PW\r"; exp_continue }
  -re {your admin name[^\n]*: ?$}       { send -- "eric\r"; exp_continue }
  -re {admin name[^\n]*: ?$}            { send -- "eric\r"; exp_continue }
  -re {does this[^\n]*match[^\n]*: ?$}  { send -- "y\r"; exp_continue }
  -re {CA password for admin[^\n]*: ?$} { send -- "$ADMIN_PW\r"; exp_continue }
  -re {password[^\n]*: ?$}              { send -- "$ADMIN_PW\r"; exp_continue }
  -re {[^\n]*\[[^\]\n]*\]: ?$}          { send -- "\r"; exp_continue }
  -re {[^\n]*: ?$} { puts "\n<<<GUARD unrecognized: $expect_out(0,string)>>>"; exit 4 }
  timeout { puts "\n<<<TIMEOUT>>>"; exit 0 }
  eof     { puts "\n<<<DONE>>>" }
}
catch wait result
exit [lindex $result 3]
