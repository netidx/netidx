#!/usr/bin/expect -f
# Enrollee as normal user `eric`. KEY: expect matches the LEFTMOST
# pattern, so the default-taker is line-anchored ([^\n]* from line
# start) to tie with the generic guard and win by being listed first.
# Named confirms precede it so "does this match?" gets y, not the
# bracket-default N.
set timeout 320
log_user 1
spawn /usr/local/bin/netidx conf install publisher
expect {
  -re {(is not one of|must not be empty|did not match|please try again|denied this request|expired before|could not be reached|was not confirmed|no conf server could)[^\n]*} {
      puts "\n<<<GUARD reject: $expect_out(0,string)>>>"; exit 3 }
  -re {does this match[^\n]*: ?$}                     { send -- "y\r"; exp_continue }
  -re {CA admin at this machine[^\n]*: ?$}            { send -- "n\r"; exp_continue }
  -re {join it\?[^\n]*: ?$}                           { send -- "y\r"; exp_continue }
  -re {OS service now[^\n]*: ?$}                      { send -- "y\r"; exp_continue }
  -re {\[sudo\] password for [^\n]*: ?$}              { send -- "test123\r"; exp_continue }
  -re {[^\n]*\[[^\]\n]*\]: ?$}                        { send -- "\r"; exp_continue }
  -re {[^\n]*: ?$} { puts "\n<<<GUARD unrecognized required prompt: $expect_out(0,string)>>>"; exit 4 }
  timeout { puts "\n<<<TIMEOUT>>>"; exit 2 }
  eof     { puts "\n<<<DONE>>>" }
}
